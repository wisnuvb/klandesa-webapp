# Salin ke .env.production untuk build/deploy production (yarn deploy:prod).
# File ini TIDAK dipakai Next.js secara otomatis — hanya template.
#
# Dev lokal: pakai .env / .env.local (port 2042, DB dev).
# Build prod lokal: scripts/build-next-prod.sh hanya memuat .env.production.
# Server runtime: .env di server (isi sama dengan production).

# --- URL & auth (wajib untuk build) ---
NEXT_PUBLIC_SITE_URL="https://klandesa.com"
NEXTAUTH_URL="https://klandesa.com"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Database (server — dipakai prisma migrate di server, bukan saat next build) ---
# connection_limit=5 × 8 PM2 worker ≈ 40 koneksi webapp.
# Saat API mobile live (project terpisah), turunkan per-app atau naikkan max_connections MySQL.
DATABASE_URL="mysql://user:password@host:3306/klandesa?connection_limit=5"

# --- OAuth (opsional, aktifkan jika dipakai) ---
# GOOGLE_ID=
# GOOGLE_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=

# --- DigitalOcean Spaces / upload ---
# SPACES_REGION=sgp1
# SPACES_BUCKET=
# SPACES_ENDPOINT=
# SPACES_ACCESS_KEY_ID=
# SPACES_SECRET_ACCESS_KEY=
# SPACES_CDN_BASE_URL=

# --- Turnstile (form publik production) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_SKIP=true

# --- Google Apps Script (form landing / mitra) ---
GOOGLE_FORM_PARTNER_APPS_SCRIPT_URL=
GOOGLE_FORM_PARTNER_APPS_SCRIPT_SECRET=
GOOGLE_APPS_SCRIPT_CONTACT_URL=
GOOGLE_APPS_SCRIPT_CONTACT_SECRET=

# --- AI (opsional) ---
# OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL=https://klandesa.com
# OPENROUTER_SITE_NAME=Klandesa

# --- Berita regional (Google News RSS cache per kabupaten) ---
# REGIONAL_NEWS_ENABLED=true
# REGIONAL_NEWS_TTL_HOURS=12
# CRON_SECRET=generate-with-openssl-rand-base64-32

# --- Domain website desa ---
# WEBSITE_ROOT_DOMAIN=klandesa.id
# WEBSITE_CNAME_TARGET=
# WEBSITE_A_TARGET=

# --- Lainnya ---
# MAIN_DOMAIN_ALLOWLIST=klandesa.com,www.klandesa.com
# FINANCE_API_KEY=
# UNSPLASH_ACCESS_KEY=
