# Database (wajib untuk Prisma: pnpm db:push / db:studio / db:seed)
# Prisma CLI hanya membaca file .env di root (bukan .env.local / .env.production).
DATABASE_URL="mysql://user:password@localhost:3306/klandesa_db?connection_limit=5"

# Halaman /karir — pendaftaran mitra via Google Apps Script (Web App).
# Deploy: scripts/partner-mitra-webhook.gs
GOOGLE_FORM_PARTNER_APPS_SCRIPT_URL=
GOOGLE_FORM_PARTNER_APPS_SCRIPT_SECRET=

# ContactModal (landing) → setelah simpan DB, forward ke Spreadsheet + email (opsional).
# Deploy: scripts/landing-contact-webhook.gs (deployment URL terpisah dari mitra).
GOOGLE_APPS_SCRIPT_CONTACT_URL=
GOOGLE_APPS_SCRIPT_CONTACT_SECRET=

# Cloudflare Turnstile (form publik: daftar, login, kontak, mitra)
# Hanya aktif saat NODE_ENV=production (dev/staging lokal otomatis dilewati).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Paksa nonaktif di production (opsional):
# TURNSTILE_SKIP=true

# --- Production build / deploy ---
# Untuk pnpm deploy:prod, salin .env.production.example → .env.production
# (build hanya memuat .env.production, bukan .env / .env.local).

# Email transaksional (Brevo) untuk pengingat perpanjangan
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Klandesa
# Penerima pemberitahuan pesanan Website Desa Kustom yang lunas (opsional; default wisnuvb@gmail.com; pisahkan koma untuk beberapa alamat)
# WEBSITE_ORDER_NOTIFY_EMAIL=

# Pembayaran LinkQu (https://linkqu.id). Sandbox: https://gateway-dev.linkqu.id, produksi: https://api.linkqu.id
# LINKQU_BASE_URL lama masih dibaca sebagai alias LINKQU_URL.
# url_callback TIDAK diatur di env: dibentuk dinamis dari host permintaan (X-Forwarded-Host/Host + X-Forwarded-Proto),
# jadi reverse proxy wajib meneruskan header tersebut. Rute webhook: /api/billing/linkqu/callback
LINKQU_URL=
LINKQU_CLIENT_ID=
LINKQU_CLIENT_SECRET=
LINKQU_USERNAME=
LINKQU_PIN=
LINKQU_SIGNATURE_KEY=

# OPSIONAL. Status kanal pembayaran kini diatur dari panel Admin > Kanal Pembayaran (tanpa deploy/restart).
# Variabel ini hanya untuk MENGUNCI kanal dari sisi server (tidak bisa dibuka dari panel). Pisahkan dengan koma.
# Kode: QRIS, VA_BRI|VA_MANDIRI|VA_BNI|VA_DANAMON|VA_PERMATA|VA_BCA|VA_CIMB, PAYDANA|PAYLINKAJA|PAYSHOPEEPAY.
# Untuk mengetahui kanal akun Anda: tombol "Uji semua kanal" di panel admin, atau
#   node --env-file=.env --import tsx scripts/linkqu-probe-channels.ts  (menolak jalan di produksi tanpa --allow-production)
# Kanal yang ditolak LinkQu saat checkout juga disembunyikan otomatis ~10 menit.
# LINKQU_DISABLED_CHANNELS=""
