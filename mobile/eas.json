{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": { "EXPO_ANDROID_BUILD_ARCHS": "arm64-v8a" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://klandesa.com", "KLANDESA_ANDROID_PACKAGE": "com.klandesa.klan_desa" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": { "production": { "android": { "track": "internal" } } }
}
