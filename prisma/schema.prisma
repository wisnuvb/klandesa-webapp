model RpjmdesPlan {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  title        String @db.VarChar(255)
  periodStart  Int
  periodEnd    Int
  vision       String? @db.Text
  mission      String? @db.Text
  status       String  @default("draft") @db.VarChar(50) // draft, active, completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities RkpdesActivity[]
  proposals  MusdesProposal[]
  rkpdesDocuments RkpdesDocument[]

  /// Tahapan penyusunan RPJM Desa (Permendagri 114/2014 Pasal 7-28; UU 3/2024 Pasal 79; PP 16/2026 Pasal 143-148).
  /// Semua kolom di bawah nullable/berdefault: RPJM Desa lama tetap utuh dan tidak terkunci.
  /// Pelantikan Kepala Desa (dasar tenggat penetapan 3 bulan, PP 16/2026 Pasal 145 ayat 4).
  headInauguratedOn DateTime? @db.Date
  /// Arah kebijakan pembangunan Desa (Pasal 6 ayat 1 dan Pasal 21 ayat 1 huruf b).
  policyDirection   String?   @db.Text
  teamFormedAt      DateTime? @db.Date
  teamDecreeRef     String?   @db.VarChar(150)
  /// Pengkajian keadaan Desa: tanggal dan nomor berita acara, ringkasan hasil (Pasal 12-19).
  reviewDoneAt      DateTime? @db.Date
  reviewMinutesRef  String?   @db.VarChar(150)
  reviewSummary     String?   @db.Text
  musdesMeetingId   Int?
  musdesMeeting     VillageMeeting? @relation("RpjmMusdes", fields: [musdesMeetingId], references: [id], onDelete: SetNull)
  draftReadyAt      DateTime? @db.Date
  draftMinutesRef   String?   @db.VarChar(150)
  draftApprovedAt   DateTime? @db.Date
  draftApprovedById Int?
  /// Musyawarah yang membahas dan menyepakati rancangan (Pasal 25-26; PP 16/2026 Pasal 144 ayat 3).
  draftMeetingId    Int?
  draftMeeting      VillageMeeting? @relation("RpjmDraftMeeting", fields: [draftMeetingId], references: [id], onDelete: SetNull)
  /// Peraturan Desa tentang RPJM Desa; terisi = isi terkunci.
  legalDocumentId   Int?
  legalDocument     LegalDocument? @relation(fields: [legalDocumentId], references: [id], onDelete: SetNull)
  /// Perdes sudah ada sebelum desa memakai aplikasi: gerbang tahapan dilewati dan itu dicatat.
  enactedBeforeApp  Boolean   @default(false)
  /// Rencana Jangka Menengah SDGs Desa pada aplikasi SID (Permendesa PDT 13/2025 Pasal 126 ayat 4).
  sdgsPlanRecordedAt DateTime? @db.Date
  sdgsPlanNote       String?   @db.VarChar(300)
  reopenCount       Int       @default(0)

  rpjmTeam     RpjmTeamMember[]
  rpjmPrograms RpjmProgram[]
  rpjmEvents   RpjmEvent[]

  @@unique([legalDocumentId])
  @@index([villageId, status])
  @@map("rpjmdes_plans")
}

model RkpdesActivity {
  id     Int         @id @default(autoincrement())
  planId Int
  plan   RpjmdesPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  title            String   @db.VarChar(255)
  description      String?  @db.Text
  year             Int
  location         String?  @db.VarChar(255)
  estimatedBudget  Decimal? @db.Decimal(15, 2)
  sdgGoalIds       Json     @default("[]")
  priorityScore    Float?
  status           String   @default("planned") @db.VarChar(50) // planned, ongoing, completed, cancelled
  source           String   @default("internal") @db.VarChar(50) // internal, musdes_proposal

  /// Siklus RKPDes (Permendagri 114/2014 Pasal 40-42): semua kolom di bawah nullable agar data lama tetap berlaku.
  documentId        Int?
  document          RkpdesDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  activityCode      String?  @db.VarChar(12)
  fundSource        String?  @db.VarChar(10)
  /// SWAKELOLA | KERJASAMA_DESA | PIHAK_KETIGA
  method            String?  @db.VarChar(14)
  outputName        String?  @db.VarChar(200)
  outputVolume      Decimal? @db.Decimal(14, 2)
  outputUnit        String?  @db.VarChar(30)
  executorChair     String?  @db.VarChar(150)
  executorSecretary String?  @db.VarChar(150)
  executorTreasurer String?  @db.VarChar(150)
  executorMembers   String?  @db.VarChar(500)
