  /// Program RPJM Desa asal kegiatan ini (opsional, tidak dipaksakan).
  rpjmProgramId     Int?
  rpjmProgram       RpjmProgram? @relation(fields: [rpjmProgramId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mergedFrom MusdesProposal?

  @@index([documentId])
  @@index([rpjmProgramId])
  @@index([planId, year])
  @@index([planId, status])
