/// Kejadian (primitif bersama P4 Bencana dan P5 Keamanan). `domain` memisahkan dua dunia: BENCANA | KEAMANAN.
/// Jenis kejadian ada di katalog per domain (lib/incident/catalog.ts). Dampak berupa angka kasar (bukan daftar nama korban).
model IncidentEvent {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// BENCANA | KEAMANAN
  domain      String   @db.VarChar(12)
  kind        String   @db.VarChar(40)
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(2000)
  occurredAt  DateTime
  /// LOW | MEDIUM | HIGH | CRITICAL
  severity    String   @default("MEDIUM") @db.VarChar(10)
  /// OPEN | RESPONDING | RESOLVED | CLOSED | CANCELLED (gerbang di lib/incident/calc.ts)
  status      String   @default("OPEN") @db.VarChar(12)

  locationText String? @db.VarChar(255)
  rt           String? @db.VarChar(10)
  rw           String? @db.VarChar(10)
  hamlet       String? @db.VarChar(100)
  lat          Float?
  lng          Float?

  deathCount         Int?
  missingCount       Int?
  injuredCount       Int?
  displacedCount     Int?
  affectedHouseholds Int?
  damagedHouses      Int?
  lossCents          BigInt?
  impactNote         String? @db.VarChar(1000)

  /// Pelaporan ke supra-desa (BPBD/kecamatan/Polsek/Koramil dst.)
  supraReportedAt DateTime?
  supraReportedTo String?   @db.VarChar(150)
  supraReference  String?   @db.VarChar(150)

  resolutionNote String?   @db.VarChar(1000)
  resolvedAt     DateTime?
  closedAt       DateTime?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses  IncidentResponse[]
  logistics  IncidentLogistic[]
  statusLogs IncidentStatusLog[]

  @@index([villageId, domain, status, occurredAt])
  @@index([villageId, domain, occurredAt])
  @@map("incident_events")
}

/// Log tindakan/respons satu kejadian (tambah-saja; koreksi = hapus oleh yang berwenang selama kejadian belum ditutup).
model IncidentResponse {
  id        Int           @id @default(autoincrement())
  villageId Int
  eventId   Int
  event     IncidentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  loggedAt    DateTime
  kind        String   @db.VarChar(30)
  description String   @db.VarChar(1000)
  /// Pelaksana/tim (teks bebas)
  actor       String?  @db.VarChar(150)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([eventId, loggedAt])
  @@index([villageId])
  @@map("incident_responses")
}

/// Distribusi bantuan/logistik. Penerima = KK (householdId, tanpa FK; nama kepala KK disalin sebagai bukti LPJ) atau
/// penerima non-KK (posko, fasilitas). Tidak memuat NIK. Bukan buku kas: pengeluaran uang tetap lewat SPP/Buku Kas.
model IncidentLogistic {
  id        Int           @id @default(autoincrement())
  villageId Int
  eventId   Int
  event     IncidentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  householdId   Int?
  recipientName String  @db.VarChar(150)
  rt            String? @db.VarChar(10)
  rw            String? @db.VarChar(10)

  item     String  @db.VarChar(100)
  /// item huruf kecil tanpa spasi berlebih; bagian dari kunci unik anti-ganda
  itemKey  String  @db.VarChar(100)
  quantity Int
  unit     String  @db.VarChar(30)
  valueCents BigInt?
  /// Kode sumber dana dari katalog (lib/incident/catalog.ts)
  fundingSource String  @db.VarChar(24)
  distributedOn DateTime @db.Date
  reference     String?  @db.VarChar(150)
  note          String?  @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())

  @@unique([eventId, householdId, itemKey, distributedOn], map: "incident_logi_dup_uq")
  @@index([eventId, distributedOn])
  @@index([villageId, householdId])
  @@map("incident_logistics")
}

/// Riwayat perpindahan status kejadian (siapa, kapan, alasan).
model IncidentStatusLog {
  id        Int           @id @default(autoincrement())
  villageId Int
  eventId   Int
  event     IncidentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  fromStatus String?  @db.VarChar(12)
  toStatus   String   @db.VarChar(12)
  note       String?  @db.VarChar(500)
  byUserId   Int?
  at         DateTime @default(now())

  @@index([eventId, at])
  @@map("incident_status_logs")
}

