generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE SYSTEM - Multi-tenant & Authentication
// ============================================

model Village {
  id       Int    @id @default(autoincrement())
  code     String @unique @db.VarChar(20) // Kode desa unik
  name     String @db.VarChar(255)
  district String @db.VarChar(255) // Kecamatan
  regency  String @db.VarChar(255) // Kabupaten
  province String @db.VarChar(255)

  // Contact & Address
  address    String  @db.Text
  postalCode String? @db.VarChar(10)
  phone      String? @db.VarChar(20)
  email      String? @db.VarChar(255)
  website    String? @db.VarChar(255)

  // Logo & Branding
  logoUrl String? @db.Text

  // Settings
  settings Json? // Theme, preferences, etc

  // Subscription & Limits
  subscriptionPlan   String    @default("starter") @db.VarChar(50) // starter, profesional, enterprise
  subscriptionStatus String    @default("active") @db.VarChar(50) // active, inactive, trial, cancelled
  subscriptionDate   DateTime? // Tanggal mulai berlangganan
  subscriptionExpiry DateTime?
  storageLimit       Int       @default(5) // in GB; minimum paket starter = 5 (lihat BILLING_CATALOG.arsip)
  storageUsed        Float     @default(0) // in GB

  /// Add-on absensi: check-in dengan validasi radius GPS (pembayaran terpisah).
  absensiGpsAddonActive      Boolean @default(false)
  /// Akhir masa berlaku add-on GPS (langganan bulanan). NULL = tanpa batas (desa lama / diaktifkan admin).
  absensiGpsAddonExpiry      DateTime?
  /// Titik acuan geofencing (kantor desa). Wajib diisi admin agar GPS check-in berfungsi.
  absensiOfficeLat           Float?
  absensiOfficeLng           Float?
  /// Radius izin absen GPS dalam meter (default 100 m).
  absensiCheckInRadiusMeters Int     @default(100)

  /// Onboarding wizard setelah registrasi trial.
  onboardingCompletedAt DateTime?
  onboardingSteps       Json?

  acquiredByPartnerId Int?
  acquiredByPartner   Partner?  @relation("PartnerAcquiredVillages", fields: [acquiredByPartnerId], references: [id], onDelete: SetNull)
  acquiredAt          DateTime?
  acquisitionSource   String?   @db.VarChar(50)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                  User[]
  residents              Resident[]
  officials              Official[]
  workShifts             WorkShift[]
  attendances            Attendance[]
  positions              Position[]
  requests               Request[]
  mailTemplates          MailTemplate[]
  mailServices           MailService[]
  mailNumberCounters     MailNumberCounter[]
  mailRequests           MailRequest[]
  kioskDevices           KioskDevice[]
  citizenAccounts        CitizenAccount[]
  activationCodes        ActivationCode[]
  transactions           Transaction[]
  budgets                Budget[]
  potentials             Potential[]
  villagePotentials      VillagePotential[]
  digitalArchives        DigitalArchive[]
  digitalArchiveFolders  DigitalArchiveFolder[]
  statistics             Statistic[]
  announcements          Announcement[]
  forumThreads           ForumThread[]
  forumReplies           ForumReply[]
  citizenReports         CitizenReport[]
  citizenReportResponses CitizenReportResponse[]
  adminNotifications     AdminNotification[]
  billingInvoices        BillingInvoice[]
  partnerCommissionEntries PartnerCommissionEntry[]
  websiteDomains         WebsiteDomain[]
  cooperative            Cooperative?
  bumdes                 Bumdes?
  socialBenefitPrograms  SocialBenefitProgram[]
  dasawisma              Dasawisma[]
  posyanduSessions       PosyanduSession[]
  rpjmdesPlans           RpjmdesPlan[]
  musdesProposals        MusdesProposal[]
  farmPlots              FarmPlot[]
  rtRwActivities         RtRwActivity[]
  communityProposals     CommunityProposal[]
  integrationSyncLogs    IntegrationSyncLog[]
  villageAssets          VillageAsset[]
  infrastructureProjects InfrastructureProject[]
  wasteBanks             WasteBank[]
  environmentalIncidents EnvironmentalIncident[]
  disasterPoints         DisasterPoint[]
  aiAssistantThreads     AiAssistantThread[]
  moduleSubscriptions    VillageModuleSubscription[]
  mediaUsage             VillageMediaUsage?
  websiteDailyStats        WebsiteDailyStat[]

  @@index([code])
  @@index([isActive])
  @@index([regency])
  @@index([regency, district])
  @@index([acquiredByPartnerId])
  households        Household[]
  wilayahUnits      WilayahUnit[]
  residentMutations ResidentMutation[]
  residentArchives  ResidentArchive[]
  apiKeys           ApiKey[]
  apiAccessLogs     ApiAccessLog[]
  webhookEndpoints  WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  changeProposals   ChangeProposal[]
  appInstalls       AppInstall[]
  inventoryItems    InventoryItem[]
  legalDocuments    LegalDocument[]
  mailRegister      MailRegister[]
  institutions      VillageInstitution[]
  institutionMembers InstitutionMember[]
  dtsenProposals     DtsenProposal[]
  polls              Poll[]
  apbdesYears        ApbdesYear[]
  apbdesDocuments    ApbdesDocument[]
  apbdesLines        ApbdesLine[]
  apbdesEntries      ApbdesEntry[]
  apbdesMonthCloses  ApbdesMonthClose[]
  apbdesActivityPlans ApbdesActivityPlan[]
  apbdesPlanVersions  ApbdesActivityPlanVersion[]
  apbdesCashPlans    ApbdesCashPlan[]
  apbdesCostItems    ApbdesCostItem[]
  apbdesPayRequests  ApbdesPayRequest[]
  apbdesPanjars      ApbdesPanjar[]
  apbdesExternalPrograms ApbdesExternalProgram[]
  villageReports     VillageReport[]
  immunizations      ImmunizationRecord[]
  pregnancies        Pregnancy[]
  pregnancyVisits    PregnancyVisit[]
  elderlyChecks      ElderlyCheck[]
  villageMeetings    VillageMeeting[]
  rkpdesDocuments    RkpdesDocument[]
  ddYearSettings     DdYearSetting[]
  ddFocusTags        DdFocusTag[]
  ddRuleExceptions   DdRuleException[]
  ddPublications     DdPublication[]
  bltPrograms        BltProgram[]
  pktdActivities     PktdActivity[]
  kdmpDisbursements  KdmpDisbursement[]
  rpjmTeamMembers    RpjmTeamMember[]
  rpjmPrograms       RpjmProgram[]
  rpjmEvents         RpjmEvent[]
  // >>> back-relations:rpjm (sisipkan tepat di atas baris ini)
  // >>> back-relations:bumdes (sisipkan tepat di atas baris ini)
  landParcels        LandParcel[]
  landAgreements     LandAgreement[]
  landCharges        LandCharge[]
  landAgreementDocs  LandAgreementDoc[]
  ukmOrderRequests   UkmOrderRequest[]
  // >>> back-relations:aset (sisipkan tepat di atas baris ini)
  incidentEvents     IncidentEvent[]
  drmHazards         DrmHazard[]
  drmResources       DrmResource[]
  drmVolunteers      DrmVolunteer[]
  drmPlans           DrmPlan[]
  drmAlerts          DrmAlert[]
  drmReadinessItems  DrmReadinessItem[]
  drmAssessments     DrmAssessment[]
  // >>> back-relations:bencana (sisipkan tepat di atas baris ini)
  complianceRecords  ComplianceReportRecord[]
  // >>> back-relations:kalender (sisipkan tepat di atas baris ini)
  procurementSetting  ProcurementSetting?
  procurementPackages ProcurementPackage[]
  villageAgreements   VillageAgreement[]
  idmScores           IdmScore[]
  idmIndicators       IdmIndicator[]
  // >>> back-relations:pengadaan (sisipkan tepat di atas baris ini)
  securityMembers     SecurityMember[]
  securityEquipment   SecurityEquipment[]
  securityRondaGroups SecurityRondaGroup[]
  securityMediations  SecurityMediation[]
  securityRiskAreas   SecurityRiskArea[]
  securityContacts    SecurityContact[]
  // >>> back-relations:keamanan (sisipkan tepat di atas baris ini)
  kdmpFacilities     KdmpFacility[]
  kdmpInstallments   KdmpInstallment[]
  publishedTemplates AppTemplate[]
  customTables      CustomTable[]
  customRecords     CustomRecord[]

  @@map("villages")
}

/// Pemakaian penyimpanan foto aplikasi seluler per desa. Ditambah saat presign, dikurangi saat foto dihapus, dan dibaca
/// tanpa menyentuh bucket. Baris dibuat saat unggahan pertama (diisi dari isi bucket sekali), lalu dikoreksi lewat
/// scripts/reconcile-mobile-media.ts bila perlu.
model VillageMediaUsage {
  villageId   Int      @id
  village     Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  mobileBytes BigInt   @default(0)
  updatedAt   DateTime @updatedAt

  @@map("village_media_usage")
}

/// Akun dashboard agregat kabupaten/kecamatan (terpisah dari User per-desa).
model RegionalUser {
  id       Int    @id @default(autoincrement())
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  name     String @db.VarChar(255)

  /// regional_provinsi | regional_kabupaten | regional_kecamatan
  role String @db.VarChar(50)

  /// Harus cocok dengan `Village.province` / `regency` / `district` (teks, dinormalisasi)
  scopeProvince String? @db.VarChar(255)
  scopeRegency  String  @db.VarChar(255)
  scopeDistrict String? @db.VarChar(255)

  /// Kode BPS/Kemendag (opsional, prioritas matching wilayah)
  scopeKodeProvinsi String? @db.VarChar(10)
  scopeKodeKabKota  String? @db.VarChar(10)

  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  accessLogs RegionalAccessLog[]

  @@index([email])
  @@index([scopeRegency, scopeDistrict])
  @@map("regional_users")
}

model RegionalAccessLog {
  id             Int          @id @default(autoincrement())
  regionalUserId Int
  regionalUser   RegionalUser @relation(fields: [regionalUserId], references: [id], onDelete: Cascade)

  action    String  @db.VarChar(80)
  path      String  @db.VarChar(500)
  ip        String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([regionalUserId, createdAt(sort: Desc)])
  @@map("regional_access_logs")
}

model PlatformUser {
  id       Int    @id @default(autoincrement())
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  name     String @db.VarChar(255)

  role String @default("platform_admin") @db.VarChar(50)

  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  blogPosts           BlogPost[]
  themePacksReviewed          WebsiteThemePack[]    @relation("ThemePackReviewedBy")
  partnerDisbursementsCreated PartnerDisbursement[] @relation("DisbursementCreatedBy")

  @@index([email])
  @@index([role])
  @@map("platform_users")
}

model ReferralCode {
  id Int @id @default(autoincrement())

  code        String  @unique @db.VarChar(40)
  label       String  @db.VarChar(120)
  ownerName   String? @db.VarChar(120)
  ownerPhone  String? @db.VarChar(40)
  ownerEmail  String? @db.VarChar(255)
  commission  String? @db.VarChar(80)
  status      String  @default("active") @db.VarChar(30)
  landingPath String  @default("/tim") @db.VarChar(120)
  notes       String? @db.Text

  /// Mitra operasional (komisi/desab) satu-satu dengan satu kode referral aktif di UI.
  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  events ReferralEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId])
  @@index([status])
  @@map("referral_codes")
}

model ReferralEvent {
  id BigInt @id @default(autoincrement())

  referralCodeId Int?
  referralCode   ReferralCode? @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  codeSnapshot   String?       @db.VarChar(40)

  action     String  @db.VarChar(50)
  sourcePath String? @db.VarChar(500)

  name        String? @db.VarChar(255)
  email       String? @db.VarChar(255)
  phone       String? @db.VarChar(40)
  villageName String? @db.VarChar(255)
  subject     String? @db.VarChar(120)

  metadata Json?

  ipAddress String? @db.VarChar(80)
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([referralCodeId, createdAt(sort: Desc)])
  @@index([codeSnapshot, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("referral_events")
}

model User {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255) // Hashed

  name   String  @db.VarChar(255)
  phone  String? @db.VarChar(20)
  avatar String? @db.Text

  role      String @db.VarChar(50) // admin, staff, village_head, secretary
  aiCredits Int    @default(1000)

  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  createdMailServices    MailService[]            @relation("CreatedBy")
  createdRequests        Request[]                @relation("CreatedBy")
  createdBudgets         Budget[]                 @relation("CreatedBy")
  createdAnnouncements   Announcement[]           @relation("CreatedBy")
  mailHistory            MailHistory[]
  forumThreads           ForumThread[]            @relation("ForumThreadCreatedBy")
  forumReplies           ForumReply[]             @relation("ForumReplyCreatedBy")
  citizenReportsDone     CitizenReport[]          @relation("CitizenReportDoneBy")
  citizenReportResponses CitizenReportResponse[]
  notificationReads      NotificationRead[]
  respondedContacts      Contact[]                @relation("ContactRespondedBy")
  cooperativeMemberLinks CooperativeMember[]      @relation("CoopMemberUser")
  coopLedgerCreates      CooperativeLedgerEntry[] @relation("CoopLedgerCreatedBy")
  bumdesTransactionCreates BumdesTransaction[]  @relation("BumdesTransactionCreatedBy")
  aiAssistantThreads       AiAssistantThread[]

  @@index([villageId, role])
  @@index([email])
  @@map("users")
}

// ============================================
// NOTIFIKASI ADMIN (header app)
// ============================================

model AdminNotification {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// mail_request_pending | finance_transaction | resident_update
  type      String  @db.VarChar(50)
  title     String  @db.VarChar(255)
  body      String? @db.Text
  href      String? @db.VarChar(500)
  /// Kunci stabil untuk upsync (mis. mail-req-1, tx-2, resident-3)
  sourceKey String  @db.VarChar(120)

  createdAt DateTime @default(now())

  reads NotificationRead[]

  @@unique([villageId, sourceKey])
  @@index([villageId, createdAt(sort: Desc)])
  @@map("admin_notifications")
}

model NotificationRead {
  id             Int               @id @default(autoincrement())
  notificationId Int
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

// ============================================
// DATA WARGA - Residents Management
// ============================================

model Resident {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  // Identitas
  nik  String  @db.VarChar(16) // NIK must be unique per desa
  kk   String? @db.VarChar(16) // Nomor Kartu Keluarga
  name String  @db.VarChar(255)

  // Personal Info
  birthplace    String   @db.VarChar(255)
  birthDate     DateTime
  gender        String   @db.VarChar(20) // Laki-laki, Perempuan
  bloodType     String?  @db.VarChar(5) // A, B, AB, O, A+, B+, AB+, O+, A-, B-, AB-, O-
  religion      String   @db.VarChar(50) // Islam, Kristen, Katolik, Hindu, Buddha, Konghucu, dll
  maritalStatus String   @db.VarChar(50) // Belum Menikah, Menikah, Cerai Hidup, Cerai Mati
  familyRole    String   @db.VarChar(50) // Kepala Keluarga, Istri, Anak, dll

  // Address
  address String  @db.Text
  rt      String? @db.VarChar(10)
  rw      String? @db.VarChar(10)
  hamlet  String? @db.VarChar(100) // Dusun

  // Work & Education
  occupation String? @db.VarChar(255)
  education  String? @db.VarChar(100)

  // Additional
  nationality String  @default("Indonesia") @db.VarChar(50)
  phone       String? @db.VarChar(20)
  email       String? @db.VarChar(255)

  // Family Links
  fatherNik  String? @db.VarChar(16)
  fatherName String? @db.VarChar(255)
  motherNik  String? @db.VarChar(16)
  motherName String? @db.VarChar(255)

  // Health & Social
  isIlliterate    Boolean?  @default(false)
  isDisability    Boolean?  @default(false)
  disabilityId    Int?
  otherDisability String?   @db.VarChar(255)
  isPregnant      Boolean?  @default(false)
  datePregnant    DateTime?
  isBreastfeeding Boolean?  @default(false)
  isStunting      Boolean?  @default(false)
  isBpjsKis       Boolean?  @default(false)
  contraception   String?   @db.VarChar(100)
  height          Int?
  weight          Int?
  income          Int?

  // Media
  cover      String? @db.Text
  coverThumb String? @db.Text
  photo      String? @db.Text
  photoThumb String? @db.Text

  // Misc
  countryCode    String? @db.VarChar(10)
  tempIdNumber   String? @db.VarChar(20)
  tempRt         String? @db.VarChar(10)
  houseOwnership String? @db.VarChar(100)
  desil          String? @db.VarChar(50)

  // Status
  isAlive   Boolean   @default(true)
  moveDate  DateTime? // Place of residence if already moved
  deathDate DateTime? // Date of death

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cooperativeMembers CooperativeMember[]
  posyanduVisits     PosyanduVisit[]
  citizenAccount     CitizenAccount?

  /// Rumah tangga (KK) hasil sinkronisasi dari `kk`; `kk` tetap sumber kebenaran sampai Fase 1 selesai.
  householdId Int?
  household   Household? @relation("HouseholdMembers", fields: [householdId], references: [id], onDelete: SetNull)
  /// Unit terdalam pada pohon RW → RT (RT, atau RW bila RT kosong), hasil sinkronisasi dari `rw/rt`.
  wilayahUnitId Int?
  wilayahUnit   WilayahUnit? @relation("AreaResidents", fields: [wilayahUnitId], references: [id], onDelete: SetNull)
  /// Unit dusun (dimensi terpisah: dusun dan RW saling silang), hasil sinkronisasi dari `hamlet`.
  dusunUnitId Int?
  dusunUnit   WilayahUnit? @relation("DusunResidents", fields: [dusunUnitId], references: [id], onDelete: SetNull)
  headOfHouseholds Household[] @relation("HouseholdHead")
  mutations        ResidentMutation[]
  customRecords    CustomRecord[]

  institutionMemberships InstitutionMember[]

  dtsenProposals         DtsenProposal[]

  pollParticipations     PollParticipation[]

  wasteBankAccounts      WasteBankAccount[]

  immunizations          ImmunizationRecord[]
  pregnancies            Pregnancy[]
  elderlyChecks          ElderlyCheck[]
  meetingAttendances     VillageMeetingAttendee[]
  rkpdesTeamMembers      RkpdesTeamMember[]
  bltBeneficiaries       BltBeneficiary[]
  pktdWorkers            PktdWorker[]
  /// Produk UKM yang ditautkan ke warga ini sebagai pemilik/penjual.
  ukmProducts            Potential[] @relation("ResidentUkmProducts")

  @@unique([villageId, nik])
  @@index([villageId, name])
  @@index([villageId, nik])
  @@index([villageId, kk])
  @@index([villageId, householdId])
  @@index([villageId, wilayahUnitId])
  @@index([villageId, dusunUnitId])
  @@map("residents")
}

// ============================================
// DATA PERANGKAT - Village Officials
// ============================================

model Position {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name  String @db.VarChar(255)
  level Int    @default(1) // Hierarchy of position

  // Compensation
  salary    Float?
  allowance Float?

  description String? @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  officials Official[]

  @@index([villageId, isActive])
  @@map("positions")
}

model Official {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  positionId Int
  position   Position @relation(fields: [positionId], references: [id])

  supervisorId Int?
  supervisor   Official?  @relation("OfficialHierarchy", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates Official[] @relation("OfficialHierarchy")

  // Personal Info
  nik        String   @db.VarChar(16)
  name       String   @db.VarChar(255)
  birthplace String   @db.VarChar(255)
  birthDate  DateTime
  gender     String   @db.VarChar(20)

  // Contact
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(255)
  address String  @db.Text

  // Work Info
  startDate DateTime
  endDate   DateTime?

  // Education & Certification
  education     String? @db.VarChar(100)
  certification String? @db.Text

  // Status
  status String @default("active") @db.VarChar(50) // active, inactive, retired

  // Documents
  skPengangkatan String? @db.Text // SK Pengangkatan file URL
  photoUrl       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]

  @@index([villageId, status])
  @@index([villageId, positionId])
  @@index([villageId, supervisorId])
  @@map("officials")
}

// ============================================
// PERMOHONAN WARGA - Citizen Requests
// ============================================

model Request {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  // Request Info
  requestNumber String @unique @db.VarChar(100)
  category      String @db.VarChar(100) // Pengaduan, Permohonan, Informasi
  title         String @db.VarChar(255)
  description   String @db.Text

  // Requester
  requesterNik   String  @db.VarChar(16)
  requesterName  String  @db.VarChar(255)
  requesterPhone String? @db.VarChar(20)
  requesterEmail String? @db.VarChar(255)

  // Status & Priority
  status   String @db.VarChar(50) // pending, in_progress, completed, rejected
  priority String @default("medium") @db.VarChar(50) // low, medium, high, urgent

  // Response
  response        String?   @db.Text
  responseDate    DateTime?
  respondedBy     Int?
  respondedByUser User?     @relation("CreatedBy", fields: [respondedBy], references: [id])

  // Attachments
  attachments Json? // Array of file URLs

  // Dates
  requestDate   DateTime  @default(now())
  completedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, status])
  @@index([villageId, category])
  @@index([requestNumber])
  @@map("requests")
}

// ============================================
// LAYANAN SURAT - Mail Service System
// ============================================

model ForumThread {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  title    String @db.VarChar(255)
  content  String @db.Text
  category String @db.VarChar(50) // UMUM, PEMBANGUNAN, KESEHATAN, PENDIDIKAN, KEAMANAN, EKONOMI
  status   String @default("OPEN") @db.VarChar(20) // OPEN, CLOSED

  isPinned Boolean @default(false)
  isLocked Boolean @default(false)

  likesCount Int @default(0)
  viewsCount Int @default(0)

  createdBy     Int?
  createdByUser User?  @relation("ForumThreadCreatedBy", fields: [createdBy], references: [id])
  createdByName String @db.VarChar(255)
  createdByRole String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies ForumReply[]

  @@index([villageId, createdAt(sort: Desc)])
  @@index([villageId, category])
  @@index([villageId, status])
  @@map("forum_threads")
}

model ForumReply {
  id       BigInt      @id @default(autoincrement())
  threadId BigInt
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  content String @db.Text

  likesCount Int @default(0)

  createdBy     Int?
  createdByUser User?  @relation("ForumReplyCreatedBy", fields: [createdBy], references: [id])
  createdByName String @db.VarChar(255)
  createdByRole String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, createdAt])
  @@index([villageId, createdAt(sort: Desc)])
  @@map("forum_replies")
}

model MailTemplate {
  id        Int      @id @default(autoincrement())
  villageId Int? // NULL = global template
  village   Village? @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name        String @db.VarChar(255)
  description String @db.Text
  category    String @db.VarChar(100) // Keterangan, Pengantar, Kependudukan, dll

  // Template Structure (JSON)
  templateStructure Json // { variables: [], required_fields: [], header_id, footer_id }
  contentTemplate   String @db.Text // Template content with {VARIABLES}

  // Configuration
  isActive           Boolean @default(true)
  isGlobal           Boolean @default(false) // Available for all villages
  /// Kunci stabil untuk seed katalog (unik di DB); null untuk template ad-hoc per-desa.
  catalogKey         String? @unique @db.VarChar(80)
  /// Jika tidak null, template desa ini menggantikan entri katalog dengan `catalogKey` yang sama di UI.
  inheritsCatalogKey String? @db.VarChar(80)

  // Stats
  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mailServices MailService[]

  @@unique([villageId, inheritsCatalogKey])
  @@index([villageId, isActive])
  @@index([category])
  @@index([isGlobal])
  @@map("mail_templates")
}

model MailService {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  templateId       Int
  template         MailTemplate @relation(fields: [templateId], references: [id])
  templateName     String       @db.VarChar(255) // Denormalized for quick access
  templateCategory String       @db.VarChar(100)

  // Letter Identification
  letterNumber  String   @db.VarChar(255)
  letterDate    DateTime
  /**
   * YYYY-MM-DD — skoping unik nomor per (desa, jenis surat, hari).
   */
  letterDateKey String   @db.VarChar(10)

  // Applicant (Normalized for fast query)
  applicantName String @db.VarChar(255)
  applicantNik  String @db.VarChar(16)

  // Signer
  signerRole String? @db.VarChar(50) // kepala_desa, sekretaris, camat
  signerName String? @db.VarChar(255)

  // Dynamic Form Data (JSONB)
  formData Json // All dynamic fields from template

  /**
   * Dokumen v2 yang dipakai surat ini, dibekukan saat surat dibuat — mengubah/menghapus
   * template tidak mengubah surat lama. Null untuk surat berformat lama.
   */
  templateSnapshot Json?

  // Generated Content (Immutable snapshot) — HTML hasil render server, bukan dari klien
  contentHtml String? @db.MediumText

  // Status
  status String @default("draft") @db.VarChar(50) // draft, completed, archived, cancelled

  // Audit Trail
  createdBy   Int?
  createdUser User? @relation("CreatedBy", fields: [createdBy], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  printedAt   DateTime?
  printCount  Int       @default(0)

  // Relations
  history     MailHistory[]
  attachments MailAttachment[]

  @@unique([villageId, templateId, letterDateKey, letterNumber], map: "mail_services_letter_scope_key")
  @@index([villageId, createdAt(sort: Desc)])
  @@index([villageId, applicantNik])
  @@index([villageId, status])
  @@index([letterNumber])
  @@index([templateId])
  @@index([villageId, templateId, letterDateKey])
  @@map("mail_services")
}

/**
 * Penghitung nomor surat per desa dan lingkup (kunci buku agenda + periode reset).
 * Dinaikkan di dalam transaksi dengan row lock agar nomor tidak ganda dan tidak bolong
 * bila pembuatan surat dibatalkan.
 */
model MailNumberCounter {
  id        BigInt   @id @default(autoincrement())
  villageId Int
  village   Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  scopeKey  String   @db.VarChar(80)
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([villageId, scopeKey])
  @@map("mail_number_counters")
}

model MailHistory {
  id            BigInt      @id @default(autoincrement())
  mailServiceId BigInt
  mailService   MailService @relation(fields: [mailServiceId], references: [id], onDelete: Cascade)

  action  String @db.VarChar(50) // created, updated, completed, printed, cancelled
  changes Json? // What changed

  changedBy   Int?
  changedUser User? @relation(fields: [changedBy], references: [id])

  changedAt DateTime @default(now())

  @@index([mailServiceId])
  @@map("mail_history")
}

model MailAttachment {
  id            BigInt      @id @default(autoincrement())
  mailServiceId BigInt
  mailService   MailService @relation(fields: [mailServiceId], references: [id], onDelete: Cascade)

  fileName String @db.VarChar(255)
  filePath String @db.VarChar(500)
  fileType String @db.VarChar(50)
  fileSize Int // in bytes

  uploadedAt DateTime @default(now())

  @@index([mailServiceId])
  @@map("mail_attachments")
}

// ============================================
// PELAYANAN SURAT - Mail Requests from Portal
// ============================================

model KioskDevice {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name          String  @db.VarChar(255)
  locationLabel String? @db.VarChar(255)
  keyHash       String  @unique @db.VarChar(64)

  isActive   Boolean   @default(true)
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mailRequests MailRequest[]

  @@index([villageId, isActive])
  @@index([villageId, lastSeenAt(sort: Desc)])
  @@map("kiosk_devices")
}

model MailRequest {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  requestNumber String @unique @db.VarChar(100)

  channel       String       @default("portal") @db.VarChar(50)
  kioskDeviceId BigInt?
  kioskDevice   KioskDevice? @relation(fields: [kioskDeviceId], references: [id], onDelete: SetNull)

  // Requester
  nik  String @db.VarChar(16)
  name String @db.VarChar(255)

  // Request
  mailType String @db.VarChar(255) // Jenis surat yang diminta
  purpose  String @db.Text // Keperluan

  // Status
  status String @default("pending") @db.VarChar(50) // pending, approved, rejected

  // Response
  notes           String? @db.Text
  rejectionReason String? @db.Text

  // Mobile v2: pemohon terhubung ke Resident (null untuk kiosk/portal lama)
  residentId         Int?
  /// Diisi bila kepala keluarga mengajukan atas nama anggota KK
  onBehalfResidentId Int?
  templateId         Int?
  /// Isian tambahan dari form (JSON)
  formData           Json?

  /// Tahap pengantar RT (mobile). null = tanpa tahap RT; pending | approved | rejected. Lihat lib/mobile/rt-logic.ts.
  rtStatus              String?   @db.VarChar(20)
  rtNote                String?   @db.VarChar(300)
  rtDecidedAt           DateTime? @db.DateTime(3)
  rtDecidedByResidentId Int?
  /// Snapshot RT/RW pemohon (sudah dinormalkan, mis. "3") agar antrean RT bisa difilter tanpa join.
  applicantRt           String?   @db.VarChar(10)
  applicantRw           String?   @db.VarChar(10)

  // Dates
  requestDate   DateTime  @default(now())
  processedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, status])
  @@index([villageId, nik])
  @@index([villageId, channel])
  @@index([residentId, createdAt])
  @@index([villageId, rtStatus, applicantRt, applicantRw])
  @@map("mail_requests")
}

// ============================================
// KEUANGAN - Financial Management
// ============================================

model Transaction {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  transactionNumber String   @unique @db.VarChar(100)
  transactionDate   DateTime

  // Type & Category
  type     String @db.VarChar(50) // income, expense
  category String @db.VarChar(100) // Pendapatan, Belanja Pegawai, dll

  // Details
  description String  @db.Text
  amount      Decimal @db.Decimal(15, 2)

  // Budget Reference
  budgetId BigInt?
  budget   Budget? @relation(fields: [budgetId], references: [id])

  // Payment Info
  paymentMethod   String? @db.VarChar(100) // transfer, cash, check
  referenceNumber String? @db.VarChar(100)

  // Attachments
  receiptUrl  String? @db.Text
  attachments Json? // Array of URLs

  // Status
  status String @default("pending") @db.VarChar(50) // pending, verified, approved, rejected

  /// JSON array SDG goal IDs (1–18), e.g. [2, 8]
  sdgGoalIds Json @default("[]")

  // Verification
  verifiedBy Int?
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, transactionDate(sort: Desc)])
  @@index([villageId, type, category])
  @@index([villageId, status])
  @@map("transactions")
}

// ============================================
// ANGGARAN - Budget Management
// ============================================

model Budget {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  budgetCode String @db.VarChar(50) // Kode anggaran
  year       Int

  // Category
  category    String  @db.VarChar(100)
  subCategory String? @db.VarChar(100)

  // Budget vs Realization
  budgetAmount    Decimal @db.Decimal(15, 2)
  realizedAmount  Decimal @default(0) @db.Decimal(15, 2)
  remainingAmount Decimal @db.Decimal(15, 2)

  // Percentage
  realizationPercent Float @default(0)

  // Description
  description String @db.Text

  // Status
  status String @default("active") @db.VarChar(50) // active, completed, cancelled

  /// JSON array SDG goal IDs (1–18), e.g. [2, 8]
  sdgGoalIds Json @default("[]")

  // Audit
  createdBy   Int
  createdUser User @relation("CreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions Transaction[]

  @@unique([villageId, budgetCode, year])
  @@index([villageId, year])
  @@index([villageId, category])
  @@map("budgets")
}

// ============================================
// KOPERASI DESA — pencatatan internal (bukan laporan resmi pengawas)
// ============================================

enum CoopAppRole {
  none
  board
  manager
}

model Cooperative {
  id        Int     @id @default(autoincrement())
  villageId Int     @unique
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name       String  @db.VarChar(255)
  address    String? @db.Text
  phone      String? @db.VarChar(50)
  email      String? @db.VarChar(255)
  /// NIB / NPWP / catatan legal ringkas (opsional)
  legalNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       CooperativeMember[]
  ledgerEntries CooperativeLedgerEntry[]
  formation     CooperativeFormation?
  savings       CooperativeSaving[]
  loans         CooperativeLoan[]

  @@map("cooperatives")
}

model CooperativeMember {
  id            Int         @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  residentId Int?
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)

  name             String   @db.VarChar(255)
  nik              String?  @db.VarChar(16)
  membershipNumber String?  @db.VarChar(50)
  joinedAt         DateTime @default(now())
  status           String   @default("active") @db.VarChar(50) // active, inactive
  notes            String?  @db.Text

  /// Akun dashboard yang sama dengan perangkat desa (opsional)
  linkedUserId Int?
  linkedUser   User? @relation("CoopMemberUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  coopAppRole CoopAppRole @default(none)
  boardTitle  String?     @db.VarChar(120) // Ketua, Sekretaris, Bendahara, dll.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savings CooperativeSaving[]
  loans   CooperativeLoan[]

  @@unique([cooperativeId, linkedUserId])
  @@index([cooperativeId, status])
  @@index([residentId])
  @@map("cooperative_members")
}

model CooperativeLedgerEntry {
  id            Int         @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  entryDate   DateTime @db.Date
  direction   String   @db.VarChar(20) // income | expense
  amount      Decimal  @db.Decimal(15, 2)
  category    String   @db.VarChar(100)
  description String?  @db.Text

  createdBy   Int
  createdUser User @relation("CoopLedgerCreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cooperativeId, entryDate(sort: Desc)])
  @@map("cooperative_ledger_entries")
}

// ============================================
// BUMDes - Badan Usaha Milik Desa (internal records)
// ============================================

model Bumdes {
  id        Int     @id @default(autoincrement())
  villageId Int     @unique
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name       String  @db.VarChar(255)
  address    String? @db.Text
  phone      String? @db.VarChar(50)
  email      String? @db.VarChar(255)
  legalNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units        BumdesUnit[]
  transactions BumdesTransaction[]
  assets       BumdesAsset[]
  journals     BumdesJournal[]
  periodCloses BumdesPeriodClose[]
  periodLogs   BumdesPeriodLog[]
  legalProfile BumdesLegalProfile?
  officers     BumdesOfficer[]
  villageFlows BumdesVillageFlow[]
  resolutions  BumdesMusdesResolution[]

  @@map("bumdes")
}

model BumdesUnit {
  id       Int    @id @default(autoincrement())
  bumdesId Int
  bumdes   Bumdes @relation(fields: [bumdesId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(255)
  category    String? @db.VarChar(100)
  description String? @db.Text
  status      String  @default("active") @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions BumdesTransaction[]
  journals     BumdesJournal[]

  @@index([bumdesId, status])
  @@map("bumdes_units")
}

model BumdesTransaction {
  id       Int        @id @default(autoincrement())
  bumdesId Int
  bumdes   Bumdes     @relation(fields: [bumdesId], references: [id], onDelete: Cascade)
  unitId   Int
  unit     BumdesUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  entryDate   DateTime @db.Date
  direction   String   @db.VarChar(20) // income | expense
  amount      Decimal  @db.Decimal(15, 2)
  category    String   @db.VarChar(100)
  description String?  @db.Text

  /// Akun lawan jurnal (4.x untuk income; 5-7.x untuk expense) dan akun kas (1.1.01.xx). Kosong pada data lama yang belum dijurnal.
  accountCode     String? @db.VarChar(10)
  cashAccountCode String? @db.VarChar(10)
  /// AKTIF | DIBATALKAN (koreksi bukan hapus; riwayat di bumdes_transaction_revisions)
  status          String  @default("AKTIF") @db.VarChar(12)
  revision        Int     @default(0)
  voidedAt        DateTime?
  voidedById      Int?
  voidReason      String? @db.VarChar(300)

  createdBy   Int
  createdUser User @relation("BumdesTransactionCreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions BumdesTransactionRevision[]
  journals  BumdesJournal[]

  @@index([bumdesId, entryDate(sort: Desc)])
  @@index([unitId, entryDate(sort: Desc)])
  @@index([bumdesId, status])
  @@map("bumdes_transactions")
}

model BumdesAsset {
  id       Int    @id @default(autoincrement())
  bumdesId Int
  bumdes   Bumdes @relation(fields: [bumdesId], references: [id], onDelete: Cascade)

  name        String    @db.VarChar(255)
  description String?   @db.Text
  value       Decimal?  @db.Decimal(15, 2)
  acquiredAt  DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bumdesId])
  @@map("bumdes_assets")
}

// ============================================
// POTENSI DESA - Village Potentials
// ============================================

model Potential {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  category    String  @db.VarChar(100) // Pertanian, Peternakan, UMKM, Pariwisata, dll
  subCategory String? @db.VarChar(100)

  name        String @db.VarChar(255)
  description String @db.Text

  // Location
  location String? @db.Text
  area     Float? // in hectare or relevant unit

  // Value & Production
  productionValue Decimal? @db.Decimal(15, 2)
  productionUnit  String?  @db.VarChar(50) // ton, kg, unit, dll
  annualIncome    Decimal? @db.Decimal(15, 2)

  // People involved
  involvedPeople Int? // Jumlah orang yang terlibat

  // Images
  images Json? // Array of image URLs

  /// Stok produk (UKM); null = tidak dilacak
  stockQuantity Int?
  /// Catatan tambahan penjual (SKU, supplier, keterangan internal, dll.)
  productNotes  String? @db.Text

  /// Pemilik produk UKM (warga). Null = dikelola desa. Hanya dipakai untuk category UMKM/UKM.
  residentId Int?
  resident   Resident? @relation("ResidentUkmProducts", fields: [residentId], references: [id], onDelete: SetNull)
  /// Nomor kontak penjual yang diisi pemilik sendiri (bukan nomor terdaftar warga). Tampil ke warga lain hanya bila contactVisible.
  contactPhone   String? @db.VarChar(20)
  contactVisible Boolean @default(false)

  // Status. UKM: active (tayang), pending (kiriman warga menunggu persetujuan), hidden (disembunyikan pemilik),
  // inactive (disembunyikan desa). Potensi lain: active, inactive, potential.
  status String @default("active") @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmPlots FarmPlot[]
  ukmOrders UkmOrderRequest[]

  @@index([villageId, category])
  @@index([villageId, status])
  @@index([residentId])
  @@map("potentials")
}

// Village Potential - Data agregat potensi desa per tahun
model VillagePotential {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  year String @db.VarChar(4) // Tahun data

  // Demografi
  population Int // Jumlah penduduk
  households Int // Jumlah KK

  // Wilayah (dalam hektar)
  area            Float // Luas total
  agricultureLand Float // Lahan pertanian
  plantationLand  Float // Lahan perkebunan
  forestArea      Float // Hutan

  // Fasilitas
  educationFacilities Int @default(0) // Jumlah sekolah/lembaga pendidikan
  healthFacilities    Int @default(0) // Jumlah puskesmas/posyandu/klinik
  tourismSpots        Int @default(0) // Jumlah objek wisata

  // Potensi
  waterResources    String? @db.Text // Deskripsi sumber air
  economicPotential String? @db.Text // Deskripsi potensi ekonomi

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villageId, year])
  @@index([villageId, year])
  @@map("village_potentials")
}

// ============================================
// ARSIP DIGITAL - Digital Archive
// ============================================

model DigitalArchiveFolder {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  parentId BigInt?
  parent   DigitalArchiveFolder?  @relation("DigitalArchiveFolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children DigitalArchiveFolder[] @relation("DigitalArchiveFolderHierarchy")

  /// Segmen nama folder (unescaped)
  name String @db.VarChar(255)
  /// Path unik per desa, mis. "/Surat/2024" (tanpa trailing slash)
  path String @db.VarChar(600)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  archives DigitalArchive[]

  @@unique([villageId, path])
  @@index([villageId, parentId])
  @@map("digital_archive_folders")
}

model DigitalArchive {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  folderId BigInt?
  folder   DigitalArchiveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // File Info
  fileName   String  @db.VarChar(255)
  filePath   String  @db.VarChar(500) // S3, local storage path
  /// Key objek di Spaces (untuk hapus & konsistensi)
  storageKey String? @db.VarChar(600)
  fileType   String  @db.VarChar(50) // pdf, doc, jpg, etc
  fileSize   BigInt // in bytes

  // Metadata
  category    String  @db.VarChar(100) // Surat, Laporan, SK, dll
  subCategory String? @db.VarChar(100)
  year        Int?

  // Description
  title       String  @db.VarChar(255)
  description String? @db.Text
  tags        Json? // Array of tags for search

  // Access Control
  isPublic    Boolean @default(false)
  accessLevel String  @default("admin") @db.VarChar(50) // admin, staff, public

  // Upload Info
  uploadedBy Int
  uploadedAt DateTime @default(now())

  // Download stats
  downloadCount Int       @default(0)
  lastAccessed  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, category])
  @@index([villageId, year])
  @@index([villageId, isPublic])
  @@index([villageId, folderId])
  @@map("digital_archives")
}

// ============================================
// STATISTIK - Village Statistics
// ============================================

model Statistic {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  // Period
  year  Int
  month Int? // NULL = yearly stat

  // Population Stats
  totalPopulation  Int?
  malePopulation   Int?
  femalePopulation Int?
  familyCount      Int?

  // Age Groups
  ageGroup0_4    Int?
  ageGroup5_14   Int?
  ageGroup15_24  Int?
  ageGroup25_54  Int?
  ageGroup55Plus Int?

  // Education
  educationSD      Int?
  educationSMP     Int?
  educationSMA     Int?
  educationDiploma Int?
  educationS1Plus  Int?

  // Occupation
  occupationFarmer   Int?
  occupationMerchant Int?
  occupationEmployee Int?
  occupationOther    Int?

  // Religion
  religionIslam    Int?
  religionKristen  Int?
  religionKatolik  Int?
  religionHindu    Int?
  religionBuddha   Int?
  religionKonghucu Int?

  // Service Stats
  totalMailServices Int?
  totalRequests     Int?
  completedRequests Int?

  // Financial Stats
  totalIncome  Decimal? @db.Decimal(15, 2)
  totalExpense Decimal? @db.Decimal(15, 2)

  // Additional data
  additionalData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villageId, year, month])
  @@index([villageId, year])
  @@map("statistics")
}

// ============================================
// PORTAL WARGA - Citizen Portal
// ============================================

model Announcement {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  title    String @db.VarChar(255)
  content  String @db.Text
  category String @db.VarChar(100) // Pengumuman, Berita, Event

  // Media
  imageUrl String? @db.Text

  // Priority
  isPinned Boolean @default(false)
  priority Int     @default(0)

  // Publication
  publishDate DateTime  @default(now())
  expiryDate  DateTime?

  isActive  Boolean @default(true)
  viewCount Int     @default(0)

  // Author
  createdById Int?
  createdBy   User? @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, isActive, publishDate(sort: Desc)])
  @@index([villageId, category])
  @@map("announcements")
}

// ============================================
// TEMPLATE WEBSITE - Website Templates
// ============================================

model WebsiteTemplate {
  id Int @id @default(autoincrement())

  name        String @db.VarChar(255)
  description String @db.Text
  category    String @db.VarChar(100)

  // Template Files
  previewImage String  @db.Text
  thumbnailUrl String  @db.Text
  demoUrl      String? @db.Text

  // Template Structure
  structure Json // Page layouts, sections, components

  // Pricing
  price            Decimal @db.Decimal(10, 2)
  subscriptionType String  @db.VarChar(50) // yearly, lifetime

  // Stats
  usageCount  Int   @default(0)
  rating      Float @default(0)
  reviewCount Int   @default(0)

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscriptions WebsiteSubscription[]

  @@index([isActive, isFeatured])
  @@index([category])
  @@map("website_templates")
}

model WebsiteSubscription {
  id        Int @id @default(autoincrement())
  villageId Int @unique

  templateId Int
  template   WebsiteTemplate @relation(fields: [templateId], references: [id])

