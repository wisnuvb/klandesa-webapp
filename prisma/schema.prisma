  @@unique([villageId, day])
  @@map("website_daily_stats")
}

/// Pengajuan paket tema (Theme Pack Manifest v1) untuk marketplace template website.
/// Persetujuan menghasilkan/memperbarui baris `website_templates`; kolom ini hanya mengurus siklus review.
model WebsiteThemePack {
  id           Int           @id @default(autoincrement())
  key          String        @db.VarChar(48)
  version      String        @db.VarChar(20)
  name         String        @db.VarChar(80)
  authorName   String        @db.VarChar(80)
  manifest     Json
  /// submitted | approved | rejected | superseded | withdrawn
  status       String        @default("submitted") @db.VarChar(20)
  reviewNote   String?       @db.Text
  reviewedById Int?
  reviewedBy   PlatformUser? @relation("ThemePackReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  /// `website_templates.id` hasil persetujuan
  templateId   Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([key, version])
  @@index([status])
  @@index([templateId])
  @@map("website_theme_packs")
