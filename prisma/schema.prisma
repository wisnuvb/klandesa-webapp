  kind        String           @db.VarChar(12)
  name        String           @db.VarChar(200)
  representativeName  String?  @db.VarChar(150)
  representativeTitle String?  @db.VarChar(100)
  createdAt   DateTime         @default(now())

  budget VillageAgreementBudgetItem[]

  @@index([agreementId])
  @@index([villageId])
