// ─── Mobile v2 (docs/MOBILE_V2_PLAN.md §6.3) ─────────────────────────────────

/// Sesi aplikasi mobile. Refresh token disimpan sebagai hash SHA-256 dan diputar tiap dipakai.
/// Memakai kembali token yang sudah diputar = indikasi pencurian → seluruh keluarga sesi dicabut.
model MobileSession {
  id        BigInt @id @default(autoincrement())
  /// staff = User desa; citizen = CitizenAccount (Fase 1)
  accountType String @db.VarChar(20)
  accountId   Int
  villageId   Int
  /// Roles saat sesi dibuat, mis. "secretary" (staf) atau "citizen"
  role        String @db.VarChar(50)

  /// SHA-256 hex dari refresh token terkini
  refreshHash String @unique @db.VarChar(64)
  /// Mengelompokkan seluruh rotasi dari satu login; dicabut bersama bila terdeteksi reuse
  familyId    String @db.VarChar(36)
  /// Hash token sebelumnya (untuk deteksi reuse sekali putar)
  prevHash    String? @db.VarChar(64)

  deviceId   String? @db.VarChar(100)
  platform   String? @db.VarChar(20)
  appVersion String? @db.VarChar(20)

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([accountType, accountId])
  @@index([familyId])
  @@index([prevHash])
  @@index([expiresAt])
  @@map("mobile_sessions")
}

/// Token push (Expo Push). Satu perangkat bisa berganti akun; token unik.
model DeviceToken {
  id          BigInt @id @default(autoincrement())
  accountType String @db.VarChar(20)
  accountId   Int
  villageId   Int

  expoToken  String   @unique @db.VarChar(255)
  platform   String   @db.VarChar(20)
  appVersion String?  @db.VarChar(20)
  lastSeenAt DateTime @default(now())
  disabledAt DateTime?
  createdAt  DateTime @default(now())

  @@index([accountType, accountId])
  @@index([villageId])
  @@map("device_tokens")
}

/// Akun warga untuk aplikasi mobile (login username + password, tanpa OTP).
/// Satu akun ↔ satu Resident. Lihat docs/MOBILE_V2_PRODUCT_SPEC.md §4.1.
model CitizenAccount {
  id         Int      @id @default(autoincrement())
  villageId  Int
  village    Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  residentId Int      @unique
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  /// huruf kecil, unik di seluruh sistem
  username     String @unique @db.VarChar(30)
  passwordHash String @db.VarChar(255)

  /// ACTIVE | PENDING_VERIFY (menunggu persetujuan desa) | SUSPENDED
  status         String    @default("ACTIVE") @db.VarChar(20)
  /// code | identity | manual | legacy
  signupMethod   String    @default("identity") @db.VarChar(20)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  deletedAt      DateTime?
  /// Sosial desa: syarat komunitas disetujui, dan sanksi moderasi
  socialTermsAt    DateTime?
  /// OK | MUTED | BANNED
  socialStatus     String    @default("OK") @db.VarChar(10)
  socialMutedUntil DateTime?
  /// Id akun di sistem lama (app Flutter) bila diimpor
  legacyUserId   String?   @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, status])
  @@map("citizen_accounts")
}

/// Kode sekali pakai dari desa: ACTIVATE (per KK, dicetak di lembar kode) atau RESET (per warga).
model ActivationCode {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// ACTIVATE | RESET
  purpose    String  @db.VarChar(20)
  /// ACTIVATE: nomor KK; anggota KK mana pun boleh mendaftar dengan NIK-nya sendiri
  kk         String? @db.VarChar(16)
  /// RESET: warga pemilik akun
  residentId Int?

  /// SHA-256 hex dari kode yang dinormalisasi
  codeHash    String  @unique @db.VarChar(64)
  expiresAt   DateTime
  /// ACTIVATE bisa dipakai beberapa anggota KK sampai maxUses
  maxUses     Int     @default(1)
  usedCount   Int     @default(0)
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([villageId, purpose])
  @@index([kk])
  @@index([expiresAt])
  @@map("activation_codes")
}

/// Kotak masuk notifikasi per akun mobile (warga/staf). Terpisah dari AdminNotification (web).
model UserNotification {
  id          BigInt   @id @default(autoincrement())
  accountType String   @db.VarChar(20)
  accountId   Int
  villageId   Int

  /// mail_status | report_status | announcement | data_change | system
  type     String  @db.VarChar(30)
  title    String  @db.VarChar(160)
  body     String? @db.VarChar(500)
  /// Rute di app, mis. "/surat/12"
  deepLink String? @db.VarChar(200)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountType, accountId, createdAt(sort: Desc)])
  @@index([accountType, accountId, readAt])
  @@map("user_notifications")
}

/// Peran tambahan warga di tingkat lingkungan (RT). Satu warga satu penugasan per peran. Lihat lib/mobile/rt-logic.ts.
model VillageRoleAssignment {
  id         Int      @id @default(autoincrement())
  villageId  Int
  residentId Int
  /// "rt" (dipakai sekarang); "rw" disiapkan
  role       String   @db.VarChar(10)
  /// Sudah dinormalkan ("3" untuk "RT 03")
  rt         String?  @db.VarChar(10)
  rw         String?  @db.VarChar(10)
  isActive   Boolean  @default(true)
  createdById Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([villageId, residentId, role])
  @@index([villageId, role, isActive])
  @@map("village_role_assignments")
}

// ─── Iuran & Kas RT (versi A: pencatatan; Klandesa tidak memegang dana). Lihat docs/IURAN_DESIGN.md ───

/// Jadwal iuran/retribusi. scope "rt" = dikelola Ketua RT (rt/rw terisi); scope "desa" = dikelola perangkat desa.
model FeeSchedule {
  id          Int      @id @default(autoincrement())
  villageId   Int
  scope       String   @db.VarChar(10)
  rt          String?  @db.VarChar(10)
  rw          String?  @db.VarChar(10)
  name        String   @db.VarChar(80)
  /// iuran_rt | keamanan | kebersihan | sosial | pbb | retribusi | lainnya
  category    String   @db.VarChar(20)
  /// Rupiah per KK per periode
  amount      Int
  /// monthly | once
  recurrence  String   @db.VarChar(10)
  /// YYYY-MM
  startPeriod String   @db.VarChar(7)
  endPeriod   String?  @db.VarChar(7)
  dueDay      Int      @default(10)
  /// Cara membayar (rekening/QRIS milik RT atau desa), teks bebas
  payInfo     String?  @db.VarChar(500)
  payQrUrl    String?  @db.Text
  isActive    Boolean  @default(true)
  createdByType String @db.VarChar(10)
  createdById   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([villageId, scope, rt, rw, isActive])
  @@map("fee_schedules")
}

/// Tagihan per KK per periode (dibuat otomatis dari jadwal; unik per jadwal+KK+periode).
model FeeCharge {
  id            Int       @id @default(autoincrement())
  villageId     Int
  scheduleId    Int
  kk            String    @db.VarChar(16)
  headResidentId Int?
  headName      String    @db.VarChar(255)
  /// YYYY-MM
  period        String    @db.VarChar(7)
  amount        Int
  waivedAt      DateTime? @db.DateTime(3)
  waivedReason  String?   @db.VarChar(300)
  lastRemindedAt DateTime? @db.DateTime(3)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([scheduleId, kk, period])
  @@index([villageId, period])
  @@index([villageId, kk])
  @@map("fee_charges")
}

/// Pembayaran atas tagihan. Dari warga ("Saya sudah bayar") berstatus pending sampai dikonfirmasi; dari petugas langsung confirmed.
model FeePayment {
  id          Int       @id @default(autoincrement())
  villageId   Int
  chargeId    Int
  amount      Int
  /// cash | transfer | qris
  method      String    @db.VarChar(10)
  proofUrl    String?   @db.Text
  note        String?   @db.VarChar(300)
  /// pending | confirmed | rejected
  status      String    @db.VarChar(10)
  /// warga | officer
  source      String    @db.VarChar(10)
  paidAt      DateTime  @db.DateTime(3)
  recordedByType String @db.VarChar(10)
  recordedById   Int
  decidedAt   DateTime? @db.DateTime(3)
  decisionNote String?  @db.VarChar(300)
  createdAt   DateTime  @default(now())

  @@index([chargeId, status])
  @@index([villageId, status, createdAt])
  @@map("fee_payments")
}

/// Pemasukan/pengeluaran kas di luar iuran (iuran yang sudah dikonfirmasi dihitung otomatis dari fee_payments).
model CashEntry {
  id          Int       @id @default(autoincrement())
  villageId   Int
  scope       String    @db.VarChar(10)
  rt          String?   @db.VarChar(10)
  rw          String?   @db.VarChar(10)
  /// in | out
  type        String    @db.VarChar(3)
  amount      Int
  category    String    @db.VarChar(30)
  description String    @db.VarChar(200)
  entryDate   DateTime  @db.Date
  receiptUrl  String?   @db.Text
  recordedByType String @db.VarChar(10)
  recordedById   Int
  voidedAt    DateTime? @db.DateTime(3)
  voidReason  String?   @db.VarChar(200)
  createdAt   DateTime  @default(now())

  @@index([villageId, scope, rt, rw, entryDate])
  @@map("cash_entries")
}

/// Pengajuan koreksi data warga dari app (warga tidak mengedit data induk langsung). Lihat lib/mobile/data-change-logic.ts.
model DataChangeRequest {
  id                    Int       @id @default(autoincrement())
  villageId             Int
  /// Warga yang datanya dikoreksi
  residentId            Int
  /// Warga yang mengajukan (diri sendiri atau kepala keluarga)
  requestedByResidentId Int
  field                 String    @db.VarChar(30)
  oldValue              String?   @db.Text
  newValue              String    @db.Text
  note                  String?   @db.VarChar(300)
  /// pending | approved | rejected
  status                String    @default("pending") @db.VarChar(20)
  reviewedById          Int?
  reviewedAt            DateTime? @db.DateTime(3)
  reviewNote            String?   @db.VarChar(300)
  /// Terisi bila perubahan sudah diterapkan otomatis ke data warga
  appliedAt             DateTime? @db.DateTime(3)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([villageId, status, createdAt])
  @@index([requestedByResidentId, createdAt])
  @@index([residentId, field, status])
  @@map("data_change_requests")
}

// ─── Sosial desa ("Warga") — docs/MOBILE_V2_PRODUCT_SPEC.md §14 ──────────────

/// Postingan warga (teks, 1–4 foto, atau tautan YouTube). Feed tertutup per desa.
model SocialPost {
  id        BigInt @id @default(autoincrement())
  villageId Int

  /// citizen = CitizenAccount, staff = User desa
  authorType String @db.VarChar(10)
  authorId   Int
  /// Nama tampilan saat posting (snapshot) dan RT penulis
  authorName String @db.VarChar(255)
  authorRt   String? @db.VarChar(10)

  content String @db.Text
  /// kegiatan | usaha | info | lainnya
  category String @db.VarChar(20)

  youtubeId    String? @db.VarChar(16)
  youtubeTitle String? @db.VarChar(200)

  /// Tautan sematan (tanpa unggah video): youtube | tiktok | facebook | x. Baris lama hanya punya youtubeId.
  linkProvider String? @db.VarChar(10)
  linkUrl      String? @db.VarChar(500)
  linkTitle    String? @db.VarChar(200)

  /// PUBLISHED | PENDING (menunggu moderator) | HIDDEN (disembunyikan, menunggu keputusan) | REMOVED
  status       String  @default("PUBLISHED") @db.VarChar(12)
  moderationNote String? @db.VarChar(300)

  likesCount    Int @default(0)
  commentsCount Int @default(0)
  reportsCount  Int @default(0)

  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  media    SocialPostMedia[]
  comments SocialComment[]
  likes    SocialLike[]
  signals  SocialPostSignal[]

  @@index([villageId, status, createdAt(sort: Desc)])
  @@index([villageId, category, status, createdAt(sort: Desc)])
  @@index([authorType, authorId, createdAt])
  @@map("social_posts")
}

model SocialPostMedia {
  id        BigInt     @id @default(autoincrement())
  postId    BigInt
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String     @db.VarChar(500)
  sortOrder Int        @default(0)

  @@index([postId, sortOrder])
  @@map("social_post_media")
}

model SocialComment {
  id        BigInt     @id @default(autoincrement())
  postId    BigInt
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  villageId Int

  authorType String @db.VarChar(10)
  authorId   Int
  authorName String @db.VarChar(255)

  content      String @db.VarChar(500)
  /// PUBLISHED | HIDDEN | REMOVED
  status       String @default("PUBLISHED") @db.VarChar(12)
  reportsCount Int    @default(0)
  likesCount   Int    @default(0)

  createdAt DateTime @default(now())

  likes SocialCommentLike[]

  @@index([postId, status, createdAt])
  @@index([authorType, authorId])
  @@map("social_comments")
}

model SocialLike {
  id          BigInt     @id @default(autoincrement())
  postId      BigInt
  post        SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountType String     @db.VarChar(10)
  accountId   Int
  createdAt   DateTime   @default(now())

  @@unique([postId, accountType, accountId])
  @@map("social_likes")
}

model SocialCommentLike {
  id          BigInt        @id @default(autoincrement())
  commentId   BigInt
  comment     SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  accountType String        @db.VarChar(10)
  accountId   Int
  createdAt   DateTime      @default(now())

  @@unique([commentId, accountType, accountId])
  @@map("social_comment_likes")
}

model SocialBookmark {
  id          BigInt   @id @default(autoincrement())
  postId      BigInt
  accountType String   @db.VarChar(10)
  accountId   Int
  createdAt   DateTime @default(now())

  @@unique([postId, accountType, accountId])
  @@index([accountType, accountId, createdAt])
  @@map("social_bookmarks")
}

/// Jejak ringan "apa yang dilihat/dibuka warga". Satu baris per (akun, postingan) yang di-upsert, bukan log mentah,
/// agar tabel tetap kecil. Sumber data untuk pemeringkatan "Untuk Anda" dan pengukuran (docs/SOCIAL_FEED_RANKING.md).
model SocialPostSignal {
  id          BigInt     @id @default(autoincrement())
  villageId   Int
  postId      BigInt
  post        SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountType String     @db.VarChar(10)
  accountId   Int
  /// Berapa kali tampil di layar (>= 1 detik), dipisah per tab agar bisa dibandingkan.
  seenForYou  Int        @default(0)
  seenLatest  Int        @default(0)
  /// Berapa kali dibuka (detail/komentar), dipisah per tab.
  openForYou  Int        @default(0)
  openLatest  Int        @default(0)
  shares      Int        @default(0)
  /// "Kurangi yang seperti ini": postingan ini tidak ditampilkan lagi di "Untuk Anda" milik akun ini.
  hidden      Boolean    @default(false)
  firstSeenAt DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())

  @@unique([postId, accountType, accountId])
  @@index([accountType, accountId, lastSeenAt])
  @@index([villageId, lastSeenAt])
  @@map("social_post_signals")
}

/// Profil minat per akun: penghitung berbobot yang meluruh menurut waktu (lihat lib/mobile/social-ranking.ts).
/// key: "cat:usaha" | "author:citizen:12" | "rt:03" | "tag:gotongroyong" | "kind:foto".
/// key khusus "pref:no-learn" berarti akun menolak dipelajari minatnya (tidak ada pencatatan, profil dihapus).
model SocialInterest {
  id          BigInt   @id @default(autoincrement())
  accountType String   @db.VarChar(10)
  accountId   Int
  key         String   @db.VarChar(80)
  /// Nilai pada saat `touchedAt`; nilai efektif = score * 0.5^(umur / waktu paruh).
  score       Float
  touchedAt   DateTime @default(now())

  @@unique([accountType, accountId, key])
  @@index([accountType, accountId, score])
  @@map("social_interests")
}

/// Laporan konten/akun oleh warga. Satu pelapor satu kali per target.
model SocialReport {
  id         BigInt @id @default(autoincrement())
  villageId  Int
  /// post | comment
  targetType String @db.VarChar(10)
  targetId   BigInt
  reporterType String @db.VarChar(10)
  reporterId   Int
  /// hoaks | sara | kasar | penipuan | pribadi | lainnya
  reason     String  @db.VarChar(20)
  note       String? @db.VarChar(300)
  /// OPEN | ACTIONED | DISMISSED
  status     String  @default("OPEN") @db.VarChar(10)
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, reporterType, reporterId])
  @@index([villageId, status, createdAt])
  @@map("social_reports")
}

model SocialBlock {
  id          BigInt   @id @default(autoincrement())
  blockerType String   @db.VarChar(10)
  blockerId   Int
  blockedType String   @db.VarChar(10)
  blockedId   Int
  createdAt   DateTime @default(now())

  @@unique([blockerType, blockerId, blockedType, blockedId])
  @@index([blockerType, blockerId])
  @@map("social_blocks")
}

/// Pembatas laju bersama untuk endpoint auth mobile. Penghitung di memori tidak cukup karena
/// webapp berjalan multi-worker (PM2 cluster) sehingga tiap worker punya hitungan sendiri.
model MobileRateLimit {
  key         String   @id @db.VarChar(120)
  count       Int      @default(1)
  windowStart DateTime @db.DateTime(3)

  @@index([windowStart])
  @@map("mobile_rate_limits")
}

/// Status kanal pembayaran LinkQu yang diatur admin platform (satu baris per kode kanal, berlaku untuk semua desa).
/// Tanpa baris = kanal aktif. Kanal yang ditutup lewat env LINKQU_DISABLED_CHANNELS tetap tertutup apa pun isi tabel ini.
model PaymentChannelSetting {
  code             String    @id @db.VarChar(40)
  enabled          Boolean   @default(true)
  /// Alasan yang ditulis admin (internal; pengguna hanya melihat "Sedang tidak tersedia").
  note             String?   @db.VarChar(255)
  updatedByUserId  Int?
  updatedByName    String?   @db.VarChar(255)
  /// Penolakan "kanal tidak aktif" terakhir dari LinkQu saat checkout.
  lastError        String?   @db.VarChar(255)
  lastErrorAt      DateTime?
  /// Hasil uji kanal terakhir dari panel admin.
  lastProbeOk      Boolean?
  lastProbeAt      DateTime?
  lastProbeMessage String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("payment_channel_settings")
}


// ============================================
// KEPENDUDUKAN V2: KK, wilayah, mutasi, arsip hapus (aditif; lihat docs/PHASE1_KEPENDUDUKAN_DESIGN.md)
// ============================================

model Household {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// Nomor KK 16 digit, unik per desa
  kkNumber String @db.VarChar(16)

  headResidentId Int?
  headResident   Resident? @relation("HouseholdHead", fields: [headResidentId], references: [id], onDelete: SetNull)

  address String  @db.VarChar(500)
  rt      String? @db.VarChar(10)
  rw      String? @db.VarChar(10)
  hamlet  String? @db.VarChar(100)

  wilayahUnitId Int?
  wilayahUnit   WilayahUnit? @relation("AreaHouseholds", fields: [wilayahUnitId], references: [id], onDelete: SetNull)
  dusunUnitId   Int?
  dusunUnit     WilayahUnit? @relation("DusunHouseholds", fields: [dusunUnitId], references: [id], onDelete: SetNull)

  /// ACTIVE | INACTIVE (semua anggota meninggal/pindah)
  status String @default("ACTIVE") @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Resident[] @relation("HouseholdMembers")

  @@unique([villageId, kkNumber])
  @@index([villageId, status])
  @@index([villageId, wilayahUnitId])
  @@index([villageId, dusunUnitId])
  @@map("households")
}

model WilayahUnit {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// dusun | rw | rt. Dua pohon terpisah: dusun (datar) dan RW → RT. Dusun dan RW saling silang.
  type String @db.VarChar(10)
  name String @db.VarChar(100)
  /// Kunci kanonik, mis. "dusun:MAWAR", "rw:1", "rt:1|2" ("01" dan "1" satu unit); unik per desa
  canonicalKey String @db.VarChar(200)

  parentId Int?
  parent   WilayahUnit?  @relation("WilayahTree", fields: [parentId], references: [id], onDelete: Restrict)
  children WilayahUnit[] @relation("WilayahTree")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areaResidents    Resident[]  @relation("AreaResidents")
  dusunResidents   Resident[]  @relation("DusunResidents")
  areaHouseholds   Household[] @relation("AreaHouseholds")
  dusunHouseholds  Household[] @relation("DusunHouseholds")

  @@unique([villageId, canonicalKey])
  @@index([villageId, type])
  @@map("wilayah_units")
}

model ResidentMutation {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// BIRTH | DEATH | MOVE_OUT | MOVE_IN | KK_CHANGE
  type String @db.VarChar(20)
  /// PENDING | APPLIED | REJECTED | CANCELLED
  status String @default("PENDING") @db.VarChar(20)
  /// web | mobile | import | legacy_edit
  source String @default("web") @db.VarChar(20)

  effectiveDate DateTime @db.Date

  residentId Int?
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  /// Cuplikan agar catatan tetap terbaca setelah warga dihapus
  residentName     String? @db.VarChar(255)
  residentNikLast4 String? @db.VarChar(4)
  rt               String? @db.VarChar(10)
  rw               String? @db.VarChar(10)
  householdKk      String? @db.VarChar(16)

  /// Isi per jenis (tujuan pindah, sebab meninggal, data warga baru, dst). Tanpa NIK lengkap.
  details Json?

  requestedById   Int?
  decidedById     Int?
  decidedAt       DateTime?
  rejectionReason String?   @db.VarChar(500)
  appliedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([villageId, effectiveDate])
  @@index([villageId, status])
  @@index([residentId])
  @@map("resident_mutations")
}

/// Cuplikan penuh warga sebelum dihapus permanen (pengganti soft delete tanpa mengubah kueri yang ada).
model ResidentArchive {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  residentId Int
  snapshot   Json
  reason     String?  @db.VarChar(500)
  deletedById Int?
  deletedAt  DateTime @default(now())

  @@index([villageId, deletedAt(sort: Desc)])
  @@index([villageId, residentId])
  @@map("resident_archives")
}

// ============================================
// PERMUKAAN PLATFORM (Fase 2): kunci API per desa + log akses (aditif; lihat docs/PHASE2_API_KEYS.md)
// ============================================

/// Kunci API milik satu desa. Rahasia kunci TIDAK disimpan: hanya hash SHA-256 dan awalan untuk dikenali di layar.
model ApiKey {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name      String @db.VarChar(100)
  /// Awalan yang aman ditampilkan, mis. "kld_a1b2c3d4"
  keyPrefix String @db.VarChar(16)
  /// SHA-256 (hex) dari kunci lengkap; kunci beraturan acak 240 bit, jadi hash cepat sudah cukup
  keyHash   String @unique @db.VarChar(64)
  /// Daftar scope, mis. ["kependudukan:read"]. Hanya scope baca pada tahap awal.
  scopes    Json

  createdById Int?
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById Int?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  accessLogs ApiAccessLog[]

  @@index([villageId, revokedAt])
  @@map("api_keys")
}

/// Jejak setiap pemakaian kunci (yang bisa diatribusikan ke desa): untuk dilihat kepala desa. Dibersihkan setelah 90 hari.
model ApiAccessLog {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  apiKeyId  Int?
  apiKey    ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  keyPrefix String? @db.VarChar(16)

  method    String   @db.VarChar(10)
  path      String   @db.VarChar(200)
  status    Int
  ipAddress String?  @db.VarChar(50)
  createdAt DateTime @default(now())

  @@index([villageId, createdAt(sort: Desc)])
  @@index([apiKeyId, createdAt(sort: Desc)])
  @@map("api_access_logs")
}

// ============================================
// DATA KUSTOM (Fase 2): tabel/kolom buatan desa sendiri (aditif; lihat docs/PHASE2_CUSTOM_DATA.md)
// ============================================

/// Tabel buatan desa (mis. "Penerima bantuan beras", "Data lansia RT 03"). Skema hanya bertambah; kolom tak pernah dihapus, hanya diarsipkan.
model CustomTable {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// Pengenal URL/API, unik per desa, tak berubah setelah dibuat
  slug        String  @db.VarChar(60)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  /// Bila true, tiap baris terkait satu warga (kolom residentId pada baris)
  linkResident Boolean @default(false)
  isArchived   Boolean @default(false)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields  CustomField[]
  records CustomRecord[]

  @@unique([villageId, slug])
  @@index([villageId, isArchived])
  @@map("custom_tables")
}

model CustomField {
  id      Int         @id @default(autoincrement())
  tableId Int
  table   CustomTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  /// Pengenal kolom (huruf kecil/angka/_), unik per tabel, tak berubah
  key      String  @db.VarChar(60)
  label    String  @db.VarChar(100)
  /// text | longtext | number | date | boolean | select (tak bisa diubah setelah dibuat)
  type     String  @db.VarChar(20)
  required Boolean @default(false)
  /// select: daftar pilihan (string[]); number: { min?, max?, unit? }
  options  Json?
  /// NONE | PERSONAL | SENSITIVE. Selain NONE tidak pernah keluar lewat API v1.
  piiClass String  @default("NONE") @db.VarChar(12)
  position Int     @default(0)
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([tableId, key])
  @@map("custom_fields")
}

model CustomRecord {
  id        BigInt      @id @default(autoincrement())
  villageId Int
  village   Village     @relation(fields: [villageId], references: [id], onDelete: Cascade)
  tableId   Int
  table     CustomTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  /// Nilai kolom: { [field.key]: nilai } — divalidasi terhadap skema saat ditulis
  data Json

  residentId Int?
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)

  createdById Int?
  updatedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Hapus lunak: baris yang dihapus tidak tampil di aplikasi maupun API, tetapi masih ada untuk pemulihan teknisi
  deletedAt   DateTime?

  @@index([tableId, deletedAt, id])
  @@index([villageId, tableId])
  @@index([residentId])
  @@map("custom_records")
}

/// Tujuan webhook keluar milik desa. Kejadian dikirim sebagai "kejadian tipis" (hanya id, tanpa data pribadi); penerima
/// mengambil detailnya lewat /api/v1 dengan kunci API miliknya. Rahasia penandatangan disimpan untuk menghitung HMAC.
model WebhookEndpoint {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name   String @db.VarChar(100)
  url    String @db.VarChar(500)
  secret String @db.VarChar(80)
  /// Daftar jenis kejadian yang dilanggan, mis. ["mutasi.diterapkan"]
  events Json

  isActive            Boolean   @default(true)
  /// Gagal berturut-turut sejak pengiriman sukses terakhir; nonaktif otomatis bila terlalu banyak
  consecutiveFailures Int       @default(0)
  disabledReason      String?   @db.VarChar(200)
  disabledAt          DateTime?
  lastSuccessAt       DateTime?
  createdById         Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  deliveries WebhookDelivery[]

  @@index([villageId, isActive])
  @@map("webhook_endpoints")
}

/// Antrean keluar (outbox): satu baris per kejadian per tujuan. Dikirim ulang dengan jeda bertambah, lalu menyerah (DEAD).
model WebhookDelivery {
  id         BigInt          @id @default(autoincrement())
  villageId  Int
  village    Village         @relation(fields: [villageId], references: [id], onDelete: Cascade)
  endpointId Int
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  eventId   String @db.VarChar(40)
  eventType String @db.VarChar(60)
  payload   Json
  /// PENDING (menunggu / dijadwalkan ulang) | SUCCESS | DEAD
  status    String @default("PENDING") @db.VarChar(10)
  attempts  Int    @default(0)

  nextAttemptAt  DateTime  @default(now())
  lastStatusCode Int?
  lastError      String?   @db.VarChar(300)
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([villageId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

/// Usulan perubahan data dari aplikasi luar (kunci API / MCP). Aplikasi hanya boleh MENGUSULKAN; admin atau sekretaris desa
/// yang menyetujui (maker-checker). Isi usulan hanya kolom bukan-data-pribadi. Saat ini hanya untuk baris data kustom.
model ChangeProposal {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// api_key | mcp
  source    String  @db.VarChar(12)
  apiKeyId  Int?
  /// Awalan kunci pengusul (snapshot, aman ditampilkan)
  keyPrefix String? @db.VarChar(16)
  keyName   String? @db.VarChar(100)

  /// custom_record
  entity         String  @db.VarChar(20)
  /// create | update
  operation      String  @db.VarChar(10)
  tableId        Int
  targetRecordId BigInt?
  /// Hanya nilai yang diusulkan, { kunciKolom: nilai }
  payload        Json
  /// Catatan dari pengusul: teks TIDAK TERPERCAYA, hanya ditampilkan sebagai teks biasa
  note           String? @db.VarChar(300)

  /// PENDING | APPLIED | REJECTED | EXPIRED
  status          String    @default("PENDING") @db.VarChar(10)
  decidedById     Int?
  decidedAt       DateTime?
  rejectionReason String?   @db.VarChar(300)
  appliedRecordId BigInt?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([villageId, status, createdAt(sort: Desc)])
  @@index([apiKeyId, createdAt(sort: Desc)])
  @@map("change_proposals")
}

/// Templat "Aplikasi Desa" deklaratif: manifes data murni (tabel kustom + widget dasbor), tanpa kode, URL, atau HTML.
/// Tiap versi tidak berubah setelah diajukan; perubahan = versi baru yang ditinjau ulang oleh admin platform.
model AppTemplate {
  id          Int    @id @default(autoincrement())
  /// Pengenal garis versi (sama untuk semua versi templat yang sama)
  lineageKey  String @db.VarChar(40)
  version     Int
  publisherVillageId Int?
  publisher   Village? @relation(fields: [publisherVillageId], references: [id], onDelete: SetNull)
  /// Snapshot nama penerbit untuk ditampilkan di galeri
  publisherName String @db.VarChar(150)
  /// Resmi = diterbitkan platform
  official    Boolean @default(false)

  name         String @db.VarChar(100)
  description  String @db.VarChar(500)
  manifest     Json
  manifestHash String @db.VarChar(64)
  /// Peringatan otomatis (mis. kolom tampak pribadi tetapi ditandai bukan pribadi) untuk peninjau
  warnings     Json

  /// PENDING | PUBLISHED | REJECTED | WITHDRAWN
  status       String    @default("PENDING") @db.VarChar(10)
  reviewNote   String?   @db.VarChar(300)
  reviewedById Int?
  reviewedAt   DateTime?
  publishedAt  DateTime?
  installCount Int       @default(0)
  createdAt    DateTime  @default(now())

  installs AppInstall[]

  @@unique([lineageKey, version])
  @@index([status, publishedAt])
  @@index([publisherVillageId, createdAt(sort: Desc)])
  @@map("app_templates")
}

/// Pemasangan templat di satu desa: tabel kustom yang tercipta + widget dasbor yang sudah dipetakan ke id tabel dan kunci kolom.
model AppInstall {
  id         Int         @id @default(autoincrement())
  villageId  Int
  village    Village     @relation(fields: [villageId], references: [id], onDelete: Cascade)
  templateId Int
  template   AppTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  lineageKey String      @db.VarChar(40)

  name        String @db.VarChar(100)
  /// [{ ref, tableId }]
  tables      Json
  /// Widget yang sudah dipetakan ke tableId dan kunci kolom
  dashboard   Json
  installedById Int?
  createdAt   DateTime @default(now())

  @@unique([villageId, lineageKey])
  @@index([templateId])
  @@map("app_installs")
}

/// Buku Inventaris Aset Desa (Permendagri 1/2016, Lampiran C): satu baris = satu jenis barang milik desa.
/// Terpisah dari `VillageAsset` (titik peta); boleh ditautkan lewat mapAssetId.
model InventoryItem {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  mapAssetId Int?
  mapAsset   VillageAsset? @relation(fields: [mapAssetId], references: [id], onDelete: SetNull)

  name     String  @db.VarChar(200)
  category String  @db.VarChar(40)
  itemCode String? @db.VarChar(60)
  identity String? @db.VarChar(255)
  quantity Int     @default(1)
  /// APBDES | PEROLEHAN_LAIN | ASLI_DESA (kolom 5-7 buku inventaris)
  origin           String   @db.VarChar(20)
  acquiredYear     Int
  acquiredAt       DateTime? @db.Date
  acquisitionValue Decimal?  @db.Decimal(15, 2)
  /// BAIK | RUSAK_RINGAN | RUSAK_BERAT
  condition String  @default("BAIK") @db.VarChar(20)
  location  String? @db.VarChar(255)
  notes     String? @db.VarChar(1000)

  /// ACTIVE | DISPOSED (dihapus dari buku inventaris dengan SK Kepala Desa; barisnya tetap tersimpan)
  status         String    @default("ACTIVE") @db.VarChar(10)
  disposedAt     DateTime? @db.Date
  /// BERALIH_KEPEMILIKAN | PEMUSNAHAN | SEBAB_LAIN (Pasal 21)
  disposalReason String?   @db.VarChar(20)
  disposalDecree String?   @db.VarChar(100)
  disposalNote   String?   @db.VarChar(500)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  landParcel     LandParcel?
  landAgreements LandAgreement[]

  @@index([villageId, status, category])
  @@index([mapAssetId])
  @@map("inventory_items")
}

/// Produk hukum desa: Perdes, Peraturan Kepala Desa, Peraturan Bersama, Keputusan Kepala Desa (register, bukan penyimpan berkas).
model LegalDocument {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// PERDES | PERKADES | PERBER | KEPKADES | LAINNYA
  type          String    @db.VarChar(20)
  number        String    @db.VarChar(60)
  year          Int
  title         String    @db.VarChar(300)
  summary       String?   @db.VarChar(1000)
  enactedAt     DateTime  @db.Date
  promulgatedAt DateTime? @db.Date
  submittedAt   DateTime? @db.Date
  /// BERLAKU | DICABUT
  status        String    @default("BERLAKU") @db.VarChar(10)
  revokedAt     DateTime? @db.Date
  revokedByRef  String?   @db.VarChar(200)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rkpdesDocuments RkpdesDocument[]
  rpjmPlans       RpjmdesPlan[]

  @@unique([villageId, type, year, number])
  @@index([villageId, status, year])
  @@map("legal_documents")
}

/// Register surat masuk/keluar (buku agenda). Nomor agenda berurutan per desa, arah, dan tahun.
model MailRegister {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// IN | OUT
  direction    String   @db.VarChar(3)
  year         Int
  agendaNo     Int
  letterNumber String?  @db.VarChar(100)
  letterDate   DateTime @db.Date
  /// Tanggal diterima (IN) atau dikirim (OUT)
  registeredAt DateTime @db.Date
  /// Asal surat (IN) atau tujuan surat (OUT)
  party        String   @db.VarChar(200)
  subject      String   @db.VarChar(300)
  /// BIASA | PENTING | SEGERA | RAHASIA
  nature       String   @default("BIASA") @db.VarChar(10)
  disposition  String?  @db.VarChar(1000)
  notes        String?  @db.VarChar(500)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([villageId, direction, year, agendaNo])
  @@index([villageId, direction, registeredAt])
  @@map("mail_register")
}

/// Lembaga desa: BPD, LPM/LKD, Karang Taruna, dan lembaga kemasyarakatan lain.
model VillageInstitution {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// BPD | LPM | KARANG_TARUNA | LAINNYA
  type         String    @db.VarChar(20)
  name         String    @db.VarChar(200)
  decreeNumber String?   @db.VarChar(100)
  decreeDate   DateTime? @db.Date
  periodStart  DateTime? @db.Date
  periodEnd    DateTime? @db.Date
  description  String?   @db.VarChar(500)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members InstitutionMember[]

  @@index([villageId, type])
  @@map("village_institutions")
}

model InstitutionMember {
  id            Int                @id @default(autoincrement())
  villageId     Int
  village       Village            @relation(fields: [villageId], references: [id], onDelete: Cascade)
  institutionId Int
  institution   VillageInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  residentId    Int?
  resident      Resident?          @relation(fields: [residentId], references: [id], onDelete: SetNull)

  name     String    @db.VarChar(150)
  /// KETUA | WAKIL_KETUA | SEKRETARIS | BENDAHARA | ANGGOTA
  role     String    @db.VarChar(20)
  division String?   @db.VarChar(100)
  startsAt DateTime? @db.Date
  endsAt   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([villageId])
  @@index([residentId])
  @@map("institution_members")
}

/// Usulan pemutakhiran DTSEN dari desa: warga yang diusulkan masuk/diubah/dikeluarkan, dibawa lewat verifikasi lapangan
/// dan musyawarah desa, lalu diteruskan ke Dinas Sosial. Desa TIDAK menetapkan desil; hasil akhir hanya dicatat.
model DtsenProposal {
  id         Int       @id @default(autoincrement())
  villageId  Int
  village    Village   @relation(fields: [villageId], references: [id], onDelete: Cascade)
  residentId Int?
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)

  /// Salinan saat usulan dibuat, supaya riwayat tetap terbaca bila data warga berubah/terhapus. NIK tidak disalin.
  residentName String  @db.VarChar(255)
  residentRt   String? @db.VarChar(10)
  residentRw   String? @db.VarChar(10)

  /// TAMBAH | UBAH | HAPUS
  kind       String  @db.VarChar(10)
  /// WARGA | RT | PETUGAS | LAINNYA
  source     String  @db.VarChar(10)
  reason     String  @db.VarChar(1000)
  knownDesil String? @db.VarChar(20)

  /// DIAJUKAN | TERVERIFIKASI | DISETUJUI_MUSDES | DITOLAK_MUSDES | DITERUSKAN | SELESAI | DIBATALKAN
  status          String   @default("DIAJUKAN") @db.VarChar(20)
  statusChangedAt DateTime @default(now())

  verifiedAt       DateTime? @db.Date
  verifiedBy       String?   @db.VarChar(150)
  verificationNote String?   @db.VarChar(1000)
  musdesAt         DateTime? @db.Date
  musdesRef        String?   @db.VarChar(150)
  forwardedAt      DateTime? @db.Date
  forwardedRef     String?   @db.VarChar(150)
  /// DITERIMA | DITOLAK (keputusan Dinas Sosial/Kemensos, dicatat saja)
  outcome          String?   @db.VarChar(10)
  outcomeAt        DateTime? @db.Date
  /// Catatan hasil akhir atau alasan pembatalan
  outcomeNote      String?   @db.VarChar(500)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([villageId, status, statusChangedAt])
  @@index([villageId, residentId])
  @@map("dtsen_proposals")
}

/// Pelacak pembentukan Koperasi Desa/Kelurahan Merah Putih di sisi desa (Juklak Kemenkop 1/2025): musdesus, akta, komitmen modal,
/// pengesahan, NPWP, akun Simkopdes. Hanya pencatatan; sistem negara tetap sumber hukumnya.
model CooperativeFormation {
  id            Int         @id @default(autoincrement())
  cooperativeId Int         @unique
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  musdesusAt            DateTime? @db.Date
  musdesusRef           String?   @db.VarChar(150)
  musdesusNotes         String?   @db.VarChar(2000)
  kadesApprovedAt       DateTime? @db.Date
  deedNumber            String?   @db.VarChar(100)
  deedDate              DateTime? @db.Date
  notaryName            String?   @db.VarChar(150)
  commitmentRef         String?   @db.VarChar(150)
  commitmentAmount      Decimal?  @db.Decimal(15, 2)
  submittedToRegencyAt  DateTime? @db.Date
  skNumber              String?   @db.VarChar(100)
  skDate                DateTime? @db.Date
  npwpAt                DateTime? @db.Date
  simkopdesAt           DateTime? @db.Date
  notes                 String?   @db.VarChar(1000)

  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cooperative_formations")
}

/// Polling/pemungutan suara warga. Kerahasiaan dijaga oleh rancangan: siapa yang sudah memilih (PollParticipation) disimpan
/// terpisah dari isi pilihan (PollVote, tanpa id warga dan tanpa waktu), sehingga pilihan seseorang tak dapat ditelusuri dari basis data.
model Poll {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(200)
  description String? @db.VarChar(1000)
  /// Daftar pilihan (teks), 2 sampai 10, urutan tetap. Tak bisa diubah setelah diterbitkan.
  options     Json
  /// Umur minimum pemilih (tahun) pada saat memilih.
  minAge      Int     @default(17)
  /// Hasil tampil ke warga selama berjalan (bila tidak, baru setelah ditutup).
  showLive    Boolean @default(false)

  publishedAt DateTime?
  opensAt     DateTime?
  closesAt    DateTime
  closedAt    DateTime?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participations PollParticipation[]
  votes          PollVote[]

  @@index([villageId, publishedAt])
  @@map("polls")
}

model PollParticipation {
  id         Int       @id @default(autoincrement())
  pollId     Int
  poll       Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  residentId Int?
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)

  @@unique([pollId, residentId])
  @@map("poll_participations")
}

model PollVote {
  /// UUID acak (bukan urutan naik) agar urutan baris tak bisa dicocokkan dengan urutan partisipasi.
  id          String @id @default(uuid()) @db.Char(36)
  pollId      Int
  poll        Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionIndex Int

  @@index([pollId, optionIndex])
  @@map("poll_votes")
}

/// Simpanan anggota koperasi (pokok, wajib, sukarela). Saldo = setor - tarik per jenis. Baris tak pernah diubah atau dihapus: koreksi dengan transaksi lawan.
model CooperativeSaving {
  id            Int               @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative       @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  memberId      Int
  member        CooperativeMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// POKOK | WAJIB | SUKARELA
  kind      String   @db.VarChar(10)
  /// SETOR | TARIK
  direction String   @db.VarChar(5)
  amount    Decimal  @db.Decimal(15, 2)
  txDate    DateTime @db.Date
  note      String?  @db.VarChar(200)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([cooperativeId, memberId, kind])
  @@index([cooperativeId, txDate])
  @@map("cooperative_savings")
}

/// Pinjaman anggota dengan bunga flat per bulan (0 = tanpa bunga). Jadwal angsuran dihitung dari data ini, bukan disimpan.
model CooperativeLoan {
  id            Int               @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative       @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  memberId      Int
  member        CooperativeMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  principal   Decimal  @db.Decimal(15, 2)
  /// Persen per bulan dari pokok awal (bunga flat)
  ratePercent Decimal  @db.Decimal(5, 2)
  termMonths  Int
  disbursedAt DateTime @db.Date
  purpose     String?  @db.VarChar(200)
  /// AKTIF | LUNAS
  status      String   @default("AKTIF") @db.VarChar(10)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments CooperativeLoanPayment[]

  @@index([cooperativeId, memberId])
  @@index([cooperativeId, status])
  @@map("cooperative_loans")
}

model CooperativeLoanPayment {
  id     Int             @id @default(autoincrement())
  loanId Int
  loan   CooperativeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  paidAt DateTime @db.Date
  amount Decimal  @db.Decimal(15, 2)
  note   String?  @db.VarChar(200)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([loanId, paidAt])
  @@map("cooperative_loan_payments")
}

/// Jenis sampah dan harga belinya per kg di satu bank sampah. Harga berubah hanya berlaku untuk setoran berikutnya (setoran menyimpan salinan harga).
model WasteBankItem {
  id          Int       @id @default(autoincrement())
  wasteBankId Int
  wasteBank   WasteBank @relation(fields: [wasteBankId], references: [id], onDelete: Cascade)

  name       String  @db.VarChar(100)
  pricePerKg Decimal @db.Decimal(12, 2)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  txs WasteBankTx[]

  @@unique([wasteBankId, name])
  @@map("waste_bank_items")
}

/// Tabungan nasabah bank sampah. Saldo = jumlah setoran - penarikan; tidak disimpan di baris ini.
model WasteBankAccount {
  id          Int       @id @default(autoincrement())
  wasteBankId Int
  wasteBank   WasteBank @relation(fields: [wasteBankId], references: [id], onDelete: Cascade)
  residentId  Int?
  resident    Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)

  name String @db.VarChar(150)

  createdAt DateTime @default(now())

  txs WasteBankTx[]

  @@index([wasteBankId])
  @@index([residentId])
  @@map("waste_bank_accounts")
}

/// DEPOSIT (setor sampah: berat x harga) atau WITHDRAW (tarik saldo). Baris tak pernah diubah/dihapus; koreksi dengan transaksi lawan.
model WasteBankTx {
  id          Int              @id @default(autoincrement())
  wasteBankId Int
  wasteBank   WasteBank        @relation(fields: [wasteBankId], references: [id], onDelete: Cascade)
  accountId   Int
  account     WasteBankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  itemId      Int?
  item        WasteBankItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// DEPOSIT | WITHDRAW
  kind       String   @db.VarChar(8)
  weightKg   Decimal? @db.Decimal(10, 3)
  pricePerKg Decimal? @db.Decimal(12, 2)
  amount     Decimal  @db.Decimal(15, 2)
  /// Nama jenis sampah saat setoran (tetap terbaca bila jenisnya dihapus)
  itemName   String?  @db.VarChar(100)
  txDate     DateTime @db.Date
  note       String?  @db.VarChar(200)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([wasteBankId, txDate])
  @@index([accountId])
  @@map("waste_bank_txs")
}

/// Satu dosis imunisasi yang sudah diberikan kepada anak. Kode dosis mengikuti jadwal imunisasi rutin (lib/gizi/immunization-catalog.ts).
model ImmunizationRecord {
  id         Int      @id @default(autoincrement())
  villageId  Int
  village    Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  residentId Int
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  vaccineCode String   @db.VarChar(20)
  givenAt     DateTime @db.Date
  note        String?  @db.VarChar(200)

  createdById Int?
  createdAt   DateTime @default(now())

  @@unique([residentId, vaccineCode])
  @@index([villageId, vaccineCode])
  @@map("immunization_records")
}

// ============================================
// KEUANGAN DESA — APB Desa & penatausahaan (Permendagri 20/2018)
// ============================================

/// Pengaturan satu tahun anggaran: rekening kas desa dan nama penandatangan laporan. Satu baris per desa per tahun.
model ApbdesYear {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year      Int

  bankName        String? @db.VarChar(100)
  bankBranch      String? @db.VarChar(100)
  bankAccountNo   String? @db.VarChar(50)
  villageHeadName String? @db.VarChar(150)
  secretaryName   String? @db.VarChar(150)
  treasurerName   String? @db.VarChar(150)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villageId, year])
  @@map("apbdes_years")
}

/// APB Desa (versi 0) atau Perubahan APB Desa (versi 1, 2, ...) untuk satu tahun anggaran.
model ApbdesDocument {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year      Int
  version   Int     @default(0)

  /// DRAFT | DITETAPKAN
  status            String    @default("DRAFT") @db.VarChar(12)
  regulationNumber  String?   @db.VarChar(100)
  regulationDate    DateTime? @db.Date
  /// Wajib untuk perubahan ke-2 dan seterusnya (Pasal 40 ayat 2: hanya sekali setahun kecuali keadaan luar biasa).
  exceptionalReason String?   @db.VarChar(500)
  notes             String?   @db.VarChar(1000)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines ApbdesLine[]

  @@unique([villageId, year, version])
  @@index([villageId, year, status])
  @@map("apbdes_documents")
}

/// Satu baris anggaran: kegiatan (hanya belanja) + kode rekening objek + jumlah, dalam sen.
model ApbdesLine {
  id         Int            @id @default(autoincrement())
  documentId Int
  document   ApbdesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  villageId  Int
  village    Village        @relation(fields: [villageId], references: [id], onDelete: Cascade)

  activityCode String? @db.VarChar(12)
  accountCode  String  @db.VarChar(14)
  description  String  @db.VarChar(300)
  amountCents  BigInt
  /// DD | ADD | PADES | BHPRD | BKP | BKK | LAIN
  fundSource   String? @db.VarChar(8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId, accountCode])
  @@index([villageId])
  @@map("apbdes_lines")
}

/// Satu catatan Buku Kas Umum. Uang dalam sen. Catatan pada bulan yang sudah ditutup tidak dapat diubah.
model ApbdesEntry {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year      Int

  entryDate DateTime @db.Date
  voucherNo String   @db.VarChar(60)
  /// PENERIMAAN | PENGELUARAN | SETOR_PAJAK | TARIK_BANK | SETOR_BANK | PANJAR_KEMBALI
  type      String   @db.VarChar(16)
  /// TUNAI | BANK (untuk TARIK_BANK: BANK; untuk SETOR_BANK: TUNAI, yaitu asal uangnya)
  channel   String   @db.VarChar(5)

  activityCode String?  @db.VarChar(12)
  accountCode  String?  @db.VarChar(14)
  description  String   @db.VarChar(300)
  amountCents  BigInt
  /// Pajak yang dipotong dari pengeluaran ini (Pasal 58); kas keluar sebenarnya = jumlah dikurangi pajak.
  taxCents     BigInt   @default(0)
  taxKind      String?  @db.VarChar(30)
  /// Pengeluaran berupa biaya administrasi bank (kolom "Biaya ADM" di Buku Bank)
  bankFee      Boolean  @default(false)
  /// SPP yang dibayarkan menghasilkan catatan ini; sisa panjar yang dikembalikan dicatat lewat catatan ini
  requestId    Int?
  panjarId     Int?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([villageId, year, entryDate, id])
  @@index([villageId, year, activityCode, accountCode])
  @@index([panjarId])
  @@index([requestId])
  @@map("apbdes_entries")
}

/// Penutupan Buku Kas Umum per bulan (Pasal 63 ayat 3), verifikasi Sekretaris Desa dan persetujuan Kepala Desa (Pasal 67).
model ApbdesMonthClose {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year      Int
  month     Int

  closedAt     DateTime  @default(now())
  closedById   Int?
  verifiedAt   DateTime?
  verifiedById Int?
  approvedAt   DateTime?
  approvedById Int?

  @@unique([villageId, year, month])
  @@map("apbdes_month_closes")
}

// ============================================
// KIA & LANSIA — pencatatan posyandu (data kesehatan: akses dan audit ketat)
// ============================================

/// Satu kehamilan seorang warga. Satu kehamilan terbuka (HAMIL) per warga; "openKey" bernilai 1 selama terbuka dan NULL setelah selesai.
model Pregnancy {
  id         Int      @id @default(autoincrement())
  villageId  Int
  village    Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  residentId Int
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  /// Hari pertama haid terakhir (HPHT)
  lmpDate DateTime @db.Date
  /// Hari perkiraan lahir = HPHT + 280 hari
  edd     DateTime @db.Date
  /// HAMIL | BERSALIN | KEGUGURAN
  status  String   @default("HAMIL") @db.VarChar(12)
  openKey Int?
  endedAt DateTime? @db.Date
  /// Tempat dan penolong persalinan atau keterangan akhir kehamilan
  endNote String?   @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visits PregnancyVisit[]

  @@unique([residentId, openKey])
  @@index([villageId, status])
  @@map("pregnancies")
}

model PregnancyVisit {
  id          Int       @id @default(autoincrement())
  pregnancyId Int
  pregnancy   Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  villageId   Int
  village     Village   @relation(fields: [villageId], references: [id], onDelete: Cascade)

  visitDate      DateTime @db.Date
  gestationWeeks Int
  trimester      Int
  /// BIDAN | DOKTER | LAINNYA
  provider       String   @db.VarChar(10)
  weightKg       Decimal? @db.Decimal(5, 1)
  systolic       Int?
  diastolic      Int?
  upperArmCm     Decimal? @db.Decimal(4, 1)
  fundalHeightCm Decimal? @db.Decimal(4, 1)
  fetalHeartRate Int?
  hemoglobin     Decimal? @db.Decimal(3, 1)
  tetanusGiven   Boolean  @default(false)
  ironTablets    Int?
  ultrasound     Boolean  @default(false)
  /// Daftar kode tanda bahaya yang dilaporkan
  dangerSigns    Json     @default("[]")
  note           String?  @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([pregnancyId, visitDate])
  @@index([villageId, visitDate])
  @@map("pregnancy_visits")
}

/// Satu pemeriksaan posyandu lansia (usia 60 tahun ke atas). Nilai mentah; aplikasi tidak menetapkan kategori IMT atau kemandirian.
model ElderlyCheck {
  id         Int      @id @default(autoincrement())
  villageId  Int
  village    Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  residentId Int
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  checkedAt   DateTime @db.Date
  weightKg    Decimal? @db.Decimal(5, 1)
  heightCm    Decimal? @db.Decimal(4, 1)
  systolic    Int?
  diastolic   Int?
  glucoseMgDl Int?
  /// PUASA | SEWAKTU
  glucoseType String?  @db.VarChar(10)
  /// Skor aktivitas kehidupan sehari-hari (Barthel 10 item, 0 sampai 20), nilai mentah
  adlScore    Int?
  note        String?  @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([villageId, checkedAt])
  @@index([residentId, checkedAt])
  @@map("elderly_checks")
}

// ============================================
// KEUANGAN DESA (lanjutan): DPA/RAK/RAB, SPP, panjar, program sektoral, laporan kepala desa
// ============================================

/// Dokumen Pelaksanaan Anggaran satu kegiatan (Pasal 45): Rencana Kerja Kegiatan, serta persetujuan Sekretaris Desa dan Kepala Desa.
model ApbdesActivityPlan {
  id           Int     @id @default(autoincrement())
  villageId    Int
  village      Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year         Int
  activityCode String  @db.VarChar(12)

  /// Kaur/Kasi pelaksana kegiatan anggaran
  executorName String?  @db.VarChar(150)
  location     String?  @db.VarChar(200)
  outputName   String?  @db.VarChar(200)
  outputVolume Decimal? @db.Decimal(14, 2)
  outputUnit   String?  @db.VarChar(30)
  target       String?  @db.VarChar(300)
  team         String?  @db.VarChar(300)
  startMonth   Int?
  endMonth     Int?
  /// Capaian volume output (untuk Laporan Realisasi Kegiatan)
  realizedVolume Decimal? @db.Decimal(14, 2)

  /// DRAFT | DIVERIFIKASI | DISETUJUI
  status     String    @default("DRAFT") @db.VarChar(12)
  verifiedAt DateTime?
  approvedAt DateTime?

  /// 0 = DPA awal, 1 dst = DPPA ke-n (naik saat dibuka kembali setelah Perubahan APB Desa ditetapkan).
  revision    Int @default(0)
  /// Versi APB Desa (0 = APB Desa, 1 dst = perubahan) yang menjadi dasar persetujuan terakhir.
  baseVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villageId, year, activityCode])
  @@map("apbdes_activity_plans")
}

/// Riwayat DPA/DPPA yang pernah disetujui Kepala Desa: salinan beku rencana kerja, RAK, dan anggaran saat itu.
model ApbdesActivityPlanVersion {
  id           Int     @id @default(autoincrement())
  villageId    Int
  village      Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year         Int
  activityCode String  @db.VarChar(12)
  revision     Int
  baseVersion  Int
  budgetCents  BigInt
  executorName String? @db.VarChar(150)
  /// [{ accountCode, budget: "1000.00", months: ["0.00", ...12] }]
  rak          Json
  /// Rencana kerja saat disetujui: { location, outputName, outputVolume, outputUnit, target, team, startMonth, endMonth }
  work         Json
  /// Baris RAB saat disetujui: [{ accountCode, description, volume, unit, unitPrice, amount }]
  rab          Json
  verifiedAt   DateTime?
  approvedAt   DateTime
  approvedById Int?

  createdAt DateTime @default(now())

  @@unique([villageId, year, activityCode, revision])
  @@map("apbdes_activity_plan_versions")
}

/// Rencana penarikan anggaran per bulan (RAK) per kegiatan dan rekening.
model ApbdesCashPlan {
  id           Int     @id @default(autoincrement())
  villageId    Int
  village      Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year         Int
  activityCode String  @db.VarChar(12)
  accountCode  String  @db.VarChar(14)
  month        Int
  amountCents  BigInt

  @@unique([villageId, year, activityCode, accountCode, month], map: "apbdes_cash_plans_slot_key")
  @@map("apbdes_cash_plans")
}

/// Rencana Anggaran Biaya: satuan harga per kegiatan.
model ApbdesCostItem {
  id             Int     @id @default(autoincrement())
  villageId      Int
  village        Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year           Int
  activityCode   String  @db.VarChar(12)
  accountCode    String  @db.VarChar(14)
  description    String  @db.VarChar(300)
  volume         Decimal @db.Decimal(14, 2)
  unit           String  @db.VarChar(30)
  unitPriceCents BigInt
  amountCents    BigInt

  createdAt DateTime @default(now())

  @@index([villageId, year, activityCode])
  @@map("apbdes_cost_items")
}

/// Surat Permintaan Pembayaran (Pasal 53-55, Lampiran M.1).
model ApbdesPayRequest {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year      Int
  number    Int

  activityCode String  @db.VarChar(12)
  /// SWAKELOLA | PENYEDIA
  mode         String  @db.VarChar(10)
  executorName String? @db.VarChar(150)
  workPeriod   String? @db.VarChar(100)
  /// DIAJUKAN | DIVERIFIKASI | DISETUJUI | DIBAYAR | DITOLAK
  status       String  @default("DIAJUKAN") @db.VarChar(12)
  rejectNote   String? @db.VarChar(300)
  /// Penyedia: bukti penerimaan barang/jasa dan pernyataan tanggung jawab belanja sudah dilampirkan (Pasal 55)
  hasReceipt   Boolean @default(false)
  requestedAt  DateTime  @default(now())
  verifiedAt   DateTime?
  approvedAt   DateTime?
  paidAt       DateTime? @db.Date
  /// Asal SPP bila diajukan dari modul pembayaran: BLT (sourceId = id program), PKTD (id kegiatan), KDMP (tahun). Kosong = SPP biasa.
  sourceKind   String?   @db.VarChar(6)
  sourceId     Int?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines ApbdesPayRequestLine[]

  /// Pembayaran modul yang dibiayai SPP ini (SPP harus sudah dibayar sebelum pembayaran dapat dicatat).
  bltPayments      BltPayment[]
  pktdWorkDays     PktdWorkDay[]
  kdmpInstallments KdmpInstallment[]

  @@unique([villageId, year, number])
  @@index([villageId, year, status])
  @@index([villageId, sourceKind, sourceId])
  @@map("apbdes_pay_requests")
}

model ApbdesPayRequestLine {
  id          Int              @id @default(autoincrement())
  requestId   Int
  request     ApbdesPayRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  accountCode String           @db.VarChar(14)
  description String           @db.VarChar(300)
  payee       String?          @db.VarChar(150)
  amountCents BigInt
  taxCents    BigInt           @default(0)
  taxKind     String?          @db.VarChar(30)

  @@index([requestId])
  @@map("apbdes_pay_request_lines")
}

/// Uang panjar kegiatan swakelola yang diberikan kepada Kaur/Kasi pelaksana (Pasal 54, Lampiran Q.3).
model ApbdesPanjar {
  id           Int     @id @default(autoincrement())
  villageId    Int
  village      Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year         Int
  requestId    Int     @unique
  activityCode String  @db.VarChar(12)
  holderName   String  @db.VarChar(150)
  givenAt      DateTime @db.Date
  givenCents   BigInt
  /// 10 hari kerja sejak diberikan (Pasal 54 ayat 1; akhir pekan dilewati, hari libur nasional tidak dihitung)
  dueAt        DateTime @db.Date

  createdAt DateTime @default(now())

  spj ApbdesPanjarSpj[]

  @@index([villageId, year])
  @@map("apbdes_panjars")
}

/// Pertanggungjawaban panjar: bukti pembayaran barang/jasa yang disampaikan kepada Sekretaris Desa.
model ApbdesPanjarSpj {
  id          Int          @id @default(autoincrement())
  panjarId    Int
  panjar      ApbdesPanjar @relation(fields: [panjarId], references: [id], onDelete: Cascade)
  villageId   Int
  spjDate     DateTime     @db.Date
  voucherNo   String       @db.VarChar(60)
  description String       @db.VarChar(300)
  amountCents BigInt
  checkedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([panjarId])
  @@map("apbdes_panjar_spj")
}

/// Program sektoral, program daerah, dan program lain yang masuk ke desa (Lampiran T.4).
model ApbdesExternalProgram {
  id           Int     @id @default(autoincrement())
  villageId    Int
  village      Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year         Int
  programName  String  @db.VarChar(200)
  activityKind String  @db.VarChar(200)
  location     String? @db.VarChar(200)
  volume       Decimal @db.Decimal(14, 2)
  unit         String  @db.VarChar(30)
  amountCents  BigInt
  fundSource   String  @db.VarChar(150)

  createdAt DateTime @default(now())

  @@index([villageId, year])
  @@map("apbdes_external_programs")
}

/// Laporan Kepala Desa menurut Permendagri 46/2016: LPPD akhir tahun, LPPD akhir masa jabatan, LKPPD. Bagian naratif disimpan sebagai JSON.
model VillageReport {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  /// LPPD_TAHUN | LPPD_JABATAN | LKPPD
  kind      String  @db.VarChar(12)
  year      Int
  /// Teks per bagian: { "pendahuluan_tujuan": "...", ... }
  sections  Json    @default("{}")
  /// DRAFT | DISERAHKAN
  status    String  @default("DRAFT") @db.VarChar(10)
  submittedAt DateTime? @db.Date
  submittedNote String? @db.VarChar(200)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([villageId, kind, year])
  @@map("village_reports")
}

// ============================================
// Musyawarah Desa + siklus RKPDes (docs/PLAN_CELAH_FUNGSI.md, Paket 0 dan 1)
// ============================================

model VillageMeeting {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// MUSDES_PERENCANAAN | MUSRENBANGDES | MUSDES_PERUBAHAN | MUSDES_BLT | MUSDES_BLT_KHUSUS | MUSDES_LAINNYA
  kind        String  @db.VarChar(20)
  title       String  @db.VarChar(200)
  topic       String? @db.VarChar(300)
  /// Tahun rencana yang dibahas (mis. RKPDes 2027); null bila tak terkait tahun.
  planYear    Int?
  scheduledOn DateTime @db.Date
  startTime   String?  @db.VarChar(5)
  location    String?  @db.VarChar(200)
  agenda      String?  @db.Text
  /// PLANNED | HELD | FINAL | CANCELLED
  status      String   @default("PLANNED") @db.VarChar(10)
  heldOn      DateTime? @db.Date
  minutesNo   String?  @db.VarChar(100)
  minutesText String?  @db.Text
  finalizedAt   DateTime?
  finalizedById Int?
  cancelReason  String?  @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendees  VillageMeetingAttendee[]
  decisions  VillageMeetingDecision[]
  asMusdes   RkpdesDocument[] @relation("RkpdesMusdes")
  asMusrenbang RkpdesDocument[] @relation("RkpdesMusrenbang")
  asRpjmMusdes RpjmdesPlan[] @relation("RpjmMusdes")
  asRpjmDraft  RpjmdesPlan[] @relation("RpjmDraftMeeting")

  @@index([villageId, kind, scheduledOn])
  @@index([villageId, planYear])
  @@map("village_meetings")
  bltPrograms BltProgram[] @relation("BltMusdes")
}

model VillageMeetingAttendee {
  id        Int            @id @default(autoincrement())
  meetingId Int
  meeting   VillageMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  residentId Int?
  resident   Resident?     @relation(fields: [residentId], references: [id], onDelete: SetNull)

  name    String  @db.VarChar(150)
  /// Unsur peserta (Permendagri 114/2014 Pasal 46 ayat 3 dan Permendesa 16/2025 Pasal 9).
  unsur   String  @db.VarChar(20)
  gender  String? @db.VarChar(1)
  present Boolean @default(false)
  note    String? @db.VarChar(200)

  createdAt DateTime @default(now())

  @@index([meetingId])
  @@map("village_meeting_attendees")
}

model VillageMeetingDecision {
  id        Int            @id @default(autoincrement())
  meetingId Int
  meeting   VillageMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  seq     Int
  text    String  @db.VarChar(1000)
  refType String? @db.VarChar(30)
  refId   Int?

  createdAt DateTime @default(now())

  @@unique([meetingId, seq])
  @@map("village_meeting_decisions")
}

model RkpdesDocument {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// Tahun RKP Desa (mis. 2027, disusun pada 2026).
  year         Int
  /// 0 = RKP Desa awal; 1, 2, ... = perubahan (Pasal 49-50).
  revision     Int     @default(0)
  /// PERISTIWA_KHUSUS | KEBIJAKAN (hanya untuk revision > 0)
  changeReason String? @db.VarChar(20)
  planId       Int?
  plan         RpjmdesPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  musdesMeetingId     Int?
  musdesMeeting       VillageMeeting? @relation("RkpdesMusdes", fields: [musdesMeetingId], references: [id], onDelete: SetNull)
  musrenbangMeetingId Int?
  musrenbangMeeting   VillageMeeting? @relation("RkpdesMusrenbang", fields: [musrenbangMeetingId], references: [id], onDelete: SetNull)

  teamFormedAt  DateTime? @db.Date
  teamDecreeRef String?   @db.VarChar(150)
  paguReceivedAt DateTime? @db.Date
  /// Evaluasi pelaksanaan RKP Desa tahun sebelumnya (Pasal 41 ayat 1 huruf a).
  evaluationText String? @db.Text
  draftReadyAt   DateTime? @db.Date
  draftMinutesRef String?  @db.VarChar(150)
  draftApprovedAt DateTime? @db.Date
  draftApprovedById Int?
  legalDocumentId Int?
  legalDocument   LegalDocument? @relation(fields: [legalDocumentId], references: [id], onDelete: SetNull)
  usulanSubmittedAt DateTime? @db.Date
  usulanRef         String?   @db.VarChar(150)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team       RkpdesTeamMember[]
  pagu       RkpdesPaguIndicative[]
  incoming   RkpdesIncomingProgram[]
  activities RkpdesActivity[]

  @@unique([villageId, year, revision])
  @@map("rkpdes_documents")
}

model RkpdesTeamMember {
  id         Int            @id @default(autoincrement())
  documentId Int
  document   RkpdesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  residentId Int?
  resident   Resident?      @relation(fields: [residentId], references: [id], onDelete: SetNull)

  name     String  @db.VarChar(150)
  /// PEMBINA | KETUA | SEKRETARIS | ANGGOTA (Pasal 33 ayat 2)
  role     String  @db.VarChar(12)
  position String? @db.VarChar(100)
  gender   String? @db.VarChar(1)

  createdAt DateTime @default(now())

  @@index([documentId])
  @@map("rkpdes_team_members")
}

model RkpdesPaguIndicative {
  id         Int            @id @default(autoincrement())
  documentId Int
  document   RkpdesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// DD | ADD | BHPRD | BKP | BKK | PADES | SWADAYA | PIHAK_KETIGA | LAIN
  source      String @db.VarChar(12)
  amountCents BigInt
  note        String? @db.VarChar(200)

  @@unique([documentId, source])
  @@map("rkpdes_pagu_indicative")
}

model RkpdesIncomingProgram {
  id         Int            @id @default(autoincrement())
  documentId Int
  document   RkpdesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// PUSAT | PROVINSI | KABUPATEN (Pasal 36 ayat 2)
  level       String  @db.VarChar(10)
  agency      String? @db.VarChar(150)
  name        String  @db.VarChar(200)
  location    String? @db.VarChar(200)
  amountCents BigInt?
  note        String? @db.VarChar(300)

  createdAt DateTime @default(now())

  @@index([documentId])
  @@map("rkpdes_incoming_programs")
}

/// Dana Desa per tahun anggaran (Paket 2): pagu dari keputusan pusat/kabupaten dan tanda penyampaian laporan.
/// Rujukan: PMK 7/2026 Pasal 15, 20, 23-25; Permendesa PDT 16/2025 Pasal 10-12.
model DdYearSetting {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year      Int

  /// Pagu Dana Desa reguler dan pagu dukungan KDMP untuk Desa ini, dalam sen. Diisi dari keputusan yang berlaku.
  regularCents    BigInt?
  kdmpCents       BigInt?
  /// Desa berstatus mandiri (Indeks Desa): tahap penyaluran 60/40, bukan 40/60.
  isMandiri       Boolean   @default(false)
  /// Tanggal laporan penetapan fokus ke Menteri (Permendesa 16/2025 Pasal 12) dan laporan tahap penyaluran (PMK 7/2026 Pasal 24).
  focusReportedOn DateTime? @db.Date
  prevYearReportedOn DateTime? @db.Date
  stage1ReportedOn   DateTime? @db.Date
  note            String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villageId, year])
  @@map("dd_year_settings")
}

/// Penandaan fokus penggunaan Dana Desa per kegiatan APB Desa (Permendesa 16/2025 Pasal 2).
model DdFocusTag {
  id           Int     @id @default(autoincrement())
  villageId    Int
  village      Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year         Int
  activityCode String  @db.VarChar(12)
  /// KEMISKINAN_EKSTREM | IKLIM_BENCANA | KESEHATAN | PANGAN_EKONOMI | KDMP | PADAT_KARYA | DIGITAL | SEKTOR_LAIN | OPERASIONAL
  focus        String  @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villageId, year, activityCode], map: "dd_focus_tags_unique")
  @@map("dd_focus_tags")
}

/// Pengecualian atas peringatan larangan penggunaan Dana Desa, wajib beralasan (Lampiran II.J Permendesa 16/2025).
model DdRuleException {
  id           Int     @id @default(autoincrement())
  villageId    Int
  village      Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year         Int
  ruleKey      String  @db.VarChar(8)
  activityCode String  @db.VarChar(12)
  accountCode  String  @db.VarChar(14)
  reason       String  @db.VarChar(500)
  createdById  Int?

  createdAt DateTime @default(now())

  @@unique([villageId, year, ruleKey, activityCode, accountCode], map: "dd_rule_exceptions_unique")
  @@map("dd_rule_exceptions")
}

/// Bukti publikasi fokus penggunaan Dana Desa (Permendesa 16/2025 Pasal 10-11).
model DdPublication {
  id          Int     @id @default(autoincrement())
  villageId   Int
  village     Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year        Int
  /// BALIHO | PAPAN_INFORMASI | MEDIA_ELEKTRONIK | MEDIA_CETAK | MEDIA_SOSIAL | WEBSITE | PENGERAS_SUARA | LAINNYA | SISTEM_INFORMASI
  channel     String  @db.VarChar(20)
  publishedOn DateTime @db.Date
  /// Lokasi papan atau alamat tautan.
  location    String?  @db.VarChar(300)
  note        String?  @db.VarChar(300)
  createdById Int?

  createdAt DateTime @default(now())

  @@index([villageId, year])
  @@map("dd_publications")
}

/// Program BLT Desa satu tahun (Permendesa PDT 16/2025 Pasal 3 dan Lampiran II.A). Uang dalam sen.
model BltProgram {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year      Int
  title     String  @db.VarChar(200)

  /// Nilai per bulan per keluarga (maks. sesuai katalog aturan tahun itu) dan jumlah bulan program.
  monthlyCents BigInt
  totalMonths  Int
  /// DRAFT | DITETAPKAN | SELESAI
  status       String @default("DRAFT") @db.VarChar(12)

  /// Musdes penetapan penerima (jenis MUSDES_BLT) dan Keputusan Kepala Desa.
  musdesMeetingId Int?
  musdesMeeting   VillageMeeting? @relation("BltMusdes", fields: [musdesMeetingId], references: [id], onDelete: SetNull)
  decreeNumber    String?   @db.VarChar(100)
  decreeDate      DateTime? @db.Date
  /// Keputusan dilaporkan kepada bupati/wali kota melalui camat.
  reportedToRegencyOn DateTime? @db.Date
  note            String?   @db.VarChar(500)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  beneficiaries BltBeneficiary[]
  payments      BltPayment[]

  @@unique([villageId, year])
  @@map("blt_programs")
}

/// Keluarga penerima manfaat (KPM), diwakili satu warga. NIK tidak disalin: dibaca dari data warga saat dicetak.
model BltBeneficiary {
  id         Int        @id @default(autoincrement())
  programId  Int
  program    BltProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  villageId  Int
  residentId Int?
  resident   Resident?  @relation(fields: [residentId], references: [id], onDelete: SetNull)

  name       String  @db.VarChar(255)
  kk         String? @db.VarChar(16)
  /// PEMERINTAH (data Pemerintah sebagai acuan) | DESA (kriteria cadangan Kepala Desa)
  source     String  @db.VarChar(10)
  /// Nomor kriteria cadangan yang berlaku (1-5), dipisah koma.
  criteria   String? @db.VarChar(20)
  /// Kategori KPM hasil Musdes dan rincian kelompok pekerjaan (isi minimal Keputusan Kepala Desa).
  category   String  @db.VarChar(100)
  jobGroup   String  @db.VarChar(100)
  /// Bulan program pertama yang boleh dibayarkan (>1 bagi pengganti).
  startMonth Int     @default(1)

  /// AKTIF | DIGANTI | BERAKHIR
  status       String  @default("AKTIF") @db.VarChar(10)
  endedReason  String? @db.VarChar(300)
  endedMeetingId Int?
  replacesId   Int?
  /// Nomor keputusan perubahan bila ini pengganti.
  decreeRef    String? @db.VarChar(150)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments BltPayment[]

  @@index([programId, status])
  @@index([villageId, residentId])
  @@map("blt_beneficiaries")
}

/// Satu pembayaran: bulan program `monthFrom` sampai `monthTo` (maks. 3 bulan sekaligus).
model BltPayment {
  id            Int            @id @default(autoincrement())
  programId     Int
  program       BltProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  villageId     Int
  beneficiaryId Int
  beneficiary   BltBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  monthFrom   Int
  monthTo     Int
  amountCents BigInt
  /// TUNAI | NONTUNAI
  method      String   @db.VarChar(8)
  paidOn      DateTime @db.Date
  /// Penerima yang menandatangani (bila diwakilkan, tulis nama dan hubungan).
  receivedBy  String?  @db.VarChar(150)
  note        String?  @db.VarChar(300)
  /// SPP yang membiayai pembayaran ini (Permendagri 20/2018 Pasal 52-56).
  sppId       Int?
  spp         ApbdesPayRequest? @relation(fields: [sppId], references: [id], onDelete: SetNull)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([beneficiaryId])
  @@index([programId, villageId])
  @@index([sppId])
  @@map("blt_payments")
}

/// Kegiatan Padat Karya Tunai Desa (Permendesa PDT 16/2025 Lampiran II.F). Uang dalam sen.
model PktdActivity {
  id           Int     @id @default(autoincrement())
  villageId    Int
  village      Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year         Int
  /// Kode kegiatan APB Desa (opsional, untuk membandingkan dengan anggaran).
  activityCode String? @db.VarChar(12)
  title        String  @db.VarChar(200)
  location     String? @db.VarChar(200)
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date

  /// Total biaya kegiatan (RAB) dan bagian upah dalam RAB; upah minimal 50% dari biaya.
  costCents        BigInt
  plannedWageCents BigInt   @default(0)
  /// Batas bawah dan atas upah harian hasil kesepakatan Musyawarah Desa (batas atas di bawah UMP), atau Peraturan Bupati.
  wageMinCents     BigInt?
  wageMaxCents     BigInt?
  wageBasis        String?  @db.VarChar(200)
  /// AKTIF | SELESAI
  status           String   @default("AKTIF") @db.VarChar(8)
  note             String?  @db.VarChar(500)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workers PktdWorker[]
  days    PktdWorkDay[]

  @@index([villageId, year])
  @@map("pktd_activities")
}

model PktdWorker {
  id         Int          @id @default(autoincrement())
  activityId Int
  activity   PktdActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  villageId  Int
  residentId Int?
  resident   Resident?    @relation(fields: [residentId], references: [id], onDelete: SetNull)

  name     String  @db.VarChar(255)
  /// L | P
  gender   String? @db.VarChar(1)
  /// PENGANGGUR | SETENGAH_PENGANGGUR | PEREMPUAN_KK | KELUARGA_MISKIN | MARGINAL | DISABILITAS | LAINNYA
  priority String  @db.VarChar(20)

  createdAt DateTime @default(now())

  days PktdWorkDay[]

  @@unique([activityId, residentId], map: "pktd_workers_activity_resident")
  @@index([villageId])
  @@map("pktd_workers")
}

/// Satu hari kerja satu pekerja. Upah dibayar setiap hari: `paidOn` kosong berarti belum dibayar.
model PktdWorkDay {
  id         Int          @id @default(autoincrement())
  activityId Int
  activity   PktdActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  villageId  Int
  workerId   Int
  worker     PktdWorker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  workDate  DateTime  @db.Date
  /// ANGKUT_MATERIAL | PENYIAPAN_LOKASI | PELAKSANAAN | LAINNYA (semuanya masuk perhitungan upah, Lampiran II.F.5.b)
  task      String    @db.VarChar(16)
  wageCents BigInt
  paidOn    DateTime? @db.Date
  note      String?   @db.VarChar(200)
  /// SPP yang membiayai upah ini; diisi saat upah dibayar.
  sppId     Int?
  spp       ApbdesPayRequest? @relation(fields: [sppId], references: [id], onDelete: SetNull)

  createdById Int?
  createdAt   DateTime @default(now())

  @@unique([workerId, workDate], map: "pktd_work_days_worker_date")
  @@index([activityId, workDate])
  @@index([sppId])
  @@map("pktd_work_days")
}

/// Dukungan KDMP (Paket 2): penyaluran dana KDMP yang diterima desa per tahun. Pagu KDMP ada di DdYearSetting.kdmpCents.
/// Rujukan: PMK 7/2026 Pasal 15 ayat 3, 20 ayat 3, 22 ayat 4; Permendesa PDT 16/2025 Pasal 2 ayat 2.
model KdmpDisbursement {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year      Int

  receivedOn  DateTime @db.Date
  amountCents BigInt
  /// Nomor keputusan/nota penyaluran sebagai bukti.
  reference   String?  @db.VarChar(150)
  note        String?  @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([villageId, year])
  @@map("kdmp_disbursements")
}

/// Gerai, pergudangan, atau kelengkapan KDMP yang pembangunannya diangsur dari dana KDMP.
model KdmpFacility {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year      Int

  /// GERAI | GUDANG | KELENGKAPAN | LAINNYA
  kind        String    @db.VarChar(12)
  name        String    @db.VarChar(200)
  location    String?   @db.VarChar(200)
  /// Nilai pekerjaan/kewajiban total yang diangsur; batas atas jumlah angsuran.
  contractCents BigInt?
  /// Progres fisik terakhir (0-100) dan tanggal pencatatannya; diperbarui bersama baris riwayat.
  progressPct Int       @default(0)
  progressOn  DateTime? @db.Date
  /// Tanggal mulai beroperasi (opsional, diisi operator).
  operatingOn DateTime? @db.Date
  note        String?   @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress     KdmpFacilityProgress[]
  installments KdmpInstallment[]

  @@index([villageId, year])
  @@map("kdmp_facilities")
}

model KdmpFacilityProgress {
  id         Int          @id @default(autoincrement())
  facilityId Int
  facility   KdmpFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  villageId  Int

  recordedOn  DateTime @db.Date
  progressPct Int
  note        String?  @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([facilityId, recordedOn])
  @@map("kdmp_facility_progress")
}

/// Angsuran yang dibayarkan dari dana KDMP; opsional terkait satu gerai/gudang.
model KdmpInstallment {
  id         Int           @id @default(autoincrement())
  villageId  Int
  village    Village       @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year       Int
  facilityId Int?
  facility   KdmpFacility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  paidOn      DateTime @db.Date
  amountCents BigInt
  payee       String   @db.VarChar(150)
  /// Nomor perjanjian/kuitansi sebagai bukti.
  reference   String?  @db.VarChar(150)
  note        String?  @db.VarChar(300)
  /// SPP yang membiayai angsuran ini.
  sppId       Int?
  spp         ApbdesPayRequest? @relation(fields: [sppId], references: [id], onDelete: SetNull)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([villageId, year])
  @@index([facilityId])
  @@index([sppId])
  @@map("kdmp_installments")
}

/// Anggota tim penyusun RPJM Desa (Permendagri 114/2014 Pasal 8; Permendesa PDTT 21/2020 Pasal 27).
model RpjmTeamMember {
  id         Int         @id @default(autoincrement())
  villageId  Int
  village    Village     @relation(fields: [villageId], references: [id], onDelete: Cascade)
  planId     Int
  plan       RpjmdesPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Rujukan ke warga (tanpa kunci asing: nama disalin; hanya dipakai mencegah ganda).
  residentId Int?

  name     String  @db.VarChar(150)
  /// PEMBINA | KETUA | SEKRETARIS | ANGGOTA
  role     String  @db.VarChar(12)
  position String? @db.VarChar(100)
  gender   String? @db.VarChar(1)

  createdAt DateTime @default(now())

  @@index([planId])
  @@index([villageId])
  @@map("rpjm_team_members")
}

/// Program/kegiatan RPJM Desa per bidang per tahun dengan anggaran indikatif (Permendagri 114/2014 Pasal 6; PP 16/2026 Pasal 145).
model RpjmProgram {
  id        Int         @id @default(autoincrement())
  villageId Int
  village   Village     @relation(fields: [villageId], references: [id], onDelete: Cascade)
  planId    Int
  plan      RpjmdesPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// 1 pemerintahan | 2 pelaksanaan pembangunan | 3 pembinaan kemasyarakatan | 4 pemberdayaan masyarakat
  fieldCode    String   @db.VarChar(1)
  year         Int
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  /// Kode kegiatan Permendagri 20/2018 (bidang pada kode harus sama dengan fieldCode)
  activityCode String?  @db.VarChar(12)
  location     String?  @db.VarChar(255)
  outputVolume Decimal? @db.Decimal(14, 2)
  outputUnit   String?  @db.VarChar(30)
  /// Sasaran/manfaat
  benefit      String?  @db.VarChar(300)
  budgetCents  BigInt?
  fundSource   String?  @db.VarChar(10)
  method       String?  @db.VarChar(14)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rkpActivities RkpdesActivity[]

  @@index([planId, year])
  @@index([planId, fieldCode])
  @@index([villageId])
  @@map("rpjm_programs")
}

/// Jejak peristiwa penting RPJM Desa (pembukaan kunci untuk perubahan, Pasal 28 / PP 16/2026 Pasal 148).
model RpjmEvent {
  id        Int         @id @default(autoincrement())
  villageId Int
  village   Village     @relation(fields: [villageId], references: [id], onDelete: Cascade)
  planId    Int
  plan      RpjmdesPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// REOPEN
  kind        String   @db.VarChar(12)
  /// PERISTIWA_KHUSUS | KEBIJAKAN
  reason      String?  @db.VarChar(20)
  note        String   @db.VarChar(300)
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([planId])
  @@map("rpjm_events")
}

// >>> models:rpjm (sisipkan model tepat di atas baris ini)

// ============================================
// BUMDes inti (Paket 3): jurnal berpasangan, penutupan periode, legalitas, hubungan APB Desa. Awalan tabel: bumdes_
// ============================================

/// Riwayat perubahan dan pembatalan transaksi kas BUMDes (koreksi bukan hapus). Tidak pernah diubah atau dihapus setelah dibuat.
model BumdesTransactionRevision {
  id            Int               @id @default(autoincrement())
  transactionId Int
  transaction   BumdesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  /// Nomor revisi sesudah tindakan ini (1, 2, ...)
  revision Int
  /// UBAH | BATAL
  action   String @db.VarChar(8)
  reason   String @db.VarChar(300)
  /// Isi transaksi sebelum dan sesudah tindakan (tanggal, arah, jumlah, kategori, uraian, unit, akun).
  before   Json
  after    Json?

  byUserId  Int?
  createdAt DateTime @default(now())

  @@unique([transactionId, revision])
  @@map("bumdes_transaction_revisions")
}

/// Jurnal berpasangan: jumlah debit selalu sama dengan jumlah kredit. unitId kosong = Kantor Pusat (Kepmendes 136/2022 Bab V).
model BumdesJournal {
  id       Int    @id @default(autoincrement())
  bumdesId Int
  bumdes   Bumdes @relation(fields: [bumdesId], references: [id], onDelete: Cascade)
  unitId   Int?
  unit     BumdesUnit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  entryDate DateTime @db.Date
  /// Penomoran bukti: No. urut/bulan/kode unit/tahun (Kepmendes 136/2022). seq berurutan per tahun per BUMDes.
  year      Int
  seq       Int
  voucherNo String   @db.VarChar(60)
  description String @db.VarChar(300)
  /// Nomor bukti dari luar (kuitansi, nota); bebas
  reference String? @db.VarChar(100)
  /// MANUAL | KAS | MODAL | BAGI_HASIL
  source    String   @default("MANUAL") @db.VarChar(12)
  transactionId Int?
  transaction   BumdesTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  /// Jurnal asal yang digantikan oleh jurnal ini (koreksi)
  correctsId Int?

  /// AKTIF | DIBATALKAN
  status     String    @default("AKTIF") @db.VarChar(12)
  voidedAt   DateTime?
  voidedById Int?
  voidReason String?   @db.VarChar(300)

  /// Jumlah sisi debit dan kredit (dipaksa sama oleh server dan CHECK database)
  totalDebitCents  BigInt
  totalCreditCents BigInt

  createdById Int?
  createdAt   DateTime @default(now())

  lines BumdesJournalLine[]
  flows BumdesVillageFlow[]

  @@unique([bumdesId, year, seq])
  @@index([bumdesId, entryDate, id])
  @@index([bumdesId, unitId, entryDate])
  @@index([transactionId])
  @@map("bumdes_journals")
}

model BumdesJournalLine {
  id        Int           @id @default(autoincrement())
  journalId Int
  journal   BumdesJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  lineNo    Int

  /// Kode akun menurut bagan akun Kepmendes 136/2022 (lib/bumdes/catalog.ts)
  accountCode String  @db.VarChar(10)
  debitCents  BigInt  @default(0)
  creditCents BigInt  @default(0)
  memo        String? @db.VarChar(200)

  @@unique([journalId, lineNo])
  @@index([accountCode])
  @@map("bumdes_journal_lines")
}

/// Penutupan periode pembukuan per semester (1 = Jan-Jun, 2 = Jul-Des). Baris ada = periode tertutup.
model BumdesPeriodClose {
  id       Int    @id @default(autoincrement())
  bumdesId Int
  bumdes   Bumdes @relation(fields: [bumdesId], references: [id], onDelete: Cascade)
  year     Int
  half     Int

  closedAt   DateTime @default(now())
  closedById Int?
  /// Angka konsolidasi saat ditutup (sen): laba (rugi) periode dan total aset akhir periode
  profitCents BigInt
  assetCents  BigInt

  @@unique([bumdesId, year, half])
  @@map("bumdes_period_closes")
}

/// Catatan penutupan dan pembukaan kembali periode (tidak pernah dihapus).
model BumdesPeriodLog {
  id       Int    @id @default(autoincrement())
  bumdesId Int
  bumdes   Bumdes @relation(fields: [bumdesId], references: [id], onDelete: Cascade)
  year     Int
  half     Int
  /// TUTUP | BUKA
  action   String  @db.VarChar(8)
  reason   String? @db.VarChar(300)
  byUserId Int?
  createdAt DateTime @default(now())

  @@index([bumdesId, year, half])
  @@map("bumdes_period_logs")
}

/// Data legalitas dan pendaftaran BUM Desa (PP 11/2021 Pasal 7-9, 11; Permendesa PDTT 3/2021 Pasal 2-10). Satu baris per BUMDes.
model BumdesLegalProfile {
  id       Int    @id @default(autoincrement())
  bumdesId Int    @unique
  bumdes   Bumdes @relation(fields: [bumdesId], references: [id], onDelete: Cascade)

  /// BELUM_DAFTAR | PROSES | BADAN_HUKUM (badan hukum = sertifikat pendaftaran elektronik terbit, PP 11/2021 Pasal 8)
  legalStatus String @default("BELUM_DAFTAR") @db.VarChar(14)
  /// Musyawarah Desa pendirian (VillageMeeting, tanpa FK; diperiksa oleh servis)
  establishMeetingId Int?
  establishedOn      DateTime? @db.Date
  /// Peraturan Desa pendirian (memuat Anggaran Dasar)
  perdesNumber String?   @db.VarChar(100)
  perdesDate   DateTime? @db.Date
  /// Peraturan Kepala Desa tentang Anggaran Rumah Tangga
  artNumber    String?   @db.VarChar(100)
  artDate      DateTime? @db.Date
  /// Pendaftaran nama (Permendesa PDTT 3/2021 Pasal 2-7) dan sertifikat badan hukum
  nameApprovalNo   String?   @db.VarChar(100)
  nameApprovalDate DateTime? @db.Date
  certificateNo    String?   @db.VarChar(100)
  certificateDate  DateTime? @db.Date
  nib   String? @db.VarChar(13)
  npwp  String? @db.VarChar(16)
  /// Bidang/jenis usaha dan modal awal (Permendesa PDTT 3/2021 Pasal 9 ayat 2)
  businessFields String? @db.VarChar(500)
  initialCapitalCents BigInt?
  /// Hasil pemeringkatan Kementerian terakhir (A-D), dicatat apa adanya (Permendesa PDTT 3/2021 Pasal 22)
  rankingYear  Int?
  rankingLevel String? @db.VarChar(1)
  note         String? @db.VarChar(500)

  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

