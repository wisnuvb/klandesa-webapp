  sentOn    DateTime? @db.Date
  /// Nomor surat pengantar / tanda terima.
  referenceNo String? @db.VarChar(150)
  note      String? @db.VarChar(500)
  /// Berkas bukti di Arsip Digital (tanpa FK; diperiksa milik desa yang sama saat disimpan).
  archiveId BigInt?
  updatedById Int?

  createdAt DateTime @default(now())
