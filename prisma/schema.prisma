/// ---------------------------------------------------------------------------------------------------------------------
/// P5 Keamanan & ketertiban (resource izin `keamanan`). Kejadian keamanan memakai primitif `incident_events` (domain KEAMANAN);
/// tabel `security_*` yang merujuk kejadian memakai eventId TANPA FK Prisma (agar model incident_* tak berubah) dan dijaga di
/// servis (domain + villageId, kunci baris kejadian). TIDAK ADA tabel/kolom identitas korban kekerasan perempuan/anak: hanya rujukan layanan.
/// ---------------------------------------------------------------------------------------------------------------------

/// Anggota Satlinmas: rujukan ke warga (residentId, tanpa FK; nama dibaca dari residents, tanpa NIK). Dasar: Permendagri 26/2020 Pasal 13-17, 25.
model SecurityMember {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  residentId Int
  /// KEPALA_SATLINMAS | KEPALA_PELAKSANA | KOMANDAN_REGU | ANGGOTA (Pasal 13 ayat 1)
  role       String  @default("ANGGOTA") @db.VarChar(20)
  /// Jenis regu (Pasal 19) bila ada
  squadKind  String? @db.VarChar(20)
  squadName  String? @db.VarChar(100)
  /// ACTIVE | ENDED
  status     String  @default("ACTIVE") @db.VarChar(10)
  /// SK pengangkatan Kepala Desa (Pasal 16 ayat 2) dan pengukuhan bupati/wali kota (Pasal 17)
  decreeNumber  String?   @db.VarChar(100)
  decreeDate    DateTime? @db.Date
  inauguratedOn DateTime? @db.Date
  cardNumber    String?   @db.VarChar(60)
  joinedOn      DateTime? @db.Date
  /// Keputusan perpanjangan masa keanggotaan 60 menjadi 65 tahun (Pasal 25 ayat 3-4)
  extensionDecree String? @db.VarChar(100)
  endedOn     DateTime? @db.Date
  endReason   String?   @db.VarChar(24)
  endDecree   String?   @db.VarChar(100)
  note        String?   @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([villageId, residentId], map: "security_mem_res_uq")
  @@index([villageId, status])
  @@map("security_members")
}

/// Perlengkapan Satlinmas/pos ronda. `inventoryItemId` menaut ke inventaris desa (opsional; tanpa FK, diperiksa sedesa di servis).
model SecurityEquipment {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  category   String  @db.VarChar(20)
  name       String  @db.VarChar(200)
  quantity   Int     @default(1)
  /// BAIK | PERLU_PERBAIKAN | RUSAK | BELUM_DIPERIKSA
  condition  String  @default("BELUM_DIPERIKSA") @db.VarChar(16)
  location   String? @db.VarChar(200)
  custodian  String? @db.VarChar(150)
  inventoryItemId Int?
  lastCheckedOn   DateTime? @db.Date
  note       String? @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([villageId, category])
  @@map("security_equipment")
}

/// Regu ronda/siskamling per RT/RW (Perpol 4/2020 Pasal 35-41: Satkamling dibentuk warga; pos memuat daftar dan jadwal penugasan).
model SecurityRondaGroup {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(120)
  rt        String? @db.VarChar(10)
  rw        String? @db.VarChar(10)
  hamlet    String? @db.VarChar(100)
  postName  String? @db.VarChar(120)
  /// "HH:MM"; selesai lebih kecil dari mulai = melewati tengah malam
  startTime String  @default("22:00") @db.VarChar(5)
  endTime   String  @default("04:00") @db.VarChar(5)
  /// Jumlah petugas per malam
  perShift  Int     @default(2)
  active    Boolean @default(true)
  note      String? @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  people  SecurityRondaPerson[]
  shifts  SecurityRondaShift[]
  swaps   SecurityRondaSwap[]
  logs    SecurityRondaLog[]

  @@unique([villageId, name], map: "security_grp_name_uq")
  @@index([villageId, active])
  @@map("security_ronda_groups")
}

/// Peserta regu ronda: warga (residentId, tanpa FK). Nama dibaca dari residents.
model SecurityRondaPerson {
  id        Int     @id @default(autoincrement())
  villageId Int
  groupId   Int
  group     SecurityRondaGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  residentId Int
  active     Boolean   @default(true)
  joinedOn   DateTime? @db.Date

  createdById Int?
  createdAt   DateTime @default(now())

  @@unique([groupId, residentId], map: "security_rp_uq")
  @@index([villageId, residentId])
  @@map("security_ronda_people")
}

/// Satu baris = satu orang bertugas pada satu malam (tanggal mulai jaga). Kehadiran dicatat pada baris yang sama.
model SecurityRondaShift {
  id        Int     @id @default(autoincrement())
  villageId Int
  groupId   Int
  group     SecurityRondaGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  shiftDate  DateTime @db.Date
  residentId Int
  /// PENDING | PRESENT | LATE | ABSENT | EXCUSED
  attendance String   @default("PENDING") @db.VarChar(10)
  markedAt   DateTime?
  markedById Int?
  attendanceNote String? @db.VarChar(200)
  /// GENERATED | MANUAL | SWAP
  source     String   @default("MANUAL") @db.VarChar(10)
  /// Bila baris ini hasil tukar/pengganti: warga yang semula bertugas (jejak)
  replacedResidentId Int?

  createdById Int?
  createdAt   DateTime @default(now())

  swaps SecurityRondaSwap[]

  @@unique([groupId, shiftDate, residentId], map: "security_shift_uq")
  @@index([villageId, shiftDate])
  @@index([groupId, shiftDate])
  @@index([villageId, residentId, shiftDate])
  @@map("security_ronda_shifts")
}

/// Permintaan tukar/ganti giliran. Berlaku hanya setelah diputuskan (APPROVED) oleh petugas desa; pihak kedua harus tercatat setuju.
model SecurityRondaSwap {
  id        Int     @id @default(autoincrement())
  villageId Int
  groupId   Int
  group     SecurityRondaGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  shiftId   Int
  shift     SecurityRondaShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  /// Pemegang giliran pemohon saat permintaan dibuat; persetujuan ditolak bila giliran sudah dipegang orang lain (permintaan basi)
  requesterResidentId   Int
  /// Warga yang menerima giliran pemohon (dan memberikan gilirannya sendiri bila counterpartShiftId diisi)
  counterpartResidentId Int
  /// Giliran milik pihak kedua yang ditukar (kosong = hanya menggantikan)
  counterpartShiftId    Int?
  counterpartAgreed     Boolean @default(false)
  reason     String? @db.VarChar(300)
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status     String  @default("PENDING") @db.VarChar(10)
  decidedAt  DateTime?
  decidedById Int?
  decisionNote String? @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([groupId, status])
  @@index([shiftId])
  @@map("security_ronda_swaps")
}

/// Buku catatan ronda (Perpol 4/2020 Pasal 41 ayat 1 huruf e): situasi aman (NIHIL) atau temuan. Temuan dapat dieskalasi ke kejadian (eventId).
model SecurityRondaLog {
  id        Int     @id @default(autoincrement())
  villageId Int
  groupId   Int
  group     SecurityRondaGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  shiftDate   DateTime @db.Date
  loggedAt    DateTime
  /// NIHIL | TEMUAN
  kind        String   @db.VarChar(8)
  description String   @db.VarChar(1000)
  reporter    String?  @db.VarChar(150)
  /// Kejadian keamanan hasil eskalasi (tanpa FK; diperiksa domain + desa di servis)
  eventId     Int?

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([groupId, shiftDate])
  @@index([villageId, loggedAt])
  @@map("security_ronda_logs")
}

/// Berita acara mediasi atas satu kejadian keamanan. Memuat pihak (nama saja: tanpa NIK/alamat/telepon), hasil, dan tindak lanjut.
model SecurityMediation {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  eventId   Int

  scheduledAt DateTime
  place       String   @db.VarChar(200)
  mediator    String   @db.VarChar(150)
  /// SCHEDULED | COMPLETED | CANCELLED
  status      String   @default("SCHEDULED") @db.VarChar(10)
  /// SEPAKAT | SEPAKAT_SEBAGIAN | TIDAK_SEPAKAT | DITUNDA | DIRUJUK (hanya bila COMPLETED)
  outcome     String?  @db.VarChar(16)
  agreement   String?  @db.VarChar(2000)
  referredTo  String?  @db.VarChar(200)
  documentRef String?  @db.VarChar(150)
  note        String?  @db.VarChar(500)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parties   SecurityMediationParty[]
  followups SecurityFollowup[]

  @@index([villageId, eventId])
  @@index([villageId, scheduledAt])
  @@map("security_mediations")
}

/// Pihak dalam mediasi. Sengaja tanpa NIK, alamat, telepon, atau uraian identitas korban.
model SecurityMediationParty {
  id        Int     @id @default(autoincrement())
  villageId Int
  mediationId Int
  mediation SecurityMediation @relation(fields: [mediationId], references: [id], onDelete: Cascade)

  /// PIHAK_A | PIHAK_B | SAKSI | PENDAMPING
  side       String  @db.VarChar(10)
  name       String  @db.VarChar(150)
  residentId Int?
  /// Anak (< 18 tahun) menurut tanggal lahir warga saat dicatat: nama selalu disamarkan tanpa izin rinci dan ada pengingat pendampingan
  isMinor    Boolean @default(false)
  attended   Boolean @default(false)
  /// Menyetujui hasil; null = belum/tidak berlaku
  agrees     Boolean?
  note       String? @db.VarChar(300)

  @@index([mediationId])
  @@index([villageId, residentId])
  @@map("security_mediation_parties")
}

/// Tindak lanjut berbatas waktu atas kejadian/mediasi.
model SecurityFollowup {
  id        Int     @id @default(autoincrement())
  villageId Int
  eventId   Int
  mediationId Int?
  mediation SecurityMediation? @relation(fields: [mediationId], references: [id], onDelete: SetNull)

  description String   @db.VarChar(500)
  dueOn       DateTime? @db.Date
  assignee    String?  @db.VarChar(150)
  /// OPEN | DONE
  status      String   @default("OPEN") @db.VarChar(8)
  doneAt      DateTime?
  doneNote    String?  @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([villageId, eventId])
  @@index([villageId, status, dueOn])
  @@map("security_followups")
}

/// Tautan baca-saja kejadian keamanan ke Pengaduan warga (citizen_reports). Tidak menyalin isi pengaduan.
model SecurityReportLink {
  id        Int     @id @default(autoincrement())
  villageId Int
  eventId   Int
  citizenReportId BigInt

  linkedById Int?
  createdAt  DateTime @default(now())

  @@unique([eventId, citizenReportId], map: "security_rl_uq")
  @@index([villageId, citizenReportId])
  @@map("security_report_links")
}

/// Daftar wilayah rawan sederhana (penilaian setempat, bukan klasifikasi resmi).
model SecurityRiskArea {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name   String  @db.VarChar(200)
  kind   String  @db.VarChar(24)
  /// LOW | MEDIUM | HIGH
  level  String  @default("MEDIUM") @db.VarChar(8)
  rt     String? @db.VarChar(10)
  rw     String? @db.VarChar(10)
  hamlet String? @db.VarChar(100)
  lat    Float?
  lng    Float?
  note   String? @db.VarChar(500)
  lastReviewedOn DateTime? @db.Date
  active Boolean @default(true)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([villageId, level])
  @@map("security_risk_areas")
}

/// Direktori kontak layanan/aparat desa ini (Polsek, Babinkamtibmas, UPTD PPA, puskesmas, damkar). Disunting desa; bukan data kasus.
model SecurityContact {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  kind    String  @db.VarChar(20)
  name    String  @db.VarChar(150)
  phone   String  @db.VarChar(40)
  address String? @db.VarChar(255)
  hours   String? @db.VarChar(100)
  note    String? @db.VarChar(300)
  checkedOn DateTime? @db.Date

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([villageId, kind])
  @@map("security_contacts")
}

