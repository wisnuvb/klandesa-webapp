enum SocialBenefitEnrollmentStatus {
  registered
  under_review
  approved
  active
  completed
  withdrawn
}

model SocialBenefitProgram {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name         String  @db.VarChar(255)
  periodLabel  String? @db.VarChar(120)
  /// Catatan internal admin; tidak dikeluarkan lewat API publik.
  internalNote String? @db.Text

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiaries SocialBenefitBeneficiary[]

  @@index([villageId])
  @@index([villageId, isActive])
