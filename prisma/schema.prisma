  locationLng Float?
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villageId, officialId, attendanceDate])
  @@index([villageId, attendanceDate])
  @@index([officialId, attendanceDate])
  @@map("attendances")
}

