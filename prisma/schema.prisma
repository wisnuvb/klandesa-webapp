generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE SYSTEM - Multi-tenant & Authentication
// ============================================

model Village {
  id       Int    @id @default(autoincrement())
  code     String @unique @db.VarChar(20) // Kode desa unik
  name     String @db.VarChar(255)
  district String @db.VarChar(255) // Kecamatan
  regency  String @db.VarChar(255) // Kabupaten
  province String @db.VarChar(255)

  // Contact & Address
  address    String  @db.Text
  postalCode String? @db.VarChar(10)
  phone      String? @db.VarChar(20)
  email      String? @db.VarChar(255)
  website    String? @db.VarChar(255)

  // Logo & Branding
  logoUrl String? @db.Text

  // Settings
  settings Json? // Theme, preferences, etc

  // Subscription & Limits
  subscriptionPlan   String    @default("starter") @db.VarChar(50) // starter, profesional, enterprise
  subscriptionStatus String    @default("active") @db.VarChar(50) // active, inactive, trial, cancelled
  subscriptionDate   DateTime? // Tanggal mulai berlangganan
  subscriptionExpiry DateTime?
  storageLimit       Int       @default(5) // in GB; minimum paket starter = 5 (lihat BILLING_CATALOG.arsip)
  storageUsed        Float     @default(0) // in GB

  /// Add-on absensi: check-in dengan validasi radius GPS (pembayaran terpisah).
  absensiGpsAddonActive      Boolean @default(false)
  /// Titik acuan geofencing (kantor desa). Wajib diisi admin agar GPS check-in berfungsi.
  absensiOfficeLat           Float?
  absensiOfficeLng           Float?
  /// Radius izin absen GPS dalam meter (default 100 m).
  absensiCheckInRadiusMeters Int     @default(100)

  acquiredByPartnerId Int?
  acquiredByPartner   Partner?  @relation("PartnerAcquiredVillages", fields: [acquiredByPartnerId], references: [id], onDelete: SetNull)
  acquiredAt          DateTime?
  acquisitionSource   String?   @db.VarChar(50)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                  User[]
  residents              Resident[]
  officials              Official[]
  workShifts             WorkShift[]
  attendances            Attendance[]
  positions              Position[]
  requests               Request[]
  mailTemplates          MailTemplate[]
  mailServices           MailService[]
  mailRequests           MailRequest[]
  kioskDevices           KioskDevice[]
  transactions           Transaction[]
  budgets                Budget[]
  potentials             Potential[]
  villagePotentials      VillagePotential[]
  digitalArchives        DigitalArchive[]
  digitalArchiveFolders  DigitalArchiveFolder[]
  statistics             Statistic[]
  announcements          Announcement[]
  forumThreads           ForumThread[]
  forumReplies           ForumReply[]
  citizenReports         CitizenReport[]
  citizenReportResponses CitizenReportResponse[]
  adminNotifications     AdminNotification[]
  billingInvoices        BillingInvoice[]
  websiteDomains         WebsiteDomain[]
  cooperative            Cooperative?
  socialBenefitPrograms  SocialBenefitProgram[]

  @@index([code])
  @@index([isActive])
  @@index([regency])
  @@index([regency, district])
  @@index([acquiredByPartnerId])
  @@map("villages")
}

/// Akun dashboard agregat kabupaten/kecamatan (terpisah dari User per-desa).
model RegionalUser {
  id       Int    @id @default(autoincrement())
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  name     String @db.VarChar(255)

  /// regional_kabupaten = seluruh kabupaten; regional_kecamatan = satu kecamatan dalam kabupaten
  role String @db.VarChar(50)

  /// Harus cocok dengan `Village.regency` (teks, dinormalisasi saat provisioning)
  scopeRegency  String  @db.VarChar(255)
  /// Untuk role kecamatan: cocok dengan `Village.district`; untuk kabupaten boleh null
  scopeDistrict String? @db.VarChar(255)

  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  accessLogs RegionalAccessLog[]

  @@index([email])
  @@index([scopeRegency, scopeDistrict])
  @@map("regional_users")
}

model RegionalAccessLog {
  id             Int          @id @default(autoincrement())
  regionalUserId Int
  regionalUser   RegionalUser @relation(fields: [regionalUserId], references: [id], onDelete: Cascade)

  action    String  @db.VarChar(80)
  path      String  @db.VarChar(500)
  ip        String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([regionalUserId, createdAt(sort: Desc)])
  @@map("regional_access_logs")
}

model PlatformUser {
  id       Int    @id @default(autoincrement())
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  name     String @db.VarChar(255)

  role String @default("platform_admin") @db.VarChar(50)

  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  blogPosts BlogPost[]

  @@index([email])
  @@index([role])
  @@map("platform_users")
}

model User {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255) // Hashed

  name   String  @db.VarChar(255)
  phone  String? @db.VarChar(20)
  avatar String? @db.Text

  role      String @db.VarChar(50) // admin, staff, village_head, secretary
  aiCredits Int    @default(0)

  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  createdMailServices    MailService[]            @relation("CreatedBy")
  createdRequests        Request[]                @relation("CreatedBy")
  createdBudgets         Budget[]                 @relation("CreatedBy")
  createdAnnouncements   Announcement[]           @relation("CreatedBy")
  mailHistory            MailHistory[]
  forumThreads           ForumThread[]            @relation("ForumThreadCreatedBy")
  forumReplies           ForumReply[]             @relation("ForumReplyCreatedBy")
  citizenReportsDone     CitizenReport[]          @relation("CitizenReportDoneBy")
  citizenReportResponses CitizenReportResponse[]
  notificationReads      NotificationRead[]
  respondedContacts      Contact[]                @relation("ContactRespondedBy")
  cooperativeMemberLinks CooperativeMember[]      @relation("CoopMemberUser")
  coopLedgerCreates      CooperativeLedgerEntry[] @relation("CoopLedgerCreatedBy")

  @@index([villageId, role])
  @@index([email])
  @@map("users")
}

// ============================================
// NOTIFIKASI ADMIN (header app)
// ============================================

model AdminNotification {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// mail_request_pending | finance_transaction | resident_update
  type      String  @db.VarChar(50)
  title     String  @db.VarChar(255)
  body      String? @db.Text
  href      String? @db.VarChar(500)
  /// Kunci stabil untuk upsync (mis. mail-req-1, tx-2, resident-3)
  sourceKey String  @db.VarChar(120)

  createdAt DateTime @default(now())

  reads NotificationRead[]

  @@unique([villageId, sourceKey])
  @@index([villageId, createdAt(sort: Desc)])
  @@map("admin_notifications")
}

model NotificationRead {
  id             Int               @id @default(autoincrement())
  notificationId Int
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

// ============================================
// DATA WARGA - Residents Management
// ============================================

model Resident {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  // Identitas
  nik  String  @db.VarChar(16) // NIK must be unique per desa
  kk   String? @db.VarChar(16) // Nomor Kartu Keluarga
  name String  @db.VarChar(255)

  // Personal Info
  birthplace    String   @db.VarChar(255)
  birthDate     DateTime
  gender        String   @db.VarChar(20) // Laki-laki, Perempuan
  bloodType     String?  @db.VarChar(5) // A, B, AB, O, A+, B+, AB+, O+, A-, B-, AB-, O-
  religion      String   @db.VarChar(50) // Islam, Kristen, Katolik, Hindu, Buddha, Konghucu, dll
  maritalStatus String   @db.VarChar(50) // Belum Menikah, Menikah, Cerai Hidup, Cerai Mati
  familyRole    String   @db.VarChar(50) // Kepala Keluarga, Istri, Anak, dll

  // Address
  address String  @db.Text
  rt      String? @db.VarChar(10)
  rw      String? @db.VarChar(10)
  hamlet  String? @db.VarChar(100) // Dusun

  // Work & Education
  occupation String? @db.VarChar(255)
  education  String? @db.VarChar(100)

  // Additional
  nationality String  @default("Indonesia") @db.VarChar(50)
  phone       String? @db.VarChar(20)
  email       String? @db.VarChar(255)

  // Family Links
  fatherNik  String? @db.VarChar(16)
  fatherName String? @db.VarChar(255)
  motherNik  String? @db.VarChar(16)
  motherName String? @db.VarChar(255)

  // Health & Social
  isIlliterate    Boolean?  @default(false)
  isDisability    Boolean?  @default(false)
  disabilityId    Int?
  otherDisability String?   @db.VarChar(255)
  isPregnant      Boolean?  @default(false)
  datePregnant    DateTime?
  isBreastfeeding Boolean?  @default(false)
  isStunting      Boolean?  @default(false)
  isBpjsKis       Boolean?  @default(false)
  contraception   String?   @db.VarChar(100)
  height          Int?
  weight          Int?
  income          Int?

  // Media
  cover      String? @db.Text
  coverThumb String? @db.Text
  photo      String? @db.Text
  photoThumb String? @db.Text

  // Misc
  countryCode    String? @db.VarChar(10)
  tempIdNumber   String? @db.VarChar(20)
  tempRt         String? @db.VarChar(10)
  houseOwnership String? @db.VarChar(100)
  desil          String? @db.VarChar(50)

  // Status
  isAlive   Boolean   @default(true)
  moveDate  DateTime? // Place of residence if already moved
  deathDate DateTime? // Date of death

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cooperativeMembers CooperativeMember[]

  @@unique([villageId, nik])
  @@index([villageId, name])
  @@index([villageId, nik])
  @@index([villageId, kk])
  @@map("residents")
}

// ============================================
// DATA PERANGKAT - Village Officials
// ============================================

model Position {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name  String @db.VarChar(255)
  level Int    @default(1) // Hierarchy of position

  // Compensation
  salary    Float?
  allowance Float?

  description String? @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  officials Official[]

  @@index([villageId, isActive])
  @@map("positions")
}

model Official {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  positionId Int
  position   Position @relation(fields: [positionId], references: [id])

  supervisorId Int?
  supervisor   Official?  @relation("OfficialHierarchy", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates Official[] @relation("OfficialHierarchy")

  // Personal Info
  nik        String   @db.VarChar(16)
  name       String   @db.VarChar(255)
  birthplace String   @db.VarChar(255)
  birthDate  DateTime
  gender     String   @db.VarChar(20)

  // Contact
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(255)
  address String  @db.Text

  // Work Info
  startDate DateTime
  endDate   DateTime?

  // Education & Certification
  education     String? @db.VarChar(100)
  certification String? @db.Text

  // Status
  status String @default("active") @db.VarChar(50) // active, inactive, retired

  // Documents
  skPengangkatan String? @db.Text // SK Pengangkatan file URL
  photoUrl       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]

  @@index([villageId, status])
  @@index([villageId, positionId])
  @@index([villageId, supervisorId])
  @@map("officials")
}

// ============================================
// PERMOHONAN WARGA - Citizen Requests
// ============================================

model Request {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  // Request Info
  requestNumber String @unique @db.VarChar(100)
  category      String @db.VarChar(100) // Pengaduan, Permohonan, Informasi
  title         String @db.VarChar(255)
  description   String @db.Text

  // Requester
  requesterNik   String  @db.VarChar(16)
  requesterName  String  @db.VarChar(255)
  requesterPhone String? @db.VarChar(20)
  requesterEmail String? @db.VarChar(255)

  // Status & Priority
  status   String @db.VarChar(50) // pending, in_progress, completed, rejected
  priority String @default("medium") @db.VarChar(50) // low, medium, high, urgent

  // Response
  response        String?   @db.Text
  responseDate    DateTime?
  respondedBy     Int?
  respondedByUser User?     @relation("CreatedBy", fields: [respondedBy], references: [id])

  // Attachments
  attachments Json? // Array of file URLs

  // Dates
  requestDate   DateTime  @default(now())
  completedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, status])
  @@index([villageId, category])
  @@index([requestNumber])
  @@map("requests")
}

// ============================================
// LAYANAN SURAT - Mail Service System
// ============================================

model ForumThread {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  title    String @db.VarChar(255)
  content  String @db.Text
  category String @db.VarChar(50) // UMUM, PEMBANGUNAN, KESEHATAN, PENDIDIKAN, KEAMANAN, EKONOMI
  status   String @default("OPEN") @db.VarChar(20) // OPEN, CLOSED

  isPinned Boolean @default(false)
  isLocked Boolean @default(false)

  likesCount Int @default(0)
  viewsCount Int @default(0)

  createdBy     Int?
  createdByUser User?  @relation("ForumThreadCreatedBy", fields: [createdBy], references: [id])
  createdByName String @db.VarChar(255)
  createdByRole String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies ForumReply[]

  @@index([villageId, createdAt(sort: Desc)])
  @@index([villageId, category])
  @@index([villageId, status])
  @@map("forum_threads")
}

model ForumReply {
  id       BigInt      @id @default(autoincrement())
  threadId BigInt
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  content String @db.Text

  likesCount Int @default(0)

  createdBy     Int?
  createdByUser User?  @relation("ForumReplyCreatedBy", fields: [createdBy], references: [id])
  createdByName String @db.VarChar(255)
  createdByRole String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, createdAt])
  @@index([villageId, createdAt(sort: Desc)])
  @@map("forum_replies")
}

model MailTemplate {
  id        Int      @id @default(autoincrement())
  villageId Int? // NULL = global template
  village   Village? @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name        String @db.VarChar(255)
  description String @db.Text
  category    String @db.VarChar(100) // Keterangan, Pengantar, Kependudukan, dll

  // Template Structure (JSON)
  templateStructure Json // { variables: [], required_fields: [], header_id, footer_id }
  contentTemplate   String @db.Text // Template content with {VARIABLES}

  // Configuration
  isActive           Boolean @default(true)
  isGlobal           Boolean @default(false) // Available for all villages
  /// Kunci stabil untuk seed katalog (unik di DB); null untuk template ad-hoc per-desa.
  catalogKey         String? @unique @db.VarChar(80)
  /// Jika tidak null, template desa ini menggantikan entri katalog dengan `catalogKey` yang sama di UI.
  inheritsCatalogKey String? @db.VarChar(80)

  // Stats
  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mailServices MailService[]

  @@unique([villageId, inheritsCatalogKey])
  @@index([villageId, isActive])
  @@index([category])
  @@index([isGlobal])
  @@map("mail_templates")
}

model MailService {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  templateId       Int
  template         MailTemplate @relation(fields: [templateId], references: [id])
  templateName     String       @db.VarChar(255) // Denormalized for quick access
  templateCategory String       @db.VarChar(100)

  // Letter Identification
  letterNumber  String   @db.VarChar(255)
  letterDate    DateTime
  /**
   * YYYY-MM-DD — skoping unik nomor per (desa, jenis surat, hari).
   */
  letterDateKey String   @db.VarChar(10)

  // Applicant (Normalized for fast query)
  applicantName String @db.VarChar(255)
  applicantNik  String @db.VarChar(16)

  // Signer
  signerRole String? @db.VarChar(50) // kepala_desa, sekretaris, camat
  signerName String? @db.VarChar(255)

  // Dynamic Form Data (JSONB)
  formData Json // All dynamic fields from template

  // Generated Content (Immutable snapshot)
  contentHtml String? @db.Text

  // Status
  status String @default("draft") @db.VarChar(50) // draft, completed, archived, cancelled

  // Audit Trail
  createdBy   Int?
  createdUser User? @relation("CreatedBy", fields: [createdBy], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  printedAt   DateTime?
  printCount  Int       @default(0)

  // Relations
  history     MailHistory[]
  attachments MailAttachment[]

  @@unique([villageId, templateId, letterDateKey, letterNumber])
  @@index([villageId, createdAt(sort: Desc)])
  @@index([villageId, applicantNik])
  @@index([villageId, status])
  @@index([letterNumber])
  @@index([templateId])
  @@index([villageId, templateId, letterDateKey])
  @@map("mail_services")
}

model MailHistory {
  id            BigInt      @id @default(autoincrement())
  mailServiceId BigInt
  mailService   MailService @relation(fields: [mailServiceId], references: [id], onDelete: Cascade)

  action  String @db.VarChar(50) // created, updated, completed, printed, cancelled
  changes Json? // What changed

  changedBy   Int?
  changedUser User? @relation(fields: [changedBy], references: [id])

  changedAt DateTime @default(now())

  @@index([mailServiceId])
  @@map("mail_history")
}

model MailAttachment {
  id            BigInt      @id @default(autoincrement())
  mailServiceId BigInt
  mailService   MailService @relation(fields: [mailServiceId], references: [id], onDelete: Cascade)

  fileName String @db.VarChar(255)
  filePath String @db.VarChar(500)
  fileType String @db.VarChar(50)
  fileSize Int // in bytes

  uploadedAt DateTime @default(now())

  @@index([mailServiceId])
  @@map("mail_attachments")
}

// ============================================
// PELAYANAN SURAT - Mail Requests from Portal
// ============================================

model KioskDevice {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name          String  @db.VarChar(255)
  locationLabel String? @db.VarChar(255)
  keyHash       String  @unique @db.VarChar(64)

  isActive   Boolean   @default(true)
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mailRequests MailRequest[]

  @@index([villageId, isActive])
  @@index([villageId, lastSeenAt(sort: Desc)])
  @@map("kiosk_devices")
}

model MailRequest {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  requestNumber String @unique @db.VarChar(100)

  channel       String       @default("portal") @db.VarChar(50)
  kioskDeviceId BigInt?
  kioskDevice   KioskDevice? @relation(fields: [kioskDeviceId], references: [id], onDelete: SetNull)

  // Requester
  nik  String @db.VarChar(16)
  name String @db.VarChar(255)

  // Request
  mailType String @db.VarChar(255) // Jenis surat yang diminta
  purpose  String @db.Text // Keperluan

  // Status
  status String @default("pending") @db.VarChar(50) // pending, approved, rejected

  // Response
  notes           String? @db.Text
  rejectionReason String? @db.Text

  // Dates
  requestDate   DateTime  @default(now())
  processedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, status])
  @@index([villageId, nik])
  @@index([villageId, channel])
  @@map("mail_requests")
}

// ============================================
// KEUANGAN - Financial Management
// ============================================

model Transaction {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  transactionNumber String   @unique @db.VarChar(100)
  transactionDate   DateTime

  // Type & Category
  type     String @db.VarChar(50) // income, expense
  category String @db.VarChar(100) // Pendapatan, Belanja Pegawai, dll

  // Details
  description String  @db.Text
  amount      Decimal @db.Decimal(15, 2)

  // Budget Reference
  budgetId BigInt?
  budget   Budget? @relation(fields: [budgetId], references: [id])

  // Payment Info
  paymentMethod   String? @db.VarChar(100) // transfer, cash, check
  referenceNumber String? @db.VarChar(100)

  // Attachments
  receiptUrl  String? @db.Text
  attachments Json? // Array of URLs

  // Status
  status String @default("pending") @db.VarChar(50) // pending, verified, approved, rejected

  // Verification
  verifiedBy Int?
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, transactionDate(sort: Desc)])
  @@index([villageId, type, category])
  @@index([villageId, status])
  @@map("transactions")
}

// ============================================
// ANGGARAN - Budget Management
// ============================================

model Budget {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  budgetCode String @db.VarChar(50) // Kode anggaran
  year       Int

  // Category
  category    String  @db.VarChar(100)
  subCategory String? @db.VarChar(100)

  // Budget vs Realization
  budgetAmount    Decimal @db.Decimal(15, 2)
  realizedAmount  Decimal @default(0) @db.Decimal(15, 2)
  remainingAmount Decimal @db.Decimal(15, 2)

  // Percentage
  realizationPercent Float @default(0)

  // Description
  description String @db.Text

  // Status
  status String @default("active") @db.VarChar(50) // active, completed, cancelled

  // Audit
  createdBy   Int
  createdUser User @relation("CreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions Transaction[]

  @@unique([villageId, budgetCode, year])
  @@index([villageId, year])
  @@index([villageId, category])
  @@map("budgets")
}

// ============================================
// KOPERASI DESA — pencatatan internal (bukan laporan resmi pengawas)
// ============================================

enum CoopAppRole {
  none
  board
  manager
}

model Cooperative {
  id        Int     @id @default(autoincrement())
  villageId Int     @unique
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name       String  @db.VarChar(255)
  address    String? @db.Text
  phone      String? @db.VarChar(50)
  email      String? @db.VarChar(255)
  /// NIB / NPWP / catatan legal ringkas (opsional)
  legalNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       CooperativeMember[]
  ledgerEntries CooperativeLedgerEntry[]

  @@map("cooperatives")
}

model CooperativeMember {
  id            Int         @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  residentId Int?
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)

  name             String   @db.VarChar(255)
  nik              String?  @db.VarChar(16)
  membershipNumber String?  @db.VarChar(50)
  joinedAt         DateTime @default(now())
  status           String   @default("active") @db.VarChar(50) // active, inactive
  notes            String?  @db.Text

  /// Akun dashboard yang sama dengan perangkat desa (opsional)
  linkedUserId Int?
  linkedUser   User? @relation("CoopMemberUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  coopAppRole CoopAppRole @default(none)
  boardTitle  String?     @db.VarChar(120) // Ketua, Sekretaris, Bendahara, dll.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cooperativeId, linkedUserId])
  @@index([cooperativeId, status])
  @@index([residentId])
  @@map("cooperative_members")
}

model CooperativeLedgerEntry {
  id            Int         @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  entryDate   DateTime @db.Date
  direction   String   @db.VarChar(20) // income | expense
  amount      Decimal  @db.Decimal(15, 2)
  category    String   @db.VarChar(100)
  description String?  @db.Text

  createdBy   Int
  createdUser User @relation("CoopLedgerCreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cooperativeId, entryDate(sort: Desc)])
  @@map("cooperative_ledger_entries")
}

// ============================================
// POTENSI DESA - Village Potentials
// ============================================

model Potential {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  category    String  @db.VarChar(100) // Pertanian, Peternakan, UMKM, Pariwisata, dll
  subCategory String? @db.VarChar(100)

  name        String @db.VarChar(255)
  description String @db.Text

  // Location
  location String? @db.Text
  area     Float? // in hectare or relevant unit

  // Value & Production
  productionValue Decimal? @db.Decimal(15, 2)
  productionUnit  String?  @db.VarChar(50) // ton, kg, unit, dll
  annualIncome    Decimal? @db.Decimal(15, 2)

  // People involved
  involvedPeople Int? // Jumlah orang yang terlibat

  // Images
  images Json? // Array of image URLs

  /// Stok produk (UKM); null = tidak dilacak
  stockQuantity Int?
  /// Catatan tambahan penjual (SKU, supplier, keterangan internal, dll.)
  productNotes  String? @db.Text

  // Status
  status String @default("active") @db.VarChar(50) // active, inactive, potential

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, category])
  @@index([villageId, status])
  @@map("potentials")
}

// Village Potential - Data agregat potensi desa per tahun
model VillagePotential {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  year String @db.VarChar(4) // Tahun data

  // Demografi
  population Int // Jumlah penduduk
  households Int // Jumlah KK

  // Wilayah (dalam hektar)
  area            Float // Luas total
  agricultureLand Float // Lahan pertanian
  plantationLand  Float // Lahan perkebunan
  forestArea      Float // Hutan

  // Fasilitas
  educationFacilities Int @default(0) // Jumlah sekolah/lembaga pendidikan
  healthFacilities    Int @default(0) // Jumlah puskesmas/posyandu/klinik
  tourismSpots        Int @default(0) // Jumlah objek wisata

  // Potensi
  waterResources    String? @db.Text // Deskripsi sumber air
  economicPotential String? @db.Text // Deskripsi potensi ekonomi

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villageId, year])
  @@index([villageId, year])
  @@map("village_potentials")
}

// ============================================
// ARSIP DIGITAL - Digital Archive
// ============================================

model DigitalArchiveFolder {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  parentId BigInt?
  parent   DigitalArchiveFolder?  @relation("DigitalArchiveFolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children DigitalArchiveFolder[] @relation("DigitalArchiveFolderHierarchy")

  /// Segmen nama folder (unescaped)
  name String @db.VarChar(255)
  /// Path unik per desa, mis. "/Surat/2024" (tanpa trailing slash)
  path String @db.VarChar(600)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  archives DigitalArchive[]

  @@unique([villageId, path])
  @@index([villageId, parentId])
  @@map("digital_archive_folders")
}

model DigitalArchive {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  folderId BigInt?
  folder   DigitalArchiveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // File Info
  fileName   String  @db.VarChar(255)
  filePath   String  @db.VarChar(500) // S3, local storage path
  /// Key objek di Spaces (untuk hapus & konsistensi)
  storageKey String? @db.VarChar(600)
  fileType   String  @db.VarChar(50) // pdf, doc, jpg, etc
  fileSize   BigInt // in bytes

  // Metadata
  category    String  @db.VarChar(100) // Surat, Laporan, SK, dll
  subCategory String? @db.VarChar(100)
  year        Int?

  // Description
  title       String  @db.VarChar(255)
  description String? @db.Text
  tags        Json? // Array of tags for search

  // Access Control
  isPublic    Boolean @default(false)
  accessLevel String  @default("admin") @db.VarChar(50) // admin, staff, public

  // Upload Info
  uploadedBy Int
  uploadedAt DateTime @default(now())

  // Download stats
  downloadCount Int       @default(0)
  lastAccessed  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, category])
  @@index([villageId, year])
  @@index([villageId, isPublic])
  @@index([villageId, folderId])
  @@map("digital_archives")
}

// ============================================
// STATISTIK - Village Statistics
// ============================================

model Statistic {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  // Period
  year  Int
  month Int? // NULL = yearly stat

  // Population Stats
  totalPopulation  Int?
  malePopulation   Int?
  femalePopulation Int?
  familyCount      Int?

  // Age Groups
  ageGroup0_4    Int?
  ageGroup5_14   Int?
  ageGroup15_24  Int?
  ageGroup25_54  Int?
  ageGroup55Plus Int?

  // Education
  educationSD      Int?
  educationSMP     Int?
  educationSMA     Int?
  educationDiploma Int?
  educationS1Plus  Int?

  // Occupation
  occupationFarmer   Int?
  occupationMerchant Int?
  occupationEmployee Int?
  occupationOther    Int?

  // Religion
  religionIslam    Int?
  religionKristen  Int?
  religionKatolik  Int?
  religionHindu    Int?
  religionBuddha   Int?
  religionKonghucu Int?

  // Service Stats
  totalMailServices Int?
  totalRequests     Int?
  completedRequests Int?

  // Financial Stats
  totalIncome  Decimal? @db.Decimal(15, 2)
  totalExpense Decimal? @db.Decimal(15, 2)

  // Additional data
  additionalData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villageId, year, month])
  @@index([villageId, year])
  @@map("statistics")
}

// ============================================
// PORTAL WARGA - Citizen Portal
// ============================================

model Announcement {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  title    String @db.VarChar(255)
  content  String @db.Text
  category String @db.VarChar(100) // Pengumuman, Berita, Event

  // Media
  imageUrl String? @db.Text

  // Priority
  isPinned Boolean @default(false)
  priority Int     @default(0)

  // Publication
  publishDate DateTime  @default(now())
  expiryDate  DateTime?

  isActive  Boolean @default(true)
  viewCount Int     @default(0)

  // Author
  createdById Int?
  createdBy   User? @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, isActive, publishDate(sort: Desc)])
  @@index([villageId, category])
  @@map("announcements")
}

// ============================================
// TEMPLATE WEBSITE - Website Templates
// ============================================

model WebsiteTemplate {
  id Int @id @default(autoincrement())

  name        String @db.VarChar(255)
  description String @db.Text
  category    String @db.VarChar(100)

  // Template Files
  previewImage String  @db.Text
  thumbnailUrl String  @db.Text
  demoUrl      String? @db.Text

  // Template Structure
  structure Json // Page layouts, sections, components

  // Pricing
  price            Decimal @db.Decimal(10, 2)
  subscriptionType String  @db.VarChar(50) // yearly, lifetime

  // Stats
  usageCount  Int   @default(0)
  rating      Float @default(0)
  reviewCount Int   @default(0)

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscriptions WebsiteSubscription[]

  @@index([isActive, isFeatured])
  @@index([category])
  @@map("website_templates")
}

model WebsiteSubscription {
  id        Int @id @default(autoincrement())
  villageId Int @unique

  templateId Int
  template   WebsiteTemplate @relation(fields: [templateId], references: [id])

  // Subscription Info
  startDate  DateTime
  expiryDate DateTime

  // Customization
  customization Json? // Colors, fonts, content overrides

  // Domain
  customDomain String? @db.VarChar(255)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId])
  @@index([templateId])
  @@map("website_subscriptions")
}

model WebsiteDomain {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  hostname String @unique @db.VarChar(255)
  type     String @db.VarChar(20) // subdomain | custom

  isPrimary Boolean @default(false)
  status    String  @default("pending_verification") @db.VarChar(40)

  verificationMethod      String?   @db.VarChar(30) // dns_txt
  verificationToken       String?   @db.VarChar(120)
  verificationRequestedAt DateTime?
  verifiedAt              DateTime?

  dnsConfig     Json?
  routingConfig Json?

  sslStatus   String    @default("pending") @db.VarChar(30) // pending | active | error | manual
  sslIssuedAt DateTime?

  lastCheckedAt DateTime?
  lastError     String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events WebsiteDomainEvent[]

  @@index([villageId])
  @@index([status])
  @@map("website_domains")
}

model WebsiteDomainEvent {
  id       BigInt        @id @default(autoincrement())
  domainId Int
  domain   WebsiteDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  kind    String  @db.VarChar(50) // created | verification_requested | verified | ssl_updated | error | routing_updated
  message String? @db.Text
  meta    Json?

  createdAt DateTime @default(now())

  @@index([domainId, createdAt(sort: Desc)])
  @@map("website_domain_events")
}

model BillingInvoice {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  invoiceNumber String @unique @db.VarChar(100)
  provider      String @default("LINKQU") @db.VarChar(30)
  partnerReff   String @unique @db.VarChar(100)

  productType String @db.VarChar(50)
  planCode    String @db.VarChar(50)

  currency String  @default("IDR") @db.VarChar(10)
  amount   Decimal @db.Decimal(15, 2)
  status   String  @default("pending") @db.VarChar(30)

  paymentMethod String? @db.VarChar(30)
  bankCode      String? @db.VarChar(30)
  retailCode    String? @db.VarChar(30)

  paymentUrl String? @db.Text
  qrContent  String? @db.Text
  qrImageUrl String? @db.Text
  vaNumber   String? @db.VarChar(80)

  externalTransactionId String? @db.VarChar(120)

  expiresAt DateTime?
  paidAt    DateTime?

  rawResponse Json?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  BillingInvoiceItem[]
  events BillingPaymentEvent[]

  @@index([villageId, createdAt(sort: Desc)])
  @@index([villageId, status])
  @@map("billing_invoices")
}

model BillingInvoiceItem {
  id        BigInt         @id @default(autoincrement())
  invoiceId BigInt
  invoice   BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(255)
  description String? @db.Text
  quantity    Int     @default(1)
  unitAmount  Decimal @db.Decimal(15, 2)
  totalAmount Decimal @db.Decimal(15, 2)

  metadata Json?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("billing_invoice_items")
}

model BillingPaymentEvent {
  id        BigInt         @id @default(autoincrement())
  invoiceId BigInt
  invoice   BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  provider       String  @default("LINKQU") @db.VarChar(30)
  eventType      String  @default("callback") @db.VarChar(50)
  partnerReff    String? @db.VarChar(100)
  transactionId  String? @db.VarChar(120)
  status         String? @db.VarChar(50)
  signatureValid Boolean @default(false)

  payload Json

  createdAt DateTime @default(now())

  @@unique([provider, partnerReff, transactionId])
  @@index([invoiceId, createdAt(sort: Desc)])
  @@map("billing_payment_events")
}

model Contact {
  id BigInt @id @default(autoincrement())

  name    String  @db.VarChar(255)
  email   String  @db.VarChar(255)
  phone   String? @db.VarChar(30)
  subject String  @db.VarChar(120)
  message String  @db.Text

  source String @default("landing") @db.VarChar(50)

  isResponded       Boolean   @default(false)
  respondedAt       DateTime?
  respondedByUserId Int?
  respondedByUser   User?     @relation("ContactRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)

  ipAddress String? @db.VarChar(80)
  userAgent String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isResponded, createdAt(sort: Desc)])
  @@map("contacts")
}

model PartnerApplication {
  id BigInt @id @default(autoincrement())

  name    String @db.VarChar(120)
  email   String @db.VarChar(254)
  phone   String @db.VarChar(40)
  region  String @db.VarChar(200)
  message String @db.Text

  status String @default("NEW") @db.VarChar(30)
  source String @default("karir") @db.VarChar(50)
  meta   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status, createdAt(sort: Desc)])
  @@map("partner_applications")
}

model Partner {
  id Int @id @default(autoincrement())

  email    String  @unique @db.VarChar(255)
  password String  @db.VarChar(255)
  name     String  @db.VarChar(255)
  phone    String? @db.VarChar(40)
  region   String? @db.VarChar(200)

  status String @default("active") @db.VarChar(30)

  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bankAccounts     PartnerBankAccount[]
  prospects        PartnerProspect[]
  acquiredVillages Village[]            @relation("PartnerAcquiredVillages")

  @@index([status])
  @@map("partners")
}

model PartnerBankAccount {
  id Int @id @default(autoincrement())

  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  bankName      String    @db.VarChar(80)
  accountNumber String    @db.VarChar(40)
  accountName   String    @db.VarChar(120)
  isPrimary     Boolean   @default(true)
  verifiedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
  @@map("partner_bank_accounts")
}

model PartnerProspect {
  id BigInt @id @default(autoincrement())

  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  villageName String  @db.VarChar(255)
  district    String? @db.VarChar(255)
  regency     String? @db.VarChar(255)
  province    String? @db.VarChar(255)

  picName  String? @db.VarChar(255)
  picPhone String? @db.VarChar(40)

  status String  @default("BARU") @db.VarChar(30)
  notes  String? @db.Text

  lastContactAt  DateTime?
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PartnerProspectEvent[]

  @@index([partnerId, status])
  @@index([partnerId, createdAt(sort: Desc)])
  @@map("partner_prospects")
}

model PartnerProspectEvent {
  id BigInt @id @default(autoincrement())

  prospectId BigInt
  prospect   PartnerProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  fromStatus String? @db.VarChar(30)
  toStatus   String  @db.VarChar(30)
  note       String? @db.Text

  createdAt DateTime @default(now())

  @@index([prospectId, createdAt(sort: Desc)])
  @@map("partner_prospect_events")
}

model BlogPost {
  id BigInt @id @default(autoincrement())

  slug  String @unique @db.VarChar(200)
  title String @db.VarChar(200)

  excerpt String? @db.Text
  content String? @db.LongText

  status String @default("draft") @db.VarChar(30) // draft | review | published | archived

  coverImageUrl         String? @db.Text
  coverImageAttribution Json?

  seoTitle       String? @db.VarChar(200)
  seoDescription String? @db.VarChar(500)

  publishedAt DateTime?

  createdByPlatformUserId Int?
  createdByPlatformUser   PlatformUser? @relation(fields: [createdByPlatformUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags BlogPostTag[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("blog_posts")
}

model BlogTag {
  id Int @id @default(autoincrement())

  slug String @unique @db.VarChar(80)
  name String @unique @db.VarChar(80)

  createdAt DateTime @default(now())

  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPostTag {
  postId BigInt
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  tagId Int
  tag   BlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tags")
}

// ============================================
// SYSTEM LOGS & AUDIT
// ============================================

model AuditLog {
  id BigInt @id @default(autoincrement())

  villageId Int?
  userId    Int?

  // Action Info
  action   String  @db.VarChar(100) // create, update, delete, login, etc
  entity   String  @db.VarChar(100) // residents, officials, mail_services, etc
  entityId String? @db.VarChar(100)

  // Details
  changes  Json? // What changed
  metadata Json? // Additional context

  // Request Info
  ipAddress String? @db.VarChar(50)
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([villageId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================
// PENGADUAN MASYARAKAT - Citizen Reports
// ============================================

model CitizenReport {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  reportType String  @db.VarChar(20) // PEMDES, BPD, KADUS, RT, RW, WARGA
  title      String  @db.VarChar(255)
  content    String  @db.Text
  images     String? @db.Text // Comma-separated URLs or JSON array

  status   String  @default("PENDING") @db.VarChar(20) // DRAFT, PENDING, PROCESS, DONE, REJECT
  isPublic Boolean @default(true)

  // Reporter info (denormalized)
  reporterName String  @db.VarChar(255)
  reporterNik  String? @db.VarChar(16)

  // Processing
  doneById Int?
  doneBy   User? @relation("CitizenReportDoneBy", fields: [doneById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses CitizenReportResponse[]

  @@index([villageId, status])
  @@index([villageId, reportType])
  @@index([villageId, createdAt(sort: Desc)])
  @@map("citizen_reports")
}

model CitizenReportResponse {
  id              BigInt        @id @default(autoincrement())
  citizenReportId BigInt
  citizenReport   CitizenReport @relation(fields: [citizenReportId], references: [id], onDelete: Cascade)

  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  response String  @db.Text
  images   String? @db.Text

  responderId   Int?
  responder     User?  @relation(fields: [responderId], references: [id])
  responderName String @db.VarChar(255)
  responderRole String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([citizenReportId])
  @@index([villageId])
  @@map("citizen_report_responses")
}

// ============================================
// ABSENSI - Attendance Management
// ============================================

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
}

enum CheckInMethod {
  QR
  GPS
}

model WorkShift {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name                 String  @db.VarChar(100)
  startTime            String  @db.VarChar(8)
  endTime              String  @db.VarChar(8)
  lateToleranceMinutes Int     @default(0)
  isActive             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]

  @@index([villageId, isActive])
  @@map("work_shifts")
}

model Attendance {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  officialId Int
  official   Official @relation(fields: [officialId], references: [id], onDelete: Cascade)

  shiftId Int?
  shift   WorkShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  attendanceDate DateTime @db.Date

  checkInAt     DateTime?
  checkOutAt    DateTime?
  status        AttendanceStatus @default(ABSENT)
  checkInMethod CheckInMethod?

  locationLat Float?
  locationLng Float?
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villageId, officialId, attendanceDate])
  @@index([villageId, attendanceDate])
  @@index([officialId, attendanceDate])
  @@map("attendances")
}

// ============================================
// BANTUAN SOSIAL & PROGRAM KELUARGA (publik cek NIK + kelola desa)
// ============================================

enum SocialBenefitEnrollmentStatus {
  registered
  under_review
  approved
  active
  completed
  withdrawn
}

model SocialBenefitProgram {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  name         String  @db.VarChar(255)
  periodLabel  String? @db.VarChar(120)
  /// Catatan internal admin; tidak dikeluarkan lewat API publik.
  internalNote String? @db.Text

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiaries SocialBenefitBeneficiary[]

  @@index([villageId])
  @@index([villageId, isActive])
  @@map("social_benefit_programs")
}

model SocialBenefitBeneficiary {
  id        Int                  @id @default(autoincrement())
  programId Int
  program   SocialBenefitProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  /// NIK tanpa pemisah; konsisten uppercase.
  nik        String                        @db.VarChar(16)
  /// Konteks pendek untuk warga; menimpa turunan label dari `status` bila ada.
  publicNote String?                       @db.VarChar(240)
  status     SocialBenefitEnrollmentStatus @default(registered)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, nik])
  @@index([nik])
  @@map("social_benefit_beneficiaries")
}
