/// Arus antara BUM Desa dan APB Desa: penyertaan modal Desa (pengeluaran pembiayaan 6.2.2.01) dan bagi hasil usaha (pendapatan 4.1.1.01).
/// Catatan APB Desa dibuat HANYA lewat fungsi Buku Kas Umum yang ada (createEntryInTx); apbdesEntryId menunjuk catatan itu.
model BumdesVillageFlow {
  id       Int    @id @default(autoincrement())
  bumdesId Int
  bumdes   Bumdes @relation(fields: [bumdesId], references: [id], onDelete: Cascade)

  /// PENYERTAAN_MODAL | BAGI_HASIL
  kind        String   @db.VarChar(16)
  /// Tahun buku asal laba (BAGI_HASIL); kosong untuk penyertaan modal
  fiscalYear  Int?
  flowDate    DateTime @db.Date
  amountCents BigInt
  /// Keputusan Musyawarah Desa yang menjadi dasar (plafon jumlah kumulatif); musdesMeetingId diturunkan dari keputusan ini
  resolutionId    Int
  resolution      BumdesMusdesResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  /// Musyawarah Desa yang memutuskan (berita acara final, jenis MUSDES_BUMDES; PP 11/2021 Pasal 41 ayat 4, Pasal 17 huruf l, m, p, Pasal 59 ayat 2)
  musdesMeetingId Int
  /// Akun kas BUMDes tempat dana diterima/keluar (1.1.01.xx)
  cashAccountCode String @db.VarChar(10)
  /// Catatan Buku Kas Umum APB Desa dan jurnal BUMDes yang dihasilkan
  apbdesYear    Int
  apbdesEntryId Int?
  journalId     Int?
  journal       BumdesJournal? @relation(fields: [journalId], references: [id], onDelete: SetNull)
  reference String? @db.VarChar(150)
  note      String? @db.VarChar(300)

  /// AKTIF | DIBATALKAN
  status     String    @default("AKTIF") @db.VarChar(12)
  voidedAt   DateTime?
  voidedById Int?
  voidReason String?   @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([bumdesId, kind, flowDate])
  @@index([apbdesEntryId])
  @@index([resolutionId])
  @@map("bumdes_village_flows")
}

/// Keputusan Musyawarah Desa tentang jumlah penyertaan modal atau bagi hasil: plafon kumulatif arus yang boleh dicatat.
/// Wajib tertaut ke Musyawarah Desa berberita acara final (jenis MUSDES_BUMDES) dan ke salah satu keputusannya (village_meeting_decisions, tanpa FK).
model BumdesMusdesResolution {
  id       Int    @id @default(autoincrement())
  bumdesId Int
  bumdes   Bumdes @relation(fields: [bumdesId], references: [id], onDelete: Cascade)

  /// PENYERTAAN_MODAL | BAGI_HASIL
  kind            String @db.VarChar(16)
  musdesMeetingId Int
  decisionId      Int
  /// Tahun buku asal laba (BAGI_HASIL); kosong untuk penyertaan modal
  fiscalYear      Int?
  /// Jumlah yang diputuskan Musyawarah Desa (plafon)
  amountCents     BigInt
  note            String? @db.VarChar(300)

  /// AKTIF | DIBATALKAN
  status     String    @default("AKTIF") @db.VarChar(12)
  voidedAt   DateTime?
  voidedById Int?
  voidReason String?   @db.VarChar(300)

  createdById Int?
  createdAt   DateTime @default(now())

  flows BumdesVillageFlow[]

  @@index([bumdesId, kind])
  @@index([musdesMeetingId])
  @@map("bumdes_musdes_resolutions")
}

