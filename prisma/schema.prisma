  status String @default("accrued") @db.VarChar(30)

  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disbursementItem PartnerDisbursementItem?

  @@unique([sourceInvoiceId])
  @@index([partnerId, status])
  @@index([partnerId, type, createdAt(sort: Desc)])
  @@map("partner_commission_entries")
}

model PartnerDisbursement {
