/// Katalog tenggat laporan wajib yang dapat disunting sebagai DATA. Katalog bawaan ada di kode (lib/kepatuhan/catalog.ts);
/// baris di sini menimpanya: scope GLOBAL (semua desa, dikelola admin platform) atau REGENCY (satu kabupaten, dikelola
/// akun regional kabupaten). Satu baris berlaku sejak `fromYear` sampai ada baris dengan fromYear lebih baru.
model ComplianceCatalogEntry {
  id          Int    @id @default(autoincrement())
  /// GLOBAL | REGENCY
  scope       String @db.VarChar(8)
  /// Kunci kabupaten/provinsi (teks wilayah desa, huruf kecil, spasi dirapikan); "" untuk GLOBAL.
  regencyKey  String @default("") @db.VarChar(120)
  provinceKey String @default("") @db.VarChar(120)
  /// Kunci butir bawaan, atau KAB-xxx untuk butir tambahan kabupaten.
  itemKey     String @db.VarChar(40)
  fromYear    Int
  /// true: butir ini dimatikan untuk cakupan tersebut sejak fromYear.
  disabled    Boolean @default(false)
  title       String? @db.VarChar(200)
  recipient   String? @db.VarChar(200)
  /// FIXED | AFTER_EVENT | NONE (kosong bila disabled)
  ruleKind    String? @db.VarChar(12)
  /// FIXED: tahun tenggat relatif tahun anggaran (-1, 0, 1)
  yearOffset  Int?
  month       Int?
  day         Int?
  /// AFTER_EVENT: RKPDES_ENACTED | APBDES_ENACTED, ditambah `amount` satuan `unit` (MONTH | WORKDAY)
  event       String? @db.VarChar(20)
  amount      Int?
  unit        String? @db.VarChar(8)
  /// V = dibaca dari teks resmi, R = belum diverifikasi, K = ketetapan kabupaten
  verification String @default("K") @db.VarChar(1)
  basis       String? @db.VarChar(300)
  note        String? @db.VarChar(500)
  /// Penyunting: akun regional (REGENCY) atau teks pengenal admin platform (GLOBAL).
  updatedByRegionalId Int?
  updatedByLabel      String? @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, regencyKey, provinceKey, itemKey, fromYear], map: "compliance_catalog_unique")
  @@index([regencyKey, provinceKey])
  @@map("compliance_catalog_entries")
}

/// Catatan pengiriman laporan wajib per desa, tahun anggaran, dan butir. Tanpa baris = belum. Status otomatis dari data
/// sistem (APB Desa, laporan kepala desa, Dana Desa) tidak disimpan di sini; baris ini untuk yang dikirim di luar sistem.
model ComplianceReportRecord {
  id        Int     @id @default(autoincrement())
