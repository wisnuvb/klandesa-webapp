// ============================================
// PENGADUAN MASYARAKAT - Citizen Reports
// ============================================

model CitizenReport {
  id        BigInt  @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  reportType String  @db.VarChar(20) // PEMDES, BPD, KADUS, RT, RW, WARGA
  title      String  @db.VarChar(255)
  content    String  @db.Text
  images     String? @db.Text // Comma-separated URLs or JSON array

  status   String  @default("PENDING") @db.VarChar(20) // DRAFT, PENDING, PROCESS, DONE, REJECT
  isPublic Boolean @default(true)

  // Reporter info (denormalized)
  reporterName String  @db.VarChar(255)
  reporterNik  String? @db.VarChar(16)

  // Mobile v2
  residentId       Int?
  /// jalan | lampu | sampah | air | keamanan | lainnya
  category         String?   @db.VarChar(30)
  locationLat      Float?
  locationLng      Float?
  /// RT/dusun/patokan yang diketik warga
  locationNote     String?   @db.VarChar(200)
  /// Sembunyikan nama dari warga lain (staf tetap melihat pelapor)
  isAnonymous      Boolean   @default(false)
  /// RESOLVED | NOT_RESOLVED — jawaban pelapor setelah status DONE
  resolvedFeedback String?   @db.VarChar(20)
  feedbackAt       DateTime?

  // Processing
  doneById Int?
  doneBy   User? @relation("CitizenReportDoneBy", fields: [doneById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses CitizenReportResponse[]

  @@index([villageId, status])
  @@index([villageId, reportType])
  @@index([villageId, createdAt(sort: Desc)])
  @@index([residentId, createdAt])
  @@map("citizen_reports")
}

model CitizenReportResponse {
  id              BigInt        @id @default(autoincrement())
