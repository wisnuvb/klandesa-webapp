  otherTerms            String?  @db.VarChar(1000)

  /// Pasal 11 ayat 3: pemanfaatan ditetapkan dalam Peraturan Desa
  perdesNo   String?   @db.VarChar(100)
  perdesDate DateTime? @db.Date
  /// Pasal 17: izin tertulis Bupati/Wali Kota untuk kerja sama pemanfaatan dan bangun guna serah / serah guna
  regencyPermitNo   String?   @db.VarChar(100)
