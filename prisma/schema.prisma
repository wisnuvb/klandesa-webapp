/// Skema bagi hasil per mitra (flat closing + % langganan).
model PartnerCommissionRule {
  id Int @id @default(autoincrement())

  partnerId Int     @unique
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  /// Nominal tetap; hanya dipakai bila closingBonusPercent kosong (aturan khusus per mitra).
  closingBonusAmount         Decimal @default(500000.00) @db.Decimal(15, 2)
  /// Bonus closing sebagai % dari harga Paket Lengkap yang berlaku (lib/partner/commission-math.ts); mengalahkan nominal tetap.
  closingBonusPercent        Decimal? @db.Decimal(5, 2)
  subscriptionSharePercent Decimal @default(10.00) @db.Decimal(5, 2)

  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, isActive])
  @@map("partner_commission_rules")
}

model PartnerCommissionEntry {
  id BigInt @id @default(autoincrement())

  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  villageId Int?
  village   Village? @relation(fields: [villageId], references: [id], onDelete: SetNull)

  /// CLOSING | SUBSCRIPTION | ADJUSTMENT
  type String @db.VarChar(30)

  sourceInvoiceId BigInt?
  sourceInvoice   BillingInvoice? @relation(fields: [sourceInvoiceId], references: [id], onDelete: SetNull)

  amount      Decimal @db.Decimal(15, 2)
  currency    String  @default("IDR") @db.VarChar(10)
  description String? @db.Text

