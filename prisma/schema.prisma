/// Kerja sama antar-desa atau dengan pihak ketiga (Permendagri 96/2017).
model VillageAgreement {
  id        Int     @id @default(autoincrement())
  villageId Int
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  year      Int

  /// ANTAR_DESA | PIHAK_KETIGA
  kind      String @db.VarChar(12)
  /// DESA | PIHAK_KETIGA (hanya untuk kerja sama dengan pihak ketiga)
  initiative String? @db.VarChar(12)
  title     String @db.VarChar(200)
  /// PEMERINTAHAN | PEMBANGUNAN | PEMBINAAN | PEMBERDAYAAN (Pasal 9 ayat 1)
  field     String @db.VarChar(12)

  /// Muatan minimal Peraturan Bersama/Perjanjian Bersama (Pasal 6)
  scope      String? @db.VarChar(2000)
  procedures String? @db.VarChar(2000)
  rights     String? @db.VarChar(2000)
  funding    String? @db.VarChar(1000)
  amendment  String? @db.VarChar(1000)
  dispute    String? @db.VarChar(1000)
  termStartOn DateTime? @db.Date
  termEndOn   DateTime? @db.Date

  /// PERSIAPAN | PENAWARAN | PENYUSUNAN | DITANDATANGANI | PELAKSANAAN | SELESAI | BATAL
  status String @default("PERSIAPAN") @db.VarChar(14)

  /// Musyawarah Desa pembahasan bidang/potensi (Pasal 13 ayat 2, 14 ayat 2); tanpa kunci asing: dicek saat disimpan.
  prepMusdesId    Int?
  inPlanConfirmed Boolean @default(false)
  offerSentOn     DateTime? @db.Date
  /// Musyawarah Desa setelah penawaran diterima (Pasal 13 ayat 3, 14 ayat 3, 15)
  offerMusdesId   Int?
  /// SEPAKAT | TIDAK
  offerDecision   String? @db.VarChar(8)
  offerReplyOn    DateTime? @db.Date
  /// Rancangan dikonsultasikan ke bupati/wali kota melalui camat (Pasal 13 ayat 4, 14 ayat 4)
  consultedOn     DateTime? @db.Date
  /// Menyangkut tata ruang, pungutan, atau organisasi (Pasal 13 ayat 4 huruf c): wajib dikonsultasikan
  consultRequired Boolean   @default(false)
  agreedOn        DateTime? @db.Date
  signedOn        DateTime? @db.Date
  signedNumber    String?   @db.VarChar(100)
  witnessName     String?   @db.VarChar(150)
  reportedOn          DateTime? @db.Date
  reportedToCamatOn   DateTime? @db.Date
  /// Alasan berakhir: salah satu dari Pasal 17 (kode di katalog)
  endReason String?   @db.VarChar(24)
  endNote   String?   @db.VarChar(300)
  endedOn   DateTime? @db.Date

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parties VillageAgreementParty[]
  budget  VillageAgreementBudgetItem[]

  @@index([villageId, status])
  @@index([villageId, year])
  @@map("village_agreements")
}

model VillageAgreementParty {
